[Icon Theme]
Name=Filigrane-Icons
Comment=Dossiers et glyphes de Filigrane (d'après Nordic-Slot-Dark-Icons), le reste d'Adwaita
Inherits=Adwaita,hicolor
Directories=places/scalable,places/16,places/symbolic,mimetypes/scalable,mimetypes/symbolic,devices/symbolic

[places/scalable]
Size=48
MinSize=16
MaxSize=512
Type=Scalable
Context=Places

[places/16]
Size=16
Type=Fixed
Context=Places

[places/symbolic]
Size=16
MinSize=16
MaxSize=512
Type=Scalable
Context=Places

[mimetypes/scalable]
Size=48
MinSize=16
MaxSize=512
Type=Scalable
Context=MimeTypes

[devices/symbolic]
Size=16
MinSize=16
MaxSize=512
Type=Scalable
Context=Devices

[mimetypes/symbolic]
Size=16
MinSize=16
MaxSize=512
Type=Scalable
Context=MimeTypes
