# Thème Plymouth Filigrane: logo empilé sur fond nuit, invite de passphrase LUKS, fine barre de progression.
# Images générées par scripts/brand-assets.sh pour un écran de 2560 px (DeviceScale=1), réduites de moitié en dessous.

Window.SetBackgroundTopColor(0.110, 0.133, 0.169);     # nuit #1c222b
Window.SetBackgroundBottomColor(0.094, 0.114, 0.145);  # nuit profond #181d25

if (Window.GetWidth() < 2000) global.s = 0.5; else global.s = 1;

fun load(file) {
  img = Image(file);
  return img.Scale(Math.Int(img.GetWidth() * global.s), Math.Int(img.GetHeight() * global.s));
}

#----------------------------------------- Logo et dialogue --------------------------------

logo.image = load("logo.png");
prompt.image = load("prompt.png");
entry.image = load("entry.png");
bullet.image = load("bullet.png");

# Groupe logo + étiquette + champ centré verticalement
group_h = logo.image.GetHeight() + 64 * s + prompt.image.GetHeight() + 24 * s + entry.image.GetHeight();
top = Window.GetHeight() / 2 - group_h / 2;

logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(Window.GetWidth() / 2 - logo.image.GetWidth() / 2, top, 1);

prompt.y = top + logo.image.GetHeight() + 64 * s;
prompt.sprite = Sprite(prompt.image);
prompt.sprite.SetPosition(Window.GetWidth() / 2 - prompt.image.GetWidth() / 2, prompt.y, 10001);
prompt.sprite.SetOpacity(0);

entry.x = Window.GetWidth() / 2 - entry.image.GetWidth() / 2;
entry.y = prompt.y + prompt.image.GetHeight() + 24 * s;
entry.sprite = Sprite(entry.image);
entry.sprite.SetPosition(entry.x, entry.y, 10001);
entry.sprite.SetOpacity(0);

bullet.sprites = [];
global.max_bullets = Math.Int((entry.image.GetWidth() - 48 * s) / (bullet.image.GetWidth() + 10 * s));

fun show_password_dialog() {
  prompt.sprite.SetOpacity(1);
  entry.sprite.SetOpacity(1);
}

fun hide_password_dialog() {
  prompt.sprite.SetOpacity(0);
  entry.sprite.SetOpacity(0);
  for (index = 0; bullet.sprites[index]; index++) {
    bullet.sprites[index].SetOpacity(0);
  }
}

#----------------------------------------- Barre de progression --------------------------------

progress_box.image = load("progress_box.png");
progress_box.sprite = Sprite(progress_box.image);
progress_box.x = Window.GetWidth() / 2 - progress_box.image.GetWidth() / 2;
progress_box.y = entry.y + entry.image.GetHeight() / 2 - progress_box.image.GetHeight() / 2;
progress_box.sprite.SetPosition(progress_box.x, progress_box.y, 0);
progress_box.sprite.SetOpacity(0);

progress_bar.original_image = load("progress_bar.png");
progress_bar.sprite = Sprite();
progress_bar.sprite.SetPosition(progress_box.x, progress_box.y, 1);
progress_bar.sprite.SetOpacity(0);

# Pendant le déchiffrement, durée et progression réelles sont figées: progression simulée jusqu'à 70 % en 15 s
global.fake_progress_limit = 0.7;
global.fake_progress_duration = 15.0;
global.animation_frame = 0;
global.fake_progress = 0.0;
global.fake_progress_active = 0;
global.fake_progress_start_time = 0.0;
global.password_shown = 0;
global.max_progress = 0.0;

fun update_progress_bar(progress) {
  if (progress > global.max_progress) {
    global.max_progress = progress;
    width = Math.Int(progress_bar.original_image.GetWidth() * progress);
    if (width < 1) width = 1;
    progress_bar.image = progress_bar.original_image.Scale(width, progress_bar.original_image.GetHeight());
    progress_bar.sprite.SetImage(progress_bar.image);
  }
}

fun show_progress_bar() {
  progress_box.sprite.SetOpacity(1);
  progress_bar.sprite.SetOpacity(1);
}

fun hide_progress_bar() {
  progress_box.sprite.SetOpacity(0);
  progress_bar.sprite.SetOpacity(0);
}

fun refresh_callback() {
  global.animation_frame++;
  if (global.fake_progress_active == 1) {
    time_ratio = (global.animation_frame / 50.0) / global.fake_progress_duration;  # 50 images/s
    if (time_ratio > 1.0) time_ratio = 1.0;
    global.fake_progress = (1 - (1 - time_ratio) * (1 - time_ratio)) * global.fake_progress_limit;
    update_progress_bar(global.fake_progress);
  }
}

Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, progress) {
  if (global.fake_progress_start_time == 0.0) {
    global.fake_progress_start_time = duration;
  }
  # Progression réelle dès qu'elle repart et dépasse la simulée
  if (duration > global.fake_progress_start_time && progress > global.fake_progress) {
    global.fake_progress_active = 0;
    update_progress_bar(progress);
  }
}

Plymouth.SetBootProgressFunction(progress_callback);

#----------------------------------------- Rappels Plymouth --------------------------------

fun display_normal_callback() {
  hide_password_dialog();
  mode = Plymouth.GetMode();
  if ((mode == "boot" || mode == "resume") && global.password_shown == 1) {
    show_progress_bar();
    global.fake_progress_active = 1;
    global.animation_frame = 0;
    global.max_progress = 0.0;
    global.fake_progress = 0.0;
    global.fake_progress_start_time = 0.0;
  }
}

fun display_password_callback(prompt_text, bullets) {
  global.password_shown = 1;
  global.fake_progress_active = 0;
  hide_progress_bar();
  show_password_dialog();

  for (index = 0; bullet.sprites[index]; index++) {
    bullet.sprites[index].SetOpacity(0);
  }
  n = bullets;
  if (n > global.max_bullets) n = global.max_bullets;
  for (index = 0; index < n; index++) {
    if (!bullet.sprites[index]) {
      bullet.sprites[index] = Sprite(bullet.image);
      bullet.sprites[index].SetPosition(entry.x + 24 * s + index * (bullet.image.GetWidth() + 10 * s),
                                        entry.y + entry.image.GetHeight() / 2 - bullet.image.GetHeight() / 2, 10002);
    }
    bullet.sprites[index].SetOpacity(1);
  }
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

#----------------------------------------- Messages --------------------------------

message_sprite = Sprite();
message_sprite.SetPosition(24 * s, 24 * s, 10000);

fun display_message_callback(text) {
  message_sprite.SetImage(Image.Text(text, 0.859, 0.906, 0.957));  # brume #dbe7f4
  message_sprite.SetOpacity(1);
}

fun hide_message_callback(text) {
  message_sprite.SetOpacity(0);
}

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
