// Réglages niri personnels (couche users/thomas), inclus à la fin de ~/.config/niri/config.kdl

// Proton Mail: pont IMAP local sans GUI, puis écoute des nouveaux mails (relancée si le pont n'est pas prêt)
spawn-at-startup "protonmail-bridge" "--noninteractive"
spawn-sh-at-startup "while :; do goimapnotify; sleep 30; done"
// WhatsApp sans navigateur: whatsapp-unreadd + compteur de non-lus (appairage: wa-pair), voir ~/.local/bin/wa-daemon
spawn-at-startup "wa-daemon"
// Fenêtre « Appel WhatsApp » en flottant (titre connu après l'ouverture), voir ~/.local/bin/wa-call-float
spawn-sh-at-startup "$HOME/.local/bin/wa-call-float"
// Notifications Proton Calendar (lien ICS dans ~/.config/proton-calendar.url), voir ~/.local/bin/cal-notify
spawn-sh-at-startup "$HOME/.local/bin/cal-notify"
// iCloud Drive dans ~/iCloud (rclone mount, fichiers téléchargés à l'ouverture), voir ~/.local/bin/icloud-mount
spawn-sh-at-startup "$HOME/.local/bin/icloud-mount"

binds {
    Mod+Shift+C hotkey-overlay-title="iCloud Drive (Files)" { spawn-sh "$HOME/.local/bin/fili-file \"$HOME/iCloud\""; }
}
