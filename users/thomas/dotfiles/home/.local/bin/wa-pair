#!/bin/bash
# Appairage unique de whatsapp-unreadd: affiche le QR code à scanner (WhatsApp > Appareils liés > Lier un appareil),
# s'arrête une fois appairé et crée le marqueur qui autorise wa-daemon. À lancer dans un terminal: foot -e wa-pair
cfg="$HOME/.config/whatsapp-unread"
mkdir -p -m 700 "$cfg"
coproc WA { exec "$HOME/.local/bin/whatsapp-unreadd" -socket "${XDG_RUNTIME_DIR:-/tmp}/wa-pair.sock" 2>&1; }
while IFS= read -r line <&"${WA[0]}"; do
    printf '%s\n' "$line"
    if [[ $line == *"Pairing successful"* ]]; then
        sleep 8   # laisse la première synchronisation enregistrer la session
        kill "$WA_PID" 2>/dev/null
        touch "$cfg/paired"
        echo "Appairé. Lancer wa-daemon (ou relancer niri)."
        exit 0
    fi
done
echo "Appairage interrompu." >&2
exit 1
