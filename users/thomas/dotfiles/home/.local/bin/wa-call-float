#!/bin/sh
# Passe en flottant la fenêtre « Appel WhatsApp »: son titre arrive après l'ouverture,
# donc open-floating (window-rule) ne la voit pas. Suit le flux d'événements niri.
niri msg --json event-stream | jq --unbuffered -r '
  .WindowOpenedOrChanged.window // empty
  | select((.app_id // "") | test("^chrome-web\\.whatsapp\\.com__"))
  | select((.title // "") | startswith("Appel WhatsApp"))
  | select(.is_floating | not) | .id' |
while read -r id; do
    niri msg action move-window-to-floating --id "$id"
    niri msg action set-window-width --id "$id" 480
    niri msg action set-window-height --id "$id" 640
done
