#!/bin/bash
# iCloud Drive monté dans ~/iCloud (rclone mount): fichiers téléchargés à l'ouverture, cache local plafonné à 5 Go
# (les moins récemment utilisés partent en premier). Arborescence lue en tâche de fond au montage et gardée 1 h
# (iCloud ne signale pas les changements: un ajout depuis le Mac/iPhone peut mettre jusqu'à 1 h à apparaître).
# Lancé par niri au démarrage, attend le réseau.
# Config HORS dépôt (identifiants Apple): remote "icloud" créé par `rclone config` (type iclouddrive, 2FA).
# Session Apple valable 30 jours: rappel par watch-icloud (cron-watch) et bouton vers icloud-reconnect.
REMOTE="icloud:"
MNT="$HOME/iCloud"
STATE="$HOME/.local/state/icloud"
mkdir -p "$STATE" "$MNT"

rclone listremotes 2>/dev/null | grep -qx "$REMOTE" || exit 0
mountpoint -q "$MNT" && exit 0
fusermount3 -uz "$MNT" 2>/dev/null  # montage mort d'une session précédente
# Écrit hors montage (via ~/Documents ou ~/Pictures): rclone refuserait un point de montage non vide
if [ -n "$(ls -A "$MNT")" ]; then
    aside="$STATE/hors-montage-$(date +%Y%m%d%H%M%S)"
    mv "$MNT" "$aside" && mkdir -p "$MNT"
    notify-send -a icloud "iCloud: fichiers écrits hors montage" "Mis de côté dans $aside"
fi

until timeout 3 bash -c 'exec 3<>/dev/tcp/www.icloud.com/443' 2>/dev/null; do sleep 30; done

rclone mount "$REMOTE" "$MNT" \
    --vfs-cache-mode full --vfs-cache-max-size 5G --vfs-cache-max-age 720h \
    --dir-cache-time 1h --poll-interval 0 --vfs-refresh \
    --log-level NOTICE --log-file "$STATE/mount.log" && exit 0
[ "$(notify-send -u critical -a icloud -A reconnect=Reconnecter "iCloud non monté" \
    "$(grep -m1 -iE 'reconnect|auth|error' "$STATE/mount.log" | tail -c 200)")" = reconnect ] &&
    "$HOME/.local/bin/bar-tui" icloud-reconnect
exit 1
