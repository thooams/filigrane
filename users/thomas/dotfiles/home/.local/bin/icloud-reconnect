#!/bin/bash
# Renouvelle la session Apple d'iCloud Drive (mot de passe + code 2FA, valable 30 jours) puis remonte ~/iCloud.
# Interactif: lancé dans un foot flottant par le bouton des notifications iCloud (bar-tui icloud-reconnect).
STATE="$HOME/.local/state/icloud"
mkdir -p "$STATE"

if rclone config reconnect icloud:; then
    touch "$STATE/auth.stamp"
    fusermount3 -uz "$HOME/iCloud" 2>/dev/null  # le montage garde l'ancienne session en mémoire
    sleep 1
    setsid -f "$HOME/.local/bin/icloud-mount" >/dev/null 2>&1
    notify-send -u low -a icloud "iCloud reconnecté" "Session valable 30 jours"
else
    echo; echo "Échec de la reconnexion."
fi
read -rp "Entrée pour fermer"
