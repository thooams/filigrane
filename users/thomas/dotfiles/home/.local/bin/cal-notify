#!/bin/sh
# Notifications Proton Calendar sans webapp ouverte: lit le lien ICS privé (Partager via un lien, lecture seule)
# toutes les 5 min et notifie LEAD minutes avant chaque événement. Lancé par niri (boucle, pas de daemon).
# Les URL sont des secrets: ~/.config/proton-calendar.url (hors dépôt), une par ligne (lignes vides et # ignorées). Le lien ICS de Proton est mis à jour avec du retard.
# Hors ligne: dernier ICS en cache. Événements récurrents: RRULE/EXDATE gérés, modifications d'une occurrence ignorées.
URL_FILE="$HOME/.config/proton-calendar.url"
STATE="$HOME/.local/state/cal-notify"
mkdir -p "$STATE"
exec 9>"$STATE/lock"
flock -n 9 || exit 0

while :; do
    if [ -s "$URL_FILE" ]; then
        i=0
        grep -v -e '^[[:space:]]*$' -e '^[[:space:]]*#' "$URL_FILE" | while IFS= read -r URL; do
            i=$((i + 1))
            curl -fsS -m 20 -o "$STATE/cal-$i.ics.new" "$URL" 2>/dev/null && mv "$STATE/cal-$i.ics.new" "$STATE/cal-$i.ics"
        done
        ls "$STATE"/cal-*.ics >/dev/null 2>&1 && STATE="$STATE" LEAD=10 python3 -I - <<'PY'
import os, datetime as dt
from icalendar import Calendar
from dateutil.rrule import rrulestr
import subprocess

state = os.environ["STATE"]
lead = dt.timedelta(minutes=int(os.environ["LEAD"]))
now = dt.datetime.now().astimezone()
seen_file = os.path.join(state, "seen")
seen = set(open(seen_file).read().split("\n")) if os.path.exists(seen_file) else set()
new_seen = set()

def aware(v):
    if isinstance(v, dt.datetime):
        return v if v.tzinfo else v.astimezone()
    return None  # journée entière: ignorée

import glob
events = []
for f in sorted(glob.glob(os.path.join(state, "cal-*.ics"))):
    try:
        events += Calendar.from_ical(open(f, "rb").read()).walk("VEVENT")
    except Exception:
        pass
for ev in events:
    try:
        start = aware(ev.decoded("DTSTART"))
        if start is None:
            continue
        uid = str(ev.get("UID", ""))
        starts = [start]
        if "RRULE" in ev:
            rule = rrulestr(ev["RRULE"].to_ical().decode(), dtstart=start)
            starts = rule.between(now - dt.timedelta(minutes=1), now + lead, inc=True)
            ex = ev.get("EXDATE")
            if ex:
                ex = ex if isinstance(ex, list) else [ex]
                skip = {aware(d.dt) for e in ex for d in e.dts}
                starts = [s for s in starts if s not in skip]
        for s in starts:
            key = f"{uid}|{s.isoformat()}"
            if now - dt.timedelta(minutes=1) <= s <= now + lead:
                new_seen.add(key)
                if key not in seen:
                    mins = max(0, round((s - now).total_seconds() / 60))
                    when = f"dans {mins} min" if mins else "maintenant"
                    loc = str(ev.get("LOCATION", "")).strip()
                    body = f"{s.astimezone():%H:%M} ({when})" + (f"\n{loc}" if loc else "")
                    subprocess.run(["notify-send", "-a", "Proton Calendar", "-i", "x-office-calendar",
                                    str(ev.get("SUMMARY", "(sans titre)")), body])
                    subprocess.run([os.path.expanduser("~/.local/bin/bar-alert"), "push", "cal", str(int(s.timestamp())),
                                    f"{s.astimezone():%H:%M}", str(ev.get("SUMMARY", "(sans titre)")).replace("\t", " ")])
    except Exception:
        continue
# on ne garde que les clés encore dans la fenêtre (évite la croissance et le renvoi)
open(seen_file, "w").write("\n".join(new_seen))
PY
    fi
    sleep 300
done
