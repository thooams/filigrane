# Couche personnelle de thomas: surcharge config.env (les variables d'environnement restent prioritaires)
KEYMAP="${KEYMAP:-fr-bepo}"
TIMEZONE="${TIMEZONE:-Europe/Paris}"
# Groupe 1: bépo, groupe 2: qwerty australien (bascule: icône clavier de Waybar)
XKB_LAYOUT="${XKB_LAYOUT:-fr,au}"
XKB_VARIANT="${XKB_VARIANT:-bepo_afnor,}"
# Connexion automatique aussi en physique: le disque est chiffré (LUKS), la phrase de passe est demandée au démarrage
AUTOLOGIN="${AUTOLOGIN:-1}"
# Agent IA (Mod+Y): Claude Code lancé dans ce dépôt (mémoire du projet), sans demande de permission
# (le hook guard-destructive.sh redemande pour les commandes destructives), accès à tout ~
FILI_AI_WORKDIR="${FILI_AI_WORKDIR:-Projects/filigrane}"
FILI_AI_ARGS="${FILI_AI_ARGS:---dangerously-skip-permissions --add-dir ~}"
