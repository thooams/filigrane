#!/bin/sh
# Client du fili-shell (Quickshell: fili-bar, fili-notification, fili-notification-center, fili-menu, fili-tooltip,
# fili-calendar). Écrit une ligne dans le tuyau nommé lu par ~/.config/quickshell (FiliShell.qml), sans lancer le
# client Qt `qs ipc` (plus lourd). Les réponses reviennent par un tuyau propre à la requête. Sans shell en marche,
# les commandes sans réponse sont ignorées.
# Usage:
#   fili-shell bar refresh N...                       rafraîchit les modules de la fili-bar (ex-`pkill -RTMIN+N waybar`)
#   fili-shell notification dnd on|off|toggle         ne pas déranger
#   fili-shell notification dismiss-all | dismiss RÉSUMÉ | center (ouvre/ferme le fili-notification-center)
#   fili-shell notification history                   historique en JSON (champs de makoctl history -j)
#   fili-shell menu [options fuzzel]                  fili-menu façon `fuzzel --dmenu`: entrées sur stdin, choix sur
#       stdout, code 1 si annulé, 10 pour Maj+Retour arrière. Options: --prompt P, --prompt-only P, --lines N,
#       --width N (caractères), --font F, --no-sort, --with-nth N, --accept-nth N (colonnes séparées par tabulation);
#       les autres options de fuzzel sont ignorées. Icônes: protocole dmenu étendu "texte\0icon\037chemin".
#   fili-shell menu close                             ferme le fili-menu s'il est ouvert (code 0), sinon code 1
#   fili-shell reload                                 recharge la config
D="${XDG_RUNTIME_DIR:-/tmp}"
F="$D/fili-shell"

send() { # ligne sans bloquer: ouverture en lecture-écriture (jamais bloquante sur un tuyau)
    [ -p "$F" ] || return 1
    { printf '%s\n' "$1" >&3; } 3<>"$F"
}
# request COMMANDE: envoie "COMMANDE <tuyau de réponse>" et attend la réponse
request() {
    [ -p "$F" ] && pgrep -x quickshell >/dev/null || return 1
    r="$(mktemp -u "$D/fili-shell.XXXXXX")"
    mkfifo -m 600 "$r" || return 1
    send "$1 $r"
    cat "$r"
    rm -f "$r"
}
usage() { sed -n '6,17p' "$0" >&2; exit 2; }

case "$1 $2" in
    "bar refresh") shift 2; send "bar refresh $*"; exit 0 ;;
    "notification dnd") send "notification dnd ${3:-toggle}"; exit 0 ;;
    "notification dismiss-all"|"notification center") send "$1 $2"; exit 0 ;;
    "notification dismiss") send "notification dismiss $(printf '%s' "$3" | tr '\n' ' ')"; exit 0 ;;
    "notification history") request "notification history"; exit ;;
    "menu close") [ "$(request "menu close")" = 1 ]; exit ;;
    "reload "*) send reload; exit 0 ;;
    "menu "*) shift ;;
    *) usage ;;
esac

# fili-menu: options en JSON et entrées dans des fichiers lus par le shell
prompt=''; only=0; lines=12; width=''; font=''; nosort=0; with=''; accept=''
while [ $# -gt 0 ]; do
    case "$1" in
        --dmenu|--minimal-lines) ;;
        --prompt) prompt="$2"; shift ;;
        --prompt=*) prompt="${1#*=}" ;;
        --prompt-only) only=1; prompt="$2"; shift ;;
        --lines) lines="$2"; shift ;;
        --width) width="$2"; shift ;;
        --font) font="$2"; shift ;;
        --no-sort) nosort=1 ;;
        --with-nth) with="$2"; shift ;;
        --accept-nth) accept="$2"; shift ;;
        --placeholder|--nth-delimiter) shift ;;
    esac
    shift
done
in="$(mktemp "$D/fili-menu.XXXXXX")"
trap 'rm -f "$in" "$in.json"' EXIT
[ "$only" = 1 ] || cat > "$in"
jq -nc --arg p "$prompt" --argjson o "$only" --arg l "$lines" --arg w "$width" --arg f "$font" --argjson s "$nosort" \
    --arg wn "$with" --arg an "$accept" --arg in "$in" \
    '{prompt: $p, promptOnly: ($o == 1), lines: ($l | tonumber? // 12), width: ($w | tonumber? // 0), font: $f,
      noSort: ($s == 1), withNth: ($wn | tonumber? // 0), acceptNth: ($an | tonumber? // 0), input: $in}' > "$in.json"
out="$(request "menu open $in.json")" || exit 1
# Réponse: code de sortie sur la première ligne, sélection ensuite
rc="${out%%
*}"
case "$out" in *'
'*) sel="${out#*
}" ;; *) sel='' ;; esac
[ -n "$sel" ] && printf '%s\n' "$sel"
exit "${rc:-1}"
