#!/bin/sh
# Clic sur une notification (mako): invoque son action par défaut, puis met le focus sur la fenêtre de l'appli émettrice.
# Usage: notif-focus <id notification>. Correspondance par nom d'appli ou desktop-entry contre l'app_id ou le titre
# des fenêtres niri (minuscules, sans ponctuation: "wp-tui" retrouve l'app-id "wptui").
id="$1"
[ -n "$id" ] || exit 1
info="$(makoctl list | awk -v id="$id" '
    $1 == "Notification" { cur = ($2 == id ":") }
    cur && /^  App name: /      { sub(/^  App name: /, ""); print "app=" $0 }
    cur && /^  Desktop entry: / { sub(/^  Desktop entry: /, ""); print "entry=" $0 }')"
app="$(printf '%s\n' "$info" | sed -n 's/^app=//p')"
entry="$(printf '%s\n' "$info" | sed -n 's/^entry=//p')"
makoctl invoke -n "$id" >/dev/null 2>&1
win="$(niri msg -j windows | jq -r --arg a "$app" --arg e "$entry" '
    def n: ascii_downcase | gsub("[^a-z0-9]"; "");
    ([$a, $e] | map(n) | map(select(length >= 3))) as $c
    | map(select(
        (.app_id // "" | n) as $i | (.title // "" | n) as $t
        | any($c[]; . as $x | ($i != "" and ($i | contains($x) or ($x | contains($i)))) or ($t | contains($x)))))
    | first | .id // empty')"
[ -n "$win" ] && niri msg action focus-window --id "$win"
echo "$(date +%T) id=$id app=$app entry=$entry fenêtre=${win:-aucune}" >> "${XDG_RUNTIME_DIR:-/tmp}/notif-focus.log"
makoctl dismiss -n "$id" >/dev/null 2>&1
exit 0
