#!/bin/sh
# Clic sur une notification (shell Quickshell, Notifs.qml, après son action par défaut): met le focus sur la fenêtre
# de l'appli émettrice. Usage: notif-focus <nom de l'appli> [desktop-entry]. Correspondance par nom d'appli ou
# desktop-entry contre l'app_id ou le titre des fenêtres niri (minuscules, sans ponctuation: "foo-bar" retrouve l'app-id "foobar").
# Si l'appli porte le nom d'une application web (~/.config/webapps/list), son domaine sert aussi à retrouver la fenêtre
# (app-id Chrome "chrome-mail.proton.me__-Default"), et la webapp est ouverte si aucune fenêtre n'existe.
app="$1"
entry="$2"
[ -n "$app$entry" ] || exit 1
url="$(awk -F'|' -v a="$app" '
    BEGIN { a = tolower(a) }
    /^#/ || NF < 2 { next }
    { n = $1; u = $2; gsub(/^ +| +$/, "", n); gsub(/^ +| +$/, "", u) }
    tolower(n) == a { print u; exit }' "${XDG_CONFIG_HOME:-$HOME/.config}/webapps/list" 2>/dev/null)"
host="${url#*://}"; host="${host%%/*}"
win="$(niri msg -j windows | jq -r --arg a "$app" --arg e "$entry" --arg h "$host" '
    def n: ascii_downcase | gsub("[^a-z0-9]"; "");
    ([$a, $e, $h] | map(n) | map(select(length >= 3))) as $c
    | ($h | n) as $hn
    | map(select(
        (.app_id // "" | n) as $i | (.title // "" | n) as $t
        | if $hn != "" then ($i | contains($hn))
          else any($c[]; . as $x | ($i != "" and ($i | contains($x) or ($x | contains($i)))) or ($t | contains($x))) end))
    | first | .id // empty')"
if [ -n "$win" ]; then
    niri msg action focus-window --id "$win"
elif [ -n "$url" ]; then
    setsid -f "$HOME/.local/bin/webapp" "$url" >/dev/null 2>&1
fi
echo "$(date +%T) app=$app entry=$entry fenêtre=${win:-aucune}" >> "${XDG_RUNTIME_DIR:-/tmp}/notif-focus.log"
exit 0
