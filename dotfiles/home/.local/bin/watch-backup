#!/bin/bash
# Sauvegarde restic de ~ vers le NAS (réseau local seulement). Lancé par cron-watch (1 fois par jour, rattrapage)
# ou à la main depuis la barre (`watch-backup now`, via bar-backup: ignore la batterie et signale les échecs).
# Config HORS dépôt (secrets): ~/.config/restic/env, par exemple
#     RESTIC_REPOSITORY=sftp:nas:/Volume1/backup/void     # "nas" = Host de ~/.ssh/config (clé dédiée)
#     RESTIC_PASSWORD_FILE=$HOME/.config/restic/password
# Automatique: pas configuré, NAS éteint ou batterie = sortie 1 sans bruit, cron-watch réessaie au tour suivant.
CONF="$HOME/.config/restic"
STATE="$HOME/.local/state/watch"
mkdir -p "$STATE"
manual=0; [ "$1" = now ] && manual=1

refuse() { # refuse MESSAGE: silencieux en automatique, notifié en manuel
    [ "$manual" = 1 ] && notify-send -u normal -a backup "Sauvegarde impossible" "$1"
    exit 1
}

[ -r "$CONF/env" ] || refuse "pas configurée (~/.config/restic/env)"
. "$CONF/env"
export RESTIC_REPOSITORY RESTIC_PASSWORD_FILE

[ "$manual" = 0 ] && grep -q Discharging /sys/class/power_supply/BAT0/status 2>/dev/null && exit 1
alias_="${RESTIC_REPOSITORY#sftp:}"; alias_="${alias_%%:*}"
read -r host port < <(ssh -G "$alias_" 2>/dev/null | awk '$1=="hostname"{h=$2} $1=="port"{p=$2} END{print h, p}')
[ -n "$host" ] && timeout 3 bash -c "exec 3<>/dev/tcp/$host/$port" 2>/dev/null || refuse "NAS injoignable"
restic cat config >/dev/null 2>"$STATE/backup.err" || refuse "dépôt restic absent ou illisible (restic init ?)"

# Verrou tenu pendant la sauvegarde: bar-backup s'en sert pour afficher "en cours"
exec 8>"$STATE/backup.lock"
flock -n 8 || { [ "$manual" = 1 ] && notify-send -u low -a backup "Sauvegarde" "Déjà en cours"; exit 0; }
pkill -RTMIN+18 waybar

if ionice -c3 nice -n19 restic backup "$HOME" --exclude-caches --exclude-file="$HOME/.config/watch/backup-excludes" \
        --tag auto >"$STATE/backup.log" 2>>"$STATE/backup.err"; then
    # Oubli des vieux instantanés: purge (lourde en SFTP) seulement le dimanche
    if [ "$(date +%u)" = 7 ]; then
        restic forget --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --prune >>"$STATE/backup.log" 2>>"$STATE/backup.err"
    fi
    echo ok >"$STATE/backup.status"; touch "$STATE/backup.stamp"
    pkill -RTMIN+18 waybar
    notify-send -u low -a backup "Sauvegarde NAS terminée" "$(tail -n 1 "$STATE/backup.log")"
    exit 0
fi
echo fail >"$STATE/backup.status"
pkill -RTMIN+18 waybar
notify-send -u critical -a backup "Sauvegarde NAS échouée" "$(tail -n 2 "$STATE/backup.err" | tr '\n' ' ')"
exit 1
