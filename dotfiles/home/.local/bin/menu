#!/bin/sh
# Menu tout-en-un (fuzzel --dmenu), équivalent léger du menu Walker d'Omarchy.
# Catégories d'abord; dès qu'on tape, recherche floue globale (applications, actions, entrées perso).
# Aucun démon: il n'existe que le temps du menu (0 Mo au repos).
#
#   menu                  catégories à vide; en tapant, recherche floue sur tout
#   menu apps|clip|emoji|calc|windows|files|web|keys|toggles|system|audio|network|style|packages|capture|custom
#                         ouvre directement une section (raccourcis clavier)
#
# Entrées perso: ~/.config/menu/entries (Libellé | mode | commande).

WALLPAPERS="$HOME/.local/share/wallpapers"
EMOJIS="$HOME/.local/share/menu/emoji.txt"
ENTRIES="${XDG_CONFIG_HOME:-$HOME/.config}/menu/entries"
TAB="$(printf '\t')"
BACK=10 # code de retour: annulé (Échap), on remonte au niveau parent

# Glyphes Font Awesome 4 via Symbols Nerd Font Mono (largeur fixe: libellés alignés, 0 Mo en plus)
I_APPS="$(printf '\357\200\211')"  # U+F009 th-large
I_CLIP="$(printf '\357\203\252')"  # U+F0EA clipboard
I_EMOJI="$(printf '\357\204\230')"  # U+F118 smile
I_CALC="$(printf '\357\207\254')"  # U+F1EC calculator
I_SYS="$(printf '\357\200\221')"  # U+F011 power-off
I_AUDIO="$(printf '\357\200\250')"  # U+F028 volume-up
I_NET="$(printf '\357\207\253')"  # U+F1EB wifi
I_STYLE="$(printf '\357\207\274')"  # U+F1FC paint-brush
I_PKG="$(printf '\357\206\262')"  # U+F1B2 cube
I_CUSTOM="$(printf '\357\200\205')"  # U+F005 star
I_LOCK="$(printf '\357\200\243')"  # U+F023 lock
I_SLEEP="$(printf '\357\206\206')"  # U+F186 moon
I_LOGOUT="$(printf '\357\202\213')"  # U+F08B sign-out
I_REBOOT="$(printf '\357\200\236')"  # U+F01E repeat
I_VOLDN="$(printf '\357\200\247')"  # U+F027 volume-down
I_MUTE="$(printf '\357\200\246')"  # U+F026 volume-off
I_MIC="$(printf '\357\204\261')"  # U+F131 microphone-slash
I_PHONES="$(printf '\357\200\245')"  # U+F025 headphones
I_GLOBE="$(printf '\357\202\254')"  # U+F0AC globe
I_IMAGE="$(printf '\357\200\276')"  # U+F03E picture
I_RELOAD="$(printf '\357\200\241')"  # U+F021 refresh
I_SEARCH="$(printf '\357\200\202')"  # U+F002 search
I_TRASH="$(printf '\357\207\270')"  # U+F1F8 trash
I_DOWN="$(printf '\357\200\231')"  # U+F019 download
I_BROOM="$(printf '\357\204\255')"  # U+F12D eraser
I_TERM="$(printf '\357\204\240')"  # U+F120 terminal
I_CODE="$(printf '\357\204\241')"  # U+F121 code
I_CHART="$(printf '\357\202\200')"  # U+F080 bar-chart
I_COLS="$(printf '\357\203\233')"  # U+F0DB columns
I_CAM="$(printf '\357\200\260')"  # U+F030 camera
I_WIN="$(printf '\357\213\220')"  # U+F2D0 window-maximize

# Maj+Retour arrière = custom-1 de fuzzel (code de sortie 10): remonte d'un niveau.
# Échap = sortie vide, code 1: quitte tout le menu. Option passée ici seulement: dans le lanceur
# d'applications (fuzzel seul), custom-1 lancerait l'application sélectionnée.
STATE="${XDG_RUNTIME_DIR:-/tmp}/menu-back.$$"
KEYS="--override=key-bindings.custom-1=Shift+BackSpace"
BINDS="${XDG_RUNTIME_DIR:-/tmp}/menu-binds.$$"
trap 'rm -f "$STATE" "$BINDS"' EXIT

pick() { # pick INVITE [LIGNES] [LARGEUR] [POLICE]  (entrées sur stdin, sélection sur stdout; vide si annulé)
    out="$(fuzzel --dmenu $KEYS --minimal-lines --lines "${2:-12}" ${3:+--width "$3"} ${4:+--font "$4"} --prompt "$1")"; rc=$?
    if [ "$rc" -eq 10 ]; then : > "$STATE"; return 0; fi
    [ -n "$out" ] && printf '%s\n' "$out"
    return 0
}
ask() { # saisie libre
    out="$(fuzzel --dmenu $KEYS --prompt-only "$1")"; rc=$?
    if [ "$rc" -eq 10 ]; then : > "$STATE"; return 0; fi
    [ -n "$out" ] && printf '%s\n' "$out"
    return 0
}
# Appelée quand une saisie est vide: Échap quitte tout, Maj+Retour arrière revient (code BACK)
cancel() {
    if [ -e "$STATE" ]; then rm -f "$STATE"; return "$BACK"; fi
    exit 0
}
notify() { command -v notify-send >/dev/null && notify-send -a menu "$@"; }
confirm() { # Oui -> 0 ; Non -> 1 ; annulé -> cancel (quitte ou revient) puis 1
    case "$(printf 'Non
Oui
' | pick "$1 › " 2)" in
        Oui) return 0 ;;
        Non) return 1 ;;
        *) cancel; return 1 ;;
    esac
}
term() { # term COMMANDE : terminal gardé ouvert à la fin
    exec foot -e sh -c "$1; echo; printf 'Entrée pour fermer '; read _"
}
trim() { printf '%s' "$1" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//'; }

# ---------------------------------------------------------------- applications

# Sortie: Nom<TAB>Commande<TAB>Terminal (fichiers .desktop visibles, sans doublon de nom)
list_apps() {
    for d in /usr/share/applications "$HOME/.local/share/applications"; do
        [ -d "$d" ] && for f in "$d"/*.desktop; do [ -f "$f" ] && echo "$f"; done
    done | xargs awk '
        function flush() {
            if (name != "" && cmd != "" && type == "Application" && nodisplay != "true" && hidden != "true") {
                gsub(/%c/, name, cmd)
                gsub(/ ?%[fFuUdDnNikvm]/, "", cmd)
                print name "\t" cmd "\t" term
            }
            name = ""; cmd = ""; term = "false"; type = ""; nodisplay = ""; hidden = ""
        }
        FNR == 1 { flush(); ing = 0 }
        /^\[/ { ing = ($0 == "[Desktop Entry]"); next }
        !ing { next }
        {
            key = $0; sub(/=.*/, "", key)
            val = $0; sub(/^[^=]*=/, "", val)
            if (key == "Name" && name == "") name = val
            else if (key == "Exec" && cmd == "") cmd = val
            else if (key == "Terminal") term = val
            else if (key == "Type") type = val
            else if (key == "NoDisplay") nodisplay = val
            else if (key == "Hidden") hidden = val
        }
        END { flush() }
    ' | sort -t "$TAB" -k1,1 -u
}

run_app() { # run_app NOM : retourne 1 si aucune application de ce nom
    line="$(list_apps | awk -F'\t' -v n="$1" '$1 == n { print; exit }')"
    [ -n "$line" ] || return 1
    cmd="$(printf '%s' "$line" | cut -f2)"
    istty="$(printf '%s' "$line" | cut -f3)"
    if [ "$istty" = "true" ]; then
        exec foot -e sh -c "$cmd"
    else
        setsid sh -c "$cmd" >/dev/null 2>&1 &
        exit 0
    fi
}

# ---------------------------------------------------------------- entrées perso

custom_labels() { # libellés valides du fichier d'entrées
    [ -f "$ENTRIES" ] || return 0
    while IFS='|' read -r label mode cmd; do
        label="$(trim "$label")"
        case "$label" in ''|'#'*) continue ;; esac
        [ -n "$(trim "$mode")" ] && [ -n "$(trim "$cmd")" ] && printf '%s\n' "$label"
    done < "$ENTRIES"
}

custom_run() { # custom_run LIBELLÉ : retourne 1 si le libellé n'existe pas
    [ -f "$ENTRIES" ] || return 1
    while IFS='|' read -r label mode cmd; do
        label="$(trim "$label")"
        case "$label" in ''|'#'*) continue ;; esac
        [ "$label" = "$1" ] || continue
        mode="$(trim "$mode")"
        cmd="$(trim "$cmd")"
        case "$mode" in
            term) exec foot -e sh -c "$cmd" ;;
            hold) term "$cmd" ;;
            run) setsid sh -c "$cmd" >/dev/null 2>&1 & exit 0 ;;
            *) notify -u critical "Menu" "Mode inconnu '$mode' pour $label"; exit 1 ;;
        esac
    done < "$ENTRIES"
    return 1
}

menu_custom() {
    arg="$1"
    while :; do
        act="${arg:-$(printf 'Ajouter une entrée\nModifier le fichier\n' | pick "Entrées perso › " 2)}"
        [ -n "$act" ] || { cancel; return $BACK; }
        case "$act" in
            "Ajouter une entrée")
                label="$(ask "Libellé › ")"
                if [ -z "$label" ]; then cancel
                else
                    case "$label" in *'|'*|'#'*) notify -u critical "Menu" "Libellé invalide (pas de | ni de # au début)"; return 1 ;; esac
                    mode="$(printf 'term  (terminal, fermé à la fin)\nhold  (terminal gardé ouvert)\nrun   (arrière-plan, appli graphique)\n' | pick "Mode › " 3)"
                    mode="${mode%% *}"
                    if [ -z "$mode" ]; then cancel
                    else
                        cmd="$(ask "Commande › ")"
                        if [ -z "$cmd" ]; then cancel
                        else
                            mkdir -p "$(dirname "$ENTRIES")"
                            printf '%s | %s | %s\n' "$label" "$mode" "$cmd" >> "$ENTRIES"
                            notify "Menu" "Entrée ajoutée: $label"
                            return 0
                        fi
                    fi
                fi
                ;;
            "Modifier le fichier") exec foot -e nvim "$ENTRIES" ;;
        esac
        [ -n "$arg" ] && return $BACK # annulé depuis la liste unique
    done
}

# ---------------------------------------------------------------- sections
# Navigation clavier: Maj+Retour arrière remonte d'un niveau, Échap quitte tout le menu.
# Chaque section est une boucle: annuler une sous-étape revient au menu de la section.
# Une action terminée ferme le menu. Avec un argument (liste unique), l'action est directe.

menu_apps() { exec fuzzel; }

menu_clip() {
    command -v cliphist >/dev/null || { notify "Presse-papiers" "cliphist n'est pas installé"; return 1; }
    sel="$(cliphist list | pick "Presse-papiers › " 15)"
    [ -n "$sel" ] || { cancel; return $BACK; }
    printf '%s' "$sel" | cliphist decode | wl-copy
}

menu_emoji() {
    sel="$(pick "Émoji › " 12 < "$EMOJIS")"
    [ -n "$sel" ] || { cancel; return $BACK; }
    char="${sel%% *}"
    printf '%s' "$char" | wl-copy
    notify "Émoji copié" "$char"
}

menu_calc() {
    command -v qalc >/dev/null || { notify "Calculatrice" "qalculate n'est pas installé"; return 1; }
    while :; do
        expr="$(ask "= ")"
        [ -n "$expr" ] || { cancel; return $BACK; }
        res="$(qalc -t "$expr" 2>&1)"
        sel="$(printf '%s\nNouveau calcul\n' "$res" | pick "$expr = " 3)"
        case "$sel" in
            "") cancel; return $BACK ;;
            "Nouveau calcul") continue ;;
            *) printf '%s' "$res" | wl-copy; return 0 ;;
        esac
    done
}

menu_system() {
    arg="$1"
    while :; do
        act="${arg:-$(printf 'Verrouiller\nVeille\nDéconnexion\nRedémarrer\nÉteindre\n' | pick "Système › " 5)}"
        [ -n "$act" ] || { cancel; return $BACK; }
        case "$act" in
            Verrouiller) exec swaylock -f -c 1e1e2e ;;
            Veille) sudo -n zzz; return 0 ;;
            Déconnexion) confirm "Quitter la session" && exec niri msg action quit --skip-confirmation ;;
            Redémarrer) confirm "Redémarrer" && { sudo -n reboot; return 0; } ;;
            Éteindre) confirm "Éteindre" && { sudo -n poweroff; return 0; } ;;
        esac
        [ -n "$arg" ] && return $BACK
    done
}

menu_audio() {
    arg="$1"
    while :; do
        act="${arg:-$(printf 'Volume +\nVolume -\nMuet / son\nMicro muet / actif\nChoisir la sortie\n' | pick "Audio › " 5)}"
        [ -n "$act" ] || { cancel; return $BACK; }
        case "$act" in
            "Volume +") wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+; return 0 ;;
            "Volume -") wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-; return 0 ;;
            "Muet / son") wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle; return 0 ;;
            "Micro muet / actif") wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle; return 0 ;;
            "Choisir la sortie")
                sinks="$(wpctl status | awk '/Sinks:/{f=1;next} /Sources:|Filters:|Streams:/{f=0} f' \
                    | sed -E -n 's/^[^0-9]*([0-9]+)\. (.*)$/\1 \2/p')"
                sel="$(printf '%s\n' "$sinks" | pick "Sortie audio › " 8)"
                if [ -n "$sel" ]; then wpctl set-default "${sel%% *}"; return 0; fi
                cancel
                ;;
        esac
        [ -n "$arg" ] && return $BACK
    done
}

menu_network() {
    arg="$1"
    while :; do
        act="${arg:-$(printf 'Wi-Fi (impala)\nAdresses IP\nTester la connexion\nPerte de paquets\nTest de débit\n' | pick "Réseau › " 5)}"
        [ -n "$act" ] || { cancel; return $BACK; }
        case "$act" in
            "Adresses IP")
                sel="$(ip -br addr | grep -v '^lo' | pick "Adresses › " 8)"
                if [ -n "$sel" ]; then printf '%s' "$sel" | awk '{print $3}' | wl-copy; return 0; fi
                cancel
                ;;
            "Wi-Fi (impala)") exec "$HOME/.local/bin/bar-tui" impala ;;
            "Perte de paquets")
                notify "Réseau" "Ping en cours (10 paquets)..."
                notify "Réseau" "$(ping -c10 -i0.3 -W2 1.1.1.1 2>&1 | tail -2 | tr '\n' ' ')"
                return 0
                ;;
            "Test de débit")
                notify "Réseau" "Test de débit (25 Mo, Cloudflare)..."
                bps="$(curl -fsS -m 60 -o /dev/null -w '%{speed_download}' 'https://speed.cloudflare.com/__down?bytes=25000000' 2>/dev/null)" \
                    && notify "Réseau" "Descendant: $(awk -v b="$bps" 'BEGIN{printf "%.0f Mbit/s", b*8/1e6}')" \
                    || notify -u critical "Réseau" "Test de débit impossible"
                return 0
                ;;
            "Tester la connexion")
                if ping -c1 -W2 1.1.1.1 >/dev/null 2>&1; then notify "Réseau" "Connexion OK"; else notify -u critical "Réseau" "Pas de connexion"; fi
                return 0
                ;;
        esac
        [ -n "$arg" ] && return $BACK
    done
}

menu_style() {
    arg="$1"
    while :; do
        act="${arg:-$(printf 'Fond d'"'"'écran\nRecharger Waybar\nRecharger mako\n' | pick "Style › " 3)}"
        [ -n "$act" ] || { cancel; return $BACK; }
        case "$act" in
            "Fond d'écran")
                sel="$(ls "$WALLPAPERS" 2>/dev/null | pick "Fond d'écran › " 10)"
                if [ -n "$sel" ]; then
                    setsid "$HOME/.local/bin/wallpaper" "$WALLPAPERS/$sel" >/dev/null 2>&1 &
                    return 0
                fi
                cancel
                ;;
            "Recharger Waybar") pkill -USR2 waybar; return 0 ;;
            "Recharger mako") makoctl reload; return 0 ;;
        esac
        [ -n "$arg" ] && return $BACK
    done
}

menu_capture() {
    arg="$1"
    act="${arg:-$(printf 'Zone\nÉcran\nFenêtre\nCouleur (pipette)\nEnregistrement vidéo\n' | pick "Capture › " 5)}"
    [ -n "$act" ] || { cancel; return $BACK; }
    sleep 0.4 # laisse fuzzel disparaître avant de capturer
    case "$act" in
        Zone) niri msg action screenshot ;;
        Écran) niri msg action screenshot-screen ;;
        Fenêtre) niri msg action screenshot-window ;;
        "Couleur (pipette)")
            c="$(niri msg pick-color 2>/dev/null | grep -io '#[0-9a-f]\{6\}' | head -n1)"
            [ -n "$c" ] && { printf '%s' "$c" | wl-copy; notify "Couleur copiée" "$c"; } ;;
        "Enregistrement vidéo") exec "$HOME/.local/bin/bar-toggle" rec ;;
    esac
}

menu_windows() {
    # Liste des fenêtres ouvertes (niri), sélection = focus
    sel="$(niri msg -j windows | python3 -I -c '
import json,sys
for w in json.load(sys.stdin):
    print("%d\t%s  ·  %s" % (w["id"], w.get("app_id") or "?", w.get("title") or ""))
' | cut -f2- | pick "Fenêtre › " 10)"
    [ -n "$sel" ] || { cancel; return $BACK; }
    id="$(niri msg -j windows | python3 -I -c '
import json,sys
t=sys.argv[1]
for w in json.load(sys.stdin):
    if "%s  ·  %s" % (w.get("app_id") or "?", w.get("title") or "") == t:
        print(w["id"]); break
' "$sel")"
    [ -n "$id" ] && niri msg action focus-window --id "$id"
}

menu_files() {
    # Recherche de fichiers (fd) dans ~, ouverture avec l'application par défaut
    q="$(ask "Fichier › ")"
    [ -n "$q" ] || { cancel; return $BACK; }
    sel="$(fd --type f --hidden --exclude .git --exclude node_modules --exclude .cache "$q" "$HOME" 2>/dev/null | head -200 | sed "s|^$HOME/|~/|" | pick "Fichiers › " 12)"
    [ -n "$sel" ] || { cancel; return $BACK; }
    setsid xdg-open "$HOME/${sel#\~/}" >/dev/null 2>&1 &
}

menu_web() {
    # Préfixes: g (Google), ddg, yt, w (Wikipédia fr), gh (GitHub), ou toute URL
    q="$(ask "Web (g/ddg/yt/w/gh …) › ")"
    [ -n "$q" ] || { cancel; return $BACK; }
    enc() { printf '%s' "$1" | python3 -I -c 'import sys,urllib.parse;print(urllib.parse.quote_plus(sys.stdin.read()))'; }
    case "$q" in
        g\ *) url="https://www.google.com/search?q=$(enc "${q#g }")" ;;
        ddg\ *) url="https://duckduckgo.com/?q=$(enc "${q#ddg }")" ;;
        yt\ *) url="https://www.youtube.com/results?search_query=$(enc "${q#yt }")" ;;
        w\ *) url="https://fr.wikipedia.org/w/index.php?search=$(enc "${q#w }")" ;;
        gh\ *) url="https://github.com/search?q=$(enc "${q#gh }")" ;;
        http://*|https://*) url="$q" ;;
        *.*) url="https://$q" ;;
        *) url="https://duckduckgo.com/?q=$(enc "$q")" ;;
    esac
    setsid xdg-open "$url" >/dev/null 2>&1 &
}

menu_keys() {
    # Raccourcis niri extraits de la config, recherche floue; Entrée copie la touche
    cfg="${XDG_CONFIG_HOME:-$HOME/.config}/niri/config.kdl"
    sel="$(awk '
        /^binds[[:space:]]*\{/ {b=1; next}
        b && /^\}/ {b=0}
        b && /^[[:space:]]*[A-Za-z0-9_+]+[[:space:]]/ && !/^[[:space:]]*\/\// {
            key=$1; t=""
            if (match($0, /hotkey-overlay-title="[^"]*"/)) t=substr($0, RSTART+22, RLENGTH-23)
            else {
                a=$0; sub(/^[^{]*\{[[:space:]]*/, "", a); sub(/[[:space:];]*\}.*$/, "", a)
                gsub(/"/, "", a); sub(/^spawn-sh /, "", a); sub(/^spawn /, "", a); gsub(/-/, " ", a)
                t=a
            }
            printf "%s  —  %s\n", key, t
        }' "$cfg" | pick "Raccourcis › " 14 70)"
    [ -n "$sel" ] || { cancel; return $BACK; }
    printf '%s' "${sel%% *}" | wl-copy
}

menu_toggles() {
    arg="$1"
    while :; do
        act="${arg:-$(printf 'Verrouillage auto\nMode avion\nMode présentation\nVeilleuse\nNe pas déranger\nFond d'"'"'écran suivant\n' | pick "Bascules › " 6)}"
        [ -n "$act" ] || { cancel; return $BACK; }
        case "$act" in
            "Verrouillage auto") "$HOME/.local/bin/bar-toggle" idle; return 0 ;;
            "Mode avion") "$HOME/.local/bin/bar-toggle" air; return 0 ;;
            "Mode présentation") "$HOME/.local/bin/bar-toggle" present; return 0 ;;
            Veilleuse) "$HOME/.local/bin/bar-toggle" night; return 0 ;;
            "Ne pas déranger") makoctl mode -t do-not-disturb; pkill -RTMIN+9 waybar; return 0 ;;
            "Fond d'écran suivant")
                cur="$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper" 2>/dev/null)"
                next="$(ls "$WALLPAPERS" | awk -v c="$(basename "$cur")" 'NR==1{f=$0} hit{print; done=1; exit} $0==c{hit=1} END{if(!done)print f}')"
                setsid "$HOME/.local/bin/wallpaper" "$WALLPAPERS/$next" >/dev/null 2>&1 &
                return 0 ;;
        esac
        [ -n "$arg" ] && return $BACK
    done
}

menu_packages() {
    arg="$1"
    while :; do
        act="${arg:-$(printf 'Rechercher et installer\nSupprimer\nMettre à jour le système\nNettoyer le cache\n' | pick "Paquets › " 4)}"
        [ -n "$act" ] || { cancel; return $BACK; }
        case "$act" in
            "Rechercher et installer")
                q="$(ask "Paquet › ")"
                if [ -z "$q" ]; then cancel
                else
                    sel="$(xbps-query -Rs "$q" | head -60 | sed -E 's/^\[.\] //' | pick "Résultats › " 15)"
                    if [ -z "$sel" ]; then cancel
                    else
                        pkg="$(printf '%s' "$sel" | awk '{print $1}' | sed -E 's/-[^-]+$//')"
                        term "echo 'Budget ressources: vérifier la taille et les dépendances avant d installer.'; xbps-query -R -p pkgver,installed_size $pkg; echo; sudo xbps-install -S $pkg"
                    fi
                fi
                ;;
            Supprimer)
                sel="$(xbps-query -m | sed -E 's/-[^-]+$//' | pick "Supprimer › " 15)"
                if [ -z "$sel" ]; then cancel
                elif confirm "Supprimer $sel"; then term "sudo xbps-remove -R $sel"
                fi
                ;;
            "Mettre à jour le système") term "sudo xbps-install -Su" ;;
            "Nettoyer le cache") term "sudo xbps-remove -yO; df -h /" ;;
        esac
        [ -n "$arg" ] && return $BACK
    done
}

# ---------------------------------------------------------------- liste unique

# Actions directes, libellé "Catégorie: Action" (la catégorie sert aussi à la recherche)
actions_list() {
    cat <<EOF
$I_LOCK Système: Verrouiller
$I_SLEEP Système: Veille
$I_LOGOUT Système: Déconnexion
$I_REBOOT Système: Redémarrer
$I_SYS Système: Éteindre
$I_AUDIO Audio: Volume +
$I_VOLDN Audio: Volume -
$I_MUTE Audio: Muet / son
$I_MIC Audio: Micro muet / actif
$I_PHONES Audio: Choisir la sortie
$I_GLOBE Réseau: Adresses IP
$I_NET Réseau: Tester la connexion
$I_IMAGE Style: Fond d'écran
$I_RELOAD Style: Recharger Waybar
$I_RELOAD Style: Recharger mako
$I_CAM Capture: Zone
$I_CAM Capture: Écran
$I_CAM Capture: Fenêtre
$I_WIN Fenêtres: Aller à une fenêtre
$I_SEARCH Fichiers: Rechercher un fichier
$I_GLOBE Web: Rechercher ou ouvrir une URL
$I_CODE Raccourcis: Aide des raccourcis
$I_LOCK Bascules: Verrouillage auto
$I_NET Bascules: Mode avion
$I_CHART Bascules: Mode présentation
$I_SLEEP Bascules: Veilleuse
$I_MUTE Bascules: Ne pas déranger
$I_IMAGE Bascules: Fond d'écran suivant
$I_CAM Capture: Couleur (pipette)
$I_SEARCH Paquets: Rechercher et installer
$I_TRASH Paquets: Supprimer
$I_DOWN Paquets: Mettre à jour le système
$I_BROOM Paquets: Nettoyer le cache
EOF
}

# Catégories: affichées en premier. Sans saisie, la liste est limitée à leur nombre de lignes
# (on ne voit qu'elles); dès qu'on tape, la recherche floue porte sur TOUTE la liste.
categories_list() {
    cat <<EOF
$I_APPS Applications ›
$I_CLIP Presse-papiers ›
$I_EMOJI Émojis ›
$I_CALC Calculatrice ›
$I_WIN Fenêtres ›
$I_SEARCH Fichiers ›
$I_GLOBE Web ›
$I_CODE Raccourcis ›
$I_LOCK Bascules ›
$I_SYS Système ›
$I_AUDIO Audio ›
$I_NET Réseau ›
$I_STYLE Style ›
$I_PKG Paquets ›
$I_CUSTOM Entrées perso ›
EOF
}

# Glyphe d'une application selon son nom ou sa commande (repli: fenêtre générique)
app_glyph() {
    case "$(printf '%s %s' "$1" "$2" | tr 'A-Z' 'a-z')" in
        *chrom*|*firefox*|*browser*|*navigat*|*brave*|*epiphany*) printf '%s' "$I_GLOBE" ;;
        *alacritty*|*terminal*|*kitty*|*foot*|*konsole*) printf '%s' "$I_TERM" ;;
        *nvim*|*vim*|*emacs*|*code*|*editor*|*éditeur*) printf '%s' "$I_CODE" ;;
        *htop*|*btop*|*monitor*|*moniteur*|*top\ *) printf '%s' "$I_CHART" ;;
        *zellij*|*tmux*) printf '%s' "$I_COLS" ;;
        *) printf '%s' "$I_WIN" ;;
    esac
}

# ---------------------------------------------------------------- raccourcis affichés à côté des noms

# Table "touche<TAB>action" extraite des binds de niri (guillemets et spawn retirés)
bind_table() {
    awk '
        /^binds[[:space:]]*\{/ {b=1; next}
        b && /^\}/ {b=0}
        b && /^[[:space:]]*[A-Za-z0-9_+]+[[:space:]]/ && !/^[[:space:]]*\/\// {
            a=$0; sub(/^[^{]*\{[[:space:]]*/, "", a); sub(/[[:space:];]*\}.*$/, "", a)
            gsub(/"/, "", a); sub(/^spawn-sh /, "", a); sub(/^spawn /, "", a)
            printf "%s\t%s\n", $1, a
        }' "${XDG_CONFIG_HOME:-$HOME/.config}/niri/config.kdl" > "$BINDS" 2>/dev/null
}

# hint TEXTE : première touche dont l'action est TEXTE (ou contient TEXTE si préfixé par ~)
hint() {
    awk -F'\t' -v n="$1" '
        BEGIN { sub_ = (substr(n,1,1) == "~"); if (sub_) n = substr(n,2) }
        (sub_ ? index($2, n) : $2 == n) { print $1; exit }' "$BINDS"
}
# Noms de touches lisibles (rangée de chiffres bépo, touches multimédia)
pretty_key() {
    printf '%s' "$1" | sed -E 's/\+quotedbl$/+1/; s/\+guillemotleft$/+2/; s/\+guillemotright$/+3/; s/\+parenleft$/+4/; s/\+parenright$/+5/; s/\+at$/+6/; s/\+plus$/+7/; s/\+minus$/+8/; s/\+slash$/+9/; s/\+Comma$/+,/; s/\+Period$/+./; s/^XF86AudioRaiseVolume$/Vol +/; s/^XF86AudioLowerVolume$/Vol -/; s/^XF86AudioMute$/Muet/; s/^XF86AudioMicMute$/Micro muet/'
}
fmt_hint() { h="$(hint "$1")"; [ -n "$h" ] && printf '  ‹%s›' "$(pretty_key "$h")"; return 0; }

# Action de niri ou commande correspondant à un libellé du menu
action_needle() {
    case "$1" in
        "Applications ›") echo "~fuzzel" ;;
        "Fenêtres ›"|"Fenêtres: "*) echo "~menu windows" ;;
        "Raccourcis ›"|"Raccourcis: "*) echo "~menu keys" ;;
        "Système: Verrouiller") echo "~swaylock" ;;
        "Système: Déconnexion") echo "quit" ;;
        "Audio: Volume +") echo "~0.1+" ;;
        "Audio: Volume -") echo "~0.1-" ;;
        "Audio: Muet / son") echo "~SINK@ toggle" ;;
        "Audio: Micro muet / actif") echo "~SOURCE@ toggle" ;;
        "Bascules: Ne pas déranger") echo "~do-not-disturb" ;;
        "Capture: Zone") echo "screenshot" ;;
        "Capture: Écran") echo "screenshot-screen" ;;
        "Capture: Fenêtre") echo "screenshot-window" ;;
    esac
}

# Mise en page du menu principal (police à chasse fixe): glyphe + 2 espaces, touche alignée à droite.
# Largeur en caractères = largeur fuzzel (36) moins les marges.
MENU_FONT="DejaVu Sans Mono:size=12,Symbols Nerd Font Mono:size=12"
MENU_COLS=33
align_hints() {
    awk -v w="$MENU_COLS" '{
        key = ""; line = $0
        if (match(line, /  ‹[^‹›]*›$/)) { key = substr(line, RSTART + 3, RLENGTH - 4); line = substr(line, 1, RSTART - 1) }
        sub(/ /, "  ", line)
        if (key != "") { pad = w - length(line) - length(key) - 2; if (pad < 2) pad = 2; line = sprintf("%s%*s‹%s›", line, pad, "", key) }
        print line
    }'
}

# Ajoute "  ‹touche›" aux lignes "GLYPHE Libellé" quand une touche existe
with_hints() {
    while IFS= read -r line; do
        n="$(action_needle "${line#* }")"
        if [ -n "$n" ]; then printf '%s%s\n' "$line" "$(fmt_hint "$n")"; else printf '%s\n' "$line"; fi
    done
}

menu_main() {
    bind_table
    cats="$(categories_list | with_hints)"
    nb="$(printf '%s\n' "$cats" | wc -l | tr -d ' ')"
    customs="$(custom_labels | while IFS= read -r l; do printf '%s %s\n' "$I_CUSTOM" "$l"; done)"
    apps="$(list_apps | while IFS="$TAB" read -r name cmd _; do printf '%s %s%s\n' "$(app_glyph "$name" "$cmd")" "$name" "$(fmt_hint "$cmd")"; done)"
    items="$( { printf '%s\n' "$cats"; [ -n "$customs" ] && printf '%s\n' "$customs"; [ -n "$apps" ] && printf '%s\n' "$apps"; actions_list | with_hints; } )"

    while :; do # Échap dans une section revient ici; Échap ici quitte
        sel="$(printf '%s\n' "$items" | align_hints | pick "› " "$nb" "" "$MENU_FONT")"
        [ -n "$sel" ] || exit 0
        sel="${sel#* }" # retire le glyphe et le 1er espace
        sel="${sel# }"  # ... et le 2e
        sel="$(printf '%s' "$sel" | sed 's/ *‹[^‹›]*›$//')" # retire la touche affichée

        rc=0
        case "$sel" in
            "Applications ›") menu_apps; rc=$? ;;
            "Presse-papiers ›") menu_clip; rc=$? ;;
            "Émojis ›") menu_emoji; rc=$? ;;
            "Calculatrice ›") menu_calc; rc=$? ;;
            "Fenêtres ›") menu_windows; rc=$? ;;
            "Fichiers ›") menu_files; rc=$? ;;
            "Web ›") menu_web; rc=$? ;;
            "Raccourcis ›") menu_keys; rc=$? ;;
            "Bascules ›") menu_toggles; rc=$? ;;
            "Système ›") menu_system; rc=$? ;;
            "Audio ›") menu_audio; rc=$? ;;
            "Réseau ›") menu_network; rc=$? ;;
            "Style ›") menu_style; rc=$? ;;
            "Paquets ›") menu_packages; rc=$? ;;
            "Entrées perso ›") menu_custom; rc=$? ;;
            *)
                custom_run "$sel" # exec/exit si trouvé
                run_app "$sel"
                case "$sel" in
                    "Fenêtres: "*) menu_windows; rc=$? ;;
                    "Fichiers: "*) menu_files; rc=$? ;;
                    "Web: "*) menu_web; rc=$? ;;
                    "Raccourcis: "*) menu_keys; rc=$? ;;
                    "Bascules: "*) menu_toggles "${sel#Bascules: }"; rc=$? ;;
                    "Système: "*) menu_system "${sel#Système: }"; rc=$? ;;
                    "Audio: "*) menu_audio "${sel#Audio: }"; rc=$? ;;
                    "Réseau: "*) menu_network "${sel#Réseau: }"; rc=$? ;;
                    "Style: "*) menu_style "${sel#Style: }"; rc=$? ;;
                    "Paquets: "*) menu_packages "${sel#Paquets: }"; rc=$? ;;
                    "Capture: "*) menu_capture "${sel#Capture: }"; rc=$? ;;
                esac
                ;;
        esac
        [ "$rc" -eq "$BACK" ] || exit "$rc"
    done
}

case "${1:-}" in
    apps) menu_apps ;;
    clip) menu_clip ;;
    emoji) menu_emoji ;;
    calc) menu_calc ;;
    windows) menu_windows ;;
    files) menu_files ;;
    web) menu_web ;;
    keys) menu_keys ;;
    toggles) menu_toggles ;;
    system) menu_system ;;
    audio) menu_audio ;;
    network) menu_network ;;
    style) menu_style ;;
    packages) menu_packages ;;
    capture) menu_capture ;;
    custom) menu_custom ;;
    "") menu_main ;;
    *) echo "Usage: menu [apps|clip|emoji|calc|windows|files|web|keys|toggles|system|audio|network|style|packages|capture|custom]" >&2; exit 1 ;;
esac
rc=$?
[ "$rc" -eq "$BACK" ] && exit 0 # section lancée directement et annulée: sortie propre
exit "$rc"
