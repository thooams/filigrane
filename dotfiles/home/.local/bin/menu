#!/bin/sh
# Menu tout-en-un (fuzzel --dmenu), équivalent léger du menu Walker d'Omarchy.
# Catégories d'abord; dès qu'on tape, recherche floue globale (applications, actions, entrées perso).
# Aucun démon: il n'existe que le temps du menu (0 Mo au repos).
#
#   menu                  catégories à vide; en tapant, recherche floue sur tout
#   menu apps|clip|emoji|calc|system|audio|network|style|packages|capture|custom
#                         ouvre directement une section (raccourcis clavier)
#
# Entrées perso: ~/.config/menu/entries (Libellé | mode | commande). Échap quitte.

WALLPAPERS="$HOME/.local/share/wallpapers"
EMOJIS="$HOME/.local/share/menu/emoji.txt"
ENTRIES="${XDG_CONFIG_HOME:-$HOME/.config}/menu/entries"
TAB="$(printf '\t')"
BACK=10 # code de retour: annulé (Échap), on remonte au niveau parent

# Glyphes Font Awesome 4 via Symbols Nerd Font Mono (largeur fixe: libellés alignés, 0 Mo en plus)
I_APPS="$(printf '\357\200\211')"  # U+F009 th-large
I_CLIP="$(printf '\357\203\252')"  # U+F0EA clipboard
I_EMOJI="$(printf '\357\204\230')"  # U+F118 smile
I_CALC="$(printf '\357\207\254')"  # U+F1EC calculator
I_SYS="$(printf '\357\200\221')"  # U+F011 power-off
I_AUDIO="$(printf '\357\200\250')"  # U+F028 volume-up
I_NET="$(printf '\357\207\253')"  # U+F1EB wifi
I_STYLE="$(printf '\357\207\274')"  # U+F1FC paint-brush
I_PKG="$(printf '\357\206\262')"  # U+F1B2 cube
I_CUSTOM="$(printf '\357\200\205')"  # U+F005 star
I_LOCK="$(printf '\357\200\243')"  # U+F023 lock
I_SLEEP="$(printf '\357\206\206')"  # U+F186 moon
I_LOGOUT="$(printf '\357\202\213')"  # U+F08B sign-out
I_REBOOT="$(printf '\357\200\236')"  # U+F01E repeat
I_VOLDN="$(printf '\357\200\247')"  # U+F027 volume-down
I_MUTE="$(printf '\357\200\246')"  # U+F026 volume-off
I_MIC="$(printf '\357\204\261')"  # U+F131 microphone-slash
I_PHONES="$(printf '\357\200\245')"  # U+F025 headphones
I_GLOBE="$(printf '\357\202\254')"  # U+F0AC globe
I_IMAGE="$(printf '\357\200\276')"  # U+F03E picture
I_RELOAD="$(printf '\357\200\241')"  # U+F021 refresh
I_SEARCH="$(printf '\357\200\202')"  # U+F002 search
I_TRASH="$(printf '\357\207\270')"  # U+F1F8 trash
I_DOWN="$(printf '\357\200\231')"  # U+F019 download
I_BROOM="$(printf '\357\204\255')"  # U+F12D eraser
I_TERM="$(printf '\357\204\240')"  # U+F120 terminal
I_CODE="$(printf '\357\204\241')"  # U+F121 code
I_CHART="$(printf '\357\202\200')"  # U+F080 bar-chart
I_COLS="$(printf '\357\203\233')"  # U+F0DB columns
I_CAM="$(printf '\357\200\260')"  # U+F030 camera
I_WIN="$(printf '\357\213\220')"  # U+F2D0 window-maximize

pick() { # pick INVITE [LIGNES]  (entrées sur stdin, sélection sur stdout)
    fuzzel --dmenu --minimal-lines --lines "${2:-12}" --prompt "$1"
}
ask() { fuzzel --dmenu --prompt-only "$1"; } # saisie libre
notify() { command -v notify-send >/dev/null && notify-send -a menu "$@"; }
confirm() { [ "$(printf 'Non\nOui\n' | pick "$1 › " 2)" = "Oui" ]; }
term() { # term COMMANDE : terminal gardé ouvert à la fin
    exec alacritty -e sh -c "$1; echo; printf 'Entrée pour fermer '; read _"
}
trim() { printf '%s' "$1" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//'; }

# ---------------------------------------------------------------- applications

# Sortie: Nom<TAB>Commande<TAB>Terminal (fichiers .desktop visibles, sans doublon de nom)
list_apps() {
    for d in /usr/share/applications "$HOME/.local/share/applications"; do
        [ -d "$d" ] && for f in "$d"/*.desktop; do [ -f "$f" ] && echo "$f"; done
    done | xargs awk '
        function flush() {
            if (name != "" && cmd != "" && type == "Application" && nodisplay != "true" && hidden != "true") {
                gsub(/%c/, name, cmd)
                gsub(/ ?%[fFuUdDnNikvm]/, "", cmd)
                print name "\t" cmd "\t" term
            }
            name = ""; cmd = ""; term = "false"; type = ""; nodisplay = ""; hidden = ""
        }
        FNR == 1 { flush(); ing = 0 }
        /^\[/ { ing = ($0 == "[Desktop Entry]"); next }
        !ing { next }
        {
            key = $0; sub(/=.*/, "", key)
            val = $0; sub(/^[^=]*=/, "", val)
            if (key == "Name" && name == "") name = val
            else if (key == "Exec" && cmd == "") cmd = val
            else if (key == "Terminal") term = val
            else if (key == "Type") type = val
            else if (key == "NoDisplay") nodisplay = val
            else if (key == "Hidden") hidden = val
        }
        END { flush() }
    ' | sort -t "$TAB" -k1,1 -u
}

run_app() { # run_app NOM : retourne 1 si aucune application de ce nom
    line="$(list_apps | awk -F'\t' -v n="$1" '$1 == n { print; exit }')"
    [ -n "$line" ] || return 1
    cmd="$(printf '%s' "$line" | cut -f2)"
    istty="$(printf '%s' "$line" | cut -f3)"
    if [ "$istty" = "true" ]; then
        exec alacritty -e sh -c "$cmd"
    else
        setsid sh -c "$cmd" >/dev/null 2>&1 &
        exit 0
    fi
}

# ---------------------------------------------------------------- entrées perso

custom_labels() { # libellés valides du fichier d'entrées
    [ -f "$ENTRIES" ] || return 0
    while IFS='|' read -r label mode cmd; do
        label="$(trim "$label")"
        case "$label" in ''|'#'*) continue ;; esac
        [ -n "$(trim "$mode")" ] && [ -n "$(trim "$cmd")" ] && printf '%s\n' "$label"
    done < "$ENTRIES"
}

custom_run() { # custom_run LIBELLÉ : retourne 1 si le libellé n'existe pas
    [ -f "$ENTRIES" ] || return 1
    while IFS='|' read -r label mode cmd; do
        label="$(trim "$label")"
        case "$label" in ''|'#'*) continue ;; esac
        [ "$label" = "$1" ] || continue
        mode="$(trim "$mode")"
        cmd="$(trim "$cmd")"
        case "$mode" in
            term) exec alacritty -e sh -c "$cmd" ;;
            hold) term "$cmd" ;;
            run) setsid sh -c "$cmd" >/dev/null 2>&1 & exit 0 ;;
            *) notify -u critical "Menu" "Mode inconnu '$mode' pour $label"; exit 1 ;;
        esac
    done < "$ENTRIES"
    return 1
}

menu_custom() {
    arg="$1"
    while :; do
        act="${arg:-$(printf 'Ajouter une entrée\nModifier le fichier\n' | pick "Entrées perso › " 2)}"
        [ -n "$act" ] || return $BACK
        case "$act" in
            "Ajouter une entrée")
                label="$(ask "Libellé › ")"
                if [ -n "$label" ]; then
                    case "$label" in *'|'*|'#'*) notify -u critical "Menu" "Libellé invalide (pas de | ni de # au début)"; return 1 ;; esac
                    mode="$(printf 'term  (terminal, fermé à la fin)\nhold  (terminal gardé ouvert)\nrun   (arrière-plan, appli graphique)\n' | pick "Mode › " 3)"
                    mode="${mode%% *}"
                    if [ -n "$mode" ]; then
                        cmd="$(ask "Commande › ")"
                        if [ -n "$cmd" ]; then
                            mkdir -p "$(dirname "$ENTRIES")"
                            printf '%s | %s | %s\n' "$label" "$mode" "$cmd" >> "$ENTRIES"
                            notify "Menu" "Entrée ajoutée: $label"
                            return 0
                        fi
                    fi
                fi
                ;;
            "Modifier le fichier") exec alacritty -e nvim "$ENTRIES" ;;
        esac
        [ -n "$arg" ] && return $BACK # annulé depuis la liste unique
    done
}

# ---------------------------------------------------------------- sections
# Navigation clavier: Échap remonte d'un niveau (section -> menu principal -> quitter).
# Chaque section est une boucle: annuler une sous-étape revient au menu de la section.
# Une action terminée ferme le menu. Avec un argument (liste unique), l'action est directe.

menu_apps() { fuzzel && return 0; return $BACK; }

menu_clip() {
    command -v cliphist >/dev/null || { notify "Presse-papiers" "cliphist n'est pas installé"; return 1; }
    sel="$(cliphist list | pick "Presse-papiers › " 15)"
    [ -n "$sel" ] || return $BACK
    printf '%s' "$sel" | cliphist decode | wl-copy
}

menu_emoji() {
    sel="$(pick "Émoji › " 12 < "$EMOJIS")"
    [ -n "$sel" ] || return $BACK
    char="${sel%% *}"
    printf '%s' "$char" | wl-copy
    notify "Émoji copié" "$char"
}

menu_calc() {
    command -v qalc >/dev/null || { notify "Calculatrice" "qalculate n'est pas installé"; return 1; }
    while :; do
        expr="$(ask "= ")"
        [ -n "$expr" ] || return $BACK
        res="$(qalc -t "$expr" 2>&1)"
        sel="$(printf '%s\nNouveau calcul\n' "$res" | pick "$expr = " 3)"
        case "$sel" in
            "") return $BACK ;;
            "Nouveau calcul") continue ;;
            *) printf '%s' "$res" | wl-copy; return 0 ;;
        esac
    done
}

menu_system() {
    arg="$1"
    while :; do
        act="${arg:-$(printf 'Verrouiller\nVeille\nDéconnexion\nRedémarrer\nÉteindre\n' | pick "Système › " 5)}"
        [ -n "$act" ] || return $BACK
        case "$act" in
            Verrouiller) exec swaylock -f -c 1e1e2e ;;
            Veille) sudo -n zzz; return 0 ;;
            Déconnexion) confirm "Quitter la session" && exec niri msg action quit --skip-confirmation ;;
            Redémarrer) confirm "Redémarrer" && { sudo -n reboot; return 0; } ;;
            Éteindre) confirm "Éteindre" && { sudo -n poweroff; return 0; } ;;
        esac
        [ -n "$arg" ] && return $BACK
    done
}

menu_audio() {
    arg="$1"
    while :; do
        act="${arg:-$(printf 'Volume +\nVolume -\nMuet / son\nMicro muet / actif\nChoisir la sortie\n' | pick "Audio › " 5)}"
        [ -n "$act" ] || return $BACK
        case "$act" in
            "Volume +") wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+; return 0 ;;
            "Volume -") wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-; return 0 ;;
            "Muet / son") wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle; return 0 ;;
            "Micro muet / actif") wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle; return 0 ;;
            "Choisir la sortie")
                sinks="$(wpctl status | awk '/Sinks:/{f=1;next} /Sources:|Filters:|Streams:/{f=0} f' \
                    | sed -E -n 's/^[^0-9]*([0-9]+)\. (.*)$/\1 \2/p')"
                sel="$(printf '%s\n' "$sinks" | pick "Sortie audio › " 8)"
                if [ -n "$sel" ]; then wpctl set-default "${sel%% *}"; return 0; fi
                ;;
        esac
        [ -n "$arg" ] && return $BACK
    done
}

menu_network() {
    arg="$1"
    while :; do
        act="${arg:-$(printf 'Adresses IP\nTester la connexion\n' | pick "Réseau › " 2)}"
        [ -n "$act" ] || return $BACK
        case "$act" in
            "Adresses IP")
                sel="$(ip -br addr | grep -v '^lo' | pick "Adresses › " 8)"
                if [ -n "$sel" ]; then printf '%s' "$sel" | awk '{print $3}' | wl-copy; return 0; fi
                ;;
            "Tester la connexion")
                if ping -c1 -W2 1.1.1.1 >/dev/null 2>&1; then notify "Réseau" "Connexion OK"; else notify -u critical "Réseau" "Pas de connexion"; fi
                return 0
                ;;
        esac
        [ -n "$arg" ] && return $BACK
    done
}

menu_style() {
    arg="$1"
    while :; do
        act="${arg:-$(printf 'Fond d'"'"'écran\nRecharger Waybar\nRecharger mako\n' | pick "Style › " 3)}"
        [ -n "$act" ] || return $BACK
        case "$act" in
            "Fond d'écran")
                sel="$(ls "$WALLPAPERS" 2>/dev/null | pick "Fond d'écran › " 10)"
                if [ -n "$sel" ]; then
                    setsid "$HOME/.local/bin/wallpaper" "$WALLPAPERS/$sel" >/dev/null 2>&1 &
                    return 0
                fi
                ;;
            "Recharger Waybar") pkill -USR2 waybar; return 0 ;;
            "Recharger mako") makoctl reload; return 0 ;;
        esac
        [ -n "$arg" ] && return $BACK
    done
}

menu_capture() {
    arg="$1"
    act="${arg:-$(printf 'Zone\nÉcran\nFenêtre\n' | pick "Capture › " 3)}"
    [ -n "$act" ] || return $BACK
    sleep 0.4 # laisse fuzzel disparaître avant de capturer
    case "$act" in
        Zone) niri msg action screenshot ;;
        Écran) niri msg action screenshot-screen ;;
        Fenêtre) niri msg action screenshot-window ;;
    esac
}

menu_packages() {
    arg="$1"
    while :; do
        act="${arg:-$(printf 'Rechercher et installer\nSupprimer\nMettre à jour le système\nNettoyer le cache\n' | pick "Paquets › " 4)}"
        [ -n "$act" ] || return $BACK
        case "$act" in
            "Rechercher et installer")
                q="$(ask "Paquet › ")"
                if [ -n "$q" ]; then
                    sel="$(xbps-query -Rs "$q" | head -60 | sed -E 's/^\[.\] //' | pick "Résultats › " 15)"
                    if [ -n "$sel" ]; then
                        pkg="$(printf '%s' "$sel" | awk '{print $1}' | sed -E 's/-[^-]+$//')"
                        term "echo 'Budget ressources: vérifier la taille et les dépendances avant d installer.'; xbps-query -R -p pkgver,installed_size $pkg; echo; sudo xbps-install -S $pkg"
                    fi
                fi
                ;;
            Supprimer)
                sel="$(xbps-query -m | sed -E 's/-[^-]+$//' | pick "Supprimer › " 15)"
                [ -n "$sel" ] && confirm "Supprimer $sel" && term "sudo xbps-remove -R $sel"
                ;;
            "Mettre à jour le système") term "sudo xbps-install -Su" ;;
            "Nettoyer le cache") term "sudo xbps-remove -yO; df -h /" ;;
        esac
        [ -n "$arg" ] && return $BACK
    done
}

# ---------------------------------------------------------------- liste unique

# Actions directes, libellé "Catégorie: Action" (la catégorie sert aussi à la recherche)
actions_list() {
    cat <<EOF
$I_LOCK Système: Verrouiller
$I_SLEEP Système: Veille
$I_LOGOUT Système: Déconnexion
$I_REBOOT Système: Redémarrer
$I_SYS Système: Éteindre
$I_AUDIO Audio: Volume +
$I_VOLDN Audio: Volume -
$I_MUTE Audio: Muet / son
$I_MIC Audio: Micro muet / actif
$I_PHONES Audio: Choisir la sortie
$I_GLOBE Réseau: Adresses IP
$I_NET Réseau: Tester la connexion
$I_IMAGE Style: Fond d'écran
$I_RELOAD Style: Recharger Waybar
$I_RELOAD Style: Recharger mako
$I_CAM Capture: Zone
$I_CAM Capture: Écran
$I_CAM Capture: Fenêtre
$I_SEARCH Paquets: Rechercher et installer
$I_TRASH Paquets: Supprimer
$I_DOWN Paquets: Mettre à jour le système
$I_BROOM Paquets: Nettoyer le cache
EOF
}

# Catégories: affichées en premier. Sans saisie, la liste est limitée à leur nombre de lignes
# (on ne voit qu'elles); dès qu'on tape, la recherche floue porte sur TOUTE la liste.
categories_list() {
    cat <<EOF
$I_APPS Applications ›
$I_CLIP Presse-papiers ›
$I_EMOJI Émojis ›
$I_CALC Calculatrice ›
$I_SYS Système ›
$I_AUDIO Audio ›
$I_NET Réseau ›
$I_STYLE Style ›
$I_PKG Paquets ›
$I_CUSTOM Entrées perso ›
EOF
}

# Glyphe d'une application selon son nom ou sa commande (repli: fenêtre générique)
app_glyph() {
    case "$(printf '%s %s' "$1" "$2" | tr 'A-Z' 'a-z')" in
        *chrom*|*firefox*|*browser*|*navigat*|*brave*|*epiphany*) printf '%s' "$I_GLOBE" ;;
        *alacritty*|*terminal*|*kitty*|*foot*|*konsole*) printf '%s' "$I_TERM" ;;
        *nvim*|*vim*|*emacs*|*code*|*editor*|*éditeur*) printf '%s' "$I_CODE" ;;
        *htop*|*btop*|*monitor*|*moniteur*|*top\ *) printf '%s' "$I_CHART" ;;
        *zellij*|*tmux*) printf '%s' "$I_COLS" ;;
        *) printf '%s' "$I_WIN" ;;
    esac
}

menu_main() {
    cats="$(categories_list)"
    nb="$(printf '%s\n' "$cats" | wc -l | tr -d ' ')"
    customs="$(custom_labels | while IFS= read -r l; do printf '%s %s\n' "$I_CUSTOM" "$l"; done)"
    apps="$(list_apps | while IFS="$TAB" read -r name cmd _; do printf '%s %s\n' "$(app_glyph "$name" "$cmd")" "$name"; done)"
    items="$( { printf '%s\n' "$cats"; [ -n "$customs" ] && printf '%s\n' "$customs"; [ -n "$apps" ] && printf '%s\n' "$apps"; actions_list; } )"

    while :; do # Échap dans une section revient ici; Échap ici quitte
        sel="$(printf '%s\n' "$items" | pick "› " "$nb")"
        [ -n "$sel" ] || exit 0
        sel="${sel#* }" # retire le glyphe et l'espace qui le suit

        rc=0
        case "$sel" in
            "Applications ›") menu_apps; rc=$? ;;
            "Presse-papiers ›") menu_clip; rc=$? ;;
            "Émojis ›") menu_emoji; rc=$? ;;
            "Calculatrice ›") menu_calc; rc=$? ;;
            "Système ›") menu_system; rc=$? ;;
            "Audio ›") menu_audio; rc=$? ;;
            "Réseau ›") menu_network; rc=$? ;;
            "Style ›") menu_style; rc=$? ;;
            "Paquets ›") menu_packages; rc=$? ;;
            "Entrées perso ›") menu_custom; rc=$? ;;
            *)
                custom_run "$sel" # exec/exit si trouvé
                run_app "$sel"
                case "$sel" in
                    "Système: "*) menu_system "${sel#Système: }"; rc=$? ;;
                    "Audio: "*) menu_audio "${sel#Audio: }"; rc=$? ;;
                    "Réseau: "*) menu_network "${sel#Réseau: }"; rc=$? ;;
                    "Style: "*) menu_style "${sel#Style: }"; rc=$? ;;
                    "Paquets: "*) menu_packages "${sel#Paquets: }"; rc=$? ;;
                    "Capture: "*) menu_capture "${sel#Capture: }"; rc=$? ;;
                esac
                ;;
        esac
        [ "$rc" -eq "$BACK" ] || exit "$rc"
    done
}

case "${1:-}" in
    apps) menu_apps ;;
    clip) menu_clip ;;
    emoji) menu_emoji ;;
    calc) menu_calc ;;
    system) menu_system ;;
    audio) menu_audio ;;
    network) menu_network ;;
    style) menu_style ;;
    packages) menu_packages ;;
    capture) menu_capture ;;
    custom) menu_custom ;;
    "") menu_main ;;
    *) echo "Usage: menu [apps|clip|emoji|calc|system|audio|network|style|packages|capture|custom]" >&2; exit 1 ;;
esac
rc=$?
[ "$rc" -eq "$BACK" ] && exit 0 # section lancée directement et annulée: sortie propre
exit "$rc"
