#!/bin/sh
# Menu tout-en-un (fuzzel --dmenu), équivalent léger du menu Walker d'Omarchy.
# Catégories d'abord; dès qu'on tape, recherche floue globale (applications, actions, entrées perso).
# Aucun démon: il n'existe que le temps du menu (0 Mo au repos).
#
#   menu                  catégories à vide; en tapant, recherche floue sur tout
#   menu apps|clip|emoji|calc|windows|files|web|keys|toggles|history|system|audio|network|style|packages|capture|custom
#                         ouvre directement une section (raccourcis clavier)
#
# Entrées perso: ~/.config/menu/entries (Libellé | mode | commande).

WALLPAPERS="$HOME/.local/share/wallpapers"
EMOJIS="$HOME/.local/share/menu/emoji.txt"
ENTRIES="${XDG_CONFIG_HOME:-$HOME/.config}/menu/entries"
TAB="$(printf '\t')"
BACK=10 # code de retour: annulé (Échap), on remonte au niveau parent

# Glyphes Font Awesome 4 via Symbols Nerd Font Mono (largeur fixe: libellés alignés, 0 Mo en plus)
I_APPS="$(printf '\357\200\211')"  # U+F009 th-large
I_CLIP="$(printf '\357\203\252')"  # U+F0EA clipboard
I_EMOJI="$(printf '\357\204\230')"  # U+F118 smile
I_CALC="$(printf '\357\207\254')"  # U+F1EC calculator
I_SYS="$(printf '\357\200\221')"  # U+F011 power-off
I_AUDIO="$(printf '\357\200\250')"  # U+F028 volume-up
I_NET="$(printf '\357\207\253')"  # U+F1EB wifi
I_STYLE="$(printf '\357\207\274')"  # U+F1FC paint-brush
I_PKG="$(printf '\357\206\262')"  # U+F1B2 cube
I_CUSTOM="$(printf '\357\200\205')"  # U+F005 star
I_LOCK="$(printf '\357\200\243')"  # U+F023 lock
I_SLEEP="$(printf '\357\206\206')"  # U+F186 moon
I_LOGOUT="$(printf '\357\202\213')"  # U+F08B sign-out
I_REBOOT="$(printf '\357\200\236')"  # U+F01E repeat
I_VOLDN="$(printf '\357\200\247')"  # U+F027 volume-down
I_MUTE="$(printf '\357\200\246')"  # U+F026 volume-off
I_MIC="$(printf '\357\204\261')"  # U+F131 microphone-slash
I_PHONES="$(printf '\357\200\245')"  # U+F025 headphones
I_GLOBE="$(printf '\357\202\254')"  # U+F0AC globe
I_IMAGE="$(printf '\357\200\276')"  # U+F03E picture
I_RELOAD="$(printf '\357\200\241')"  # U+F021 refresh
I_SEARCH="$(printf '\357\200\202')"  # U+F002 search
I_TRASH="$(printf '\357\207\270')"  # U+F1F8 trash
I_DOWN="$(printf '\357\200\231')"  # U+F019 download
I_BROOM="$(printf '\357\204\255')"  # U+F12D eraser
I_TERM="$(printf '\357\204\240')"  # U+F120 terminal
I_CODE="$(printf '\357\204\241')"  # U+F121 code
I_CHART="$(printf '\357\202\200')"  # U+F080 bar-chart
I_COLS="$(printf '\357\203\233')"  # U+F0DB columns
I_CAM="$(printf '\357\200\260')"  # U+F030 camera
I_WIN="$(printf '\357\213\220')"  # U+F2D0 window-maximize

# Maj+Retour arrière = custom-1 de fuzzel (code de sortie 10): remonte d'un niveau.
# Échap = sortie vide, code 1: quitte tout le menu. Option passée ici seulement: dans le lanceur
# d'applications (fuzzel seul), custom-1 lancerait l'application sélectionnée.
STATE="${XDG_RUNTIME_DIR:-/tmp}/menu-back.$$"
KEYS="--override=key-bindings.custom-1=Shift+BackSpace"
BINDS="${XDG_RUNTIME_DIR:-/tmp}/menu-binds.$$"
BDREADY="${XDG_RUNTIME_DIR:-/tmp}/menu-backdrop.$$"
"$HOME/.local/bin/menu-backdrop" "$BDREADY" >/dev/null 2>&1 &
BACKDROP=$!
trap 'rm -f "$STATE" "$BINDS" "$BDREADY"; kill "$BACKDROP" 2>/dev/null' EXIT

pick() { # pick INVITE [LIGNES] [LARGEUR] [POLICE]  (entrées sur stdin, sélection sur stdout; vide si annulé)
    # Le voile flouté doit être affiché avant fuzzel (1 s au plus)
    n=0; while [ ! -e "$BDREADY" ] && [ "$n" -lt 50 ] && kill -0 "$BACKDROP" 2>/dev/null; do sleep 0.02; n=$((n + 1)); done
    out="$(fuzzel --dmenu $KEYS ${NOSORT:+--no-sort} --minimal-lines --lines "${2:-12}" ${3:+--width "$3"} ${4:+--font "$4"} --prompt "$1")"; rc=$?
    if [ "$rc" -eq 10 ]; then : > "$STATE"; return 0; fi
    [ -n "$out" ] && printf '%s\n' "$out"
    return 0
}
# Fonds d'écran pour fuzzel: une ligne par image, miniature en icône (protocole dmenu étendu
# de Rofi). Miniatures en cache (vipsthumbnail), régénérées si l'image est plus récente.
wallpaper_entries() {
    thumbs="${XDG_CACHE_HOME:-$HOME/.cache}/wallpaper-thumbs"
    mkdir -p "$thumbs"
    for f in "$WALLPAPERS"/*; do
        [ -f "$f" ] || continue
        n="${f##*/}"
        t="$thumbs/${n%.*}.png"
        if { [ ! -s "$t" ] || [ "$f" -nt "$t" ]; } && command -v vipsthumbnail >/dev/null; then
            vipsthumbnail "$f" --size 480x -o "$t" 2>/dev/null
        fi
        if [ -s "$t" ]; then printf '%s\0icon\037%s\n' "$n" "$t"; else printf '%s\n' "$n"; fi
    done
}
ask() { # saisie libre
    out="$(fuzzel --dmenu $KEYS --prompt-only "$1")"; rc=$?
    if [ "$rc" -eq 10 ]; then : > "$STATE"; return 0; fi
    [ -n "$out" ] && printf '%s\n' "$out"
    return 0
}
# Appelée quand une saisie est vide: Échap quitte tout, Maj+Retour arrière revient (code BACK)
cancel() {
    if [ -e "$STATE" ]; then rm -f "$STATE"; return "$BACK"; fi
    exit 0
}
notify() { command -v notify-send >/dev/null && notify-send -a menu "$@"; }
confirm() { # Oui -> 0 ; Non -> 1 ; annulé -> cancel (quitte ou revient) puis 1
    case "$(printf 'No
Yes
' | pick "$1 › " 2)" in
        Yes) return 0 ;;
        No) return 1 ;;
        *) cancel; return 1 ;;
    esac
}
term() { # term COMMANDE : terminal gardé ouvert à la fin
    exec foot -e sh -c "$1; echo; printf 'Press Enter to close '; read _"
}
trim_var() { # sans sous-processus: résultat dans $TRIMMED
    TRIMMED="${1#"${1%%[![:space:]]*}"}"
    TRIMMED="${TRIMMED%"${TRIMMED##*[![:space:]]}"}"
}
trim() { printf '%s' "$1" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//'; }

# ---------------------------------------------------------------- applications

# Sortie: Nom<TAB>Commande<TAB>Terminal (fichiers .desktop visibles, sans doublon de nom)
list_apps() {
    for d in /usr/share/applications "$HOME/.local/share/applications"; do
        [ -d "$d" ] && for f in "$d"/*.desktop; do [ -f "$f" ] && echo "$f"; done
    done | xargs awk '
        function flush() {
            if (name != "" && cmd != "" && type == "Application" && nodisplay != "true" && hidden != "true") {
                gsub(/%c/, name, cmd)
                gsub(/ ?%[fFuUdDnNikvm]/, "", cmd)
                print name "\t" cmd "\t" term "\t" icon
            }
            name = ""; cmd = ""; term = "false"; type = ""; nodisplay = ""; hidden = ""; icon = ""
        }
        FNR == 1 { flush(); ing = 0 }
        /^\[/ { ing = ($0 == "[Desktop Entry]"); next }
        !ing { next }
        {
            key = $0; sub(/=.*/, "", key)
            val = $0; sub(/^[^=]*=/, "", val)
            if (key == "Name" && name == "") name = val
            else if (key == "Exec" && cmd == "") cmd = val
            else if (key == "Icon" && icon == "") icon = val
            else if (key == "Terminal") term = val
            else if (key == "Type") type = val
            else if (key == "NoDisplay") nodisplay = val
            else if (key == "Hidden") hidden = val
        }
        END { flush() }
    ' | sort -t "$TAB" -k1,1 -u
}

# Classement des applications (fuzzel trie par longueur de correspondance, donc « Thunar Préférences »
# passait avant « Thunar »): les plus lancées d'abord, puis les applis principales avant les
# réglages/préférences, puis l'ordre alphabétique. Utilisé avec fuzzel --no-sort.
APPCOUNT="${XDG_STATE_HOME:-$HOME/.local/state}/menu-apps-count"
ranked_apps() {
    awk -F'\t' -v OFS='\t' -v cf="$APPCOUNT" '
        BEGIN { while ((getline l < cf) > 0) { n = split(l, a, "\t"); if (n == 2) c[a[2]] = a[1] } }
        { s = (tolower($1 " " $2) ~ /settings|preferences|préférences|prefs|configur|bulk|uninstall/) ? 1 : 0
          printf "%05d\t%d\t%s\t%s\t%s\t%s\t%s\n", 99999 - c[$1], s, $1, $1, $2, $3, $4 }' |
        sort -t "$TAB" -k1,2 -k3 | cut -f4-
}
count_app() { # count_app NOM
    mkdir -p "$(dirname "$APPCOUNT")"
    { cat "$APPCOUNT" 2>/dev/null; } | awk -F'\t' -v OFS='\t' -v n="$1" '
        $2 == n { $1++; f = 1 } { print } END { if (!f) print 1, n }' > "$APPCOUNT.tmp" && mv "$APPCOUNT.tmp" "$APPCOUNT"
}

run_app() { # run_app NOM : retourne 1 si aucune application de ce nom
    line="$(list_apps | awk -F'\t' -v n="$1" '$1 == n { print; exit }')"
    [ -n "$line" ] || return 1
    count_app "$1"
    cmd="$(printf '%s' "$line" | cut -f2)"
    istty="$(printf '%s' "$line" | cut -f3)"
    if [ "$istty" = "true" ]; then
        exec foot -e sh -c "$cmd"
    else
        setsid sh -c "$cmd" >/dev/null 2>&1 &
        exit 0
    fi
}

# ---------------------------------------------------------------- entrées perso

custom_labels() { # libellés valides du fichier d'entrées
    [ -f "$ENTRIES" ] || return 0
    while IFS='|' read -r label mode cmd; do
        trim_var "$label"; label="$TRIMMED"
        case "$label" in ''|'#'*) continue ;; esac
        trim_var "$mode"; mode="$TRIMMED"
        trim_var "$cmd"; cmd="$TRIMMED"
        [ -n "$mode" ] && [ -n "$cmd" ] && printf '%s\n' "$label"
    done < "$ENTRIES"
}

custom_run() { # custom_run LIBELLÉ : retourne 1 si le libellé n'existe pas
    [ -f "$ENTRIES" ] || return 1
    while IFS='|' read -r label mode cmd; do
        label="$(trim "$label")"
        case "$label" in ''|'#'*) continue ;; esac
        [ "$label" = "$1" ] || continue
        mode="$(trim "$mode")"
        cmd="$(trim "$cmd")"
        case "$mode" in
            term) exec foot -e sh -c "$cmd" ;;
            hold) term "$cmd" ;;
            run) setsid sh -c "$cmd" >/dev/null 2>&1 & exit 0 ;;
            *) notify -u critical "Menu" "Unknown mode '$mode' for $label"; exit 1 ;;
        esac
    done < "$ENTRIES"
    return 1
}

menu_custom() {
    arg="$1"
    while :; do
        act="${arg:-$(printf 'Add an entry\nEdit file\n' | pick "Custom entries › " 2)}"
        [ -n "$act" ] || { cancel; return $BACK; }
        case "$act" in
            "Add an entry")
                label="$(ask "Label › ")"
                if [ -z "$label" ]; then cancel
                else
                    case "$label" in *'|'*|'#'*) notify -u critical "Menu" "Invalid label (no | and no leading #)"; return 1 ;; esac
                    mode="$(printf 'term  (terminal, closed at the end)\nhold  (terminal kept open)\nrun   (background, GUI app)\n' | pick "Mode › " 3)"
                    mode="${mode%% *}"
                    if [ -z "$mode" ]; then cancel
                    else
                        cmd="$(ask "Command › ")"
                        if [ -z "$cmd" ]; then cancel
                        else
                            mkdir -p "$(dirname "$ENTRIES")"
                            printf '%s | %s | %s\n' "$label" "$mode" "$cmd" >> "$ENTRIES"
                            notify "Menu" "Entry added: $label"
                            return 0
                        fi
                    fi
                fi
                ;;
            "Edit file") exec foot -e nvim "$ENTRIES" ;;
        esac
        [ -n "$arg" ] && return $BACK # annulé depuis la liste unique
    done
}

# ---------------------------------------------------------------- sections
# Navigation clavier: Maj+Retour arrière remonte d'un niveau, Échap quitte tout le menu.
# Chaque section est une boucle: annuler une sous-étape revient au menu de la section.
# Une action terminée ferme le menu. Avec un argument (liste unique), l'action est directe.

menu_apps() {
    sel="$(list_apps | ranked_apps | awk -F'\t' '{ printf "%s", $1; if ($4 != "") printf "\0icon\037%s", $4; print "" }' | NOSORT=1 pick "Applications › " 10)"
    [ -n "$sel" ] || { cancel; return $BACK; }
    run_app "$sel"
}

menu_clip() {
    command -v cliphist >/dev/null || { notify "Clipboard" "cliphist is not installed"; return 1; }
    sel="$(cliphist list | pick "Clipboard › " 15)"
    [ -n "$sel" ] || { cancel; return $BACK; }
    printf '%s' "$sel" | cliphist decode | wl-copy
}

menu_emoji() {
    sel="$(pick "Emoji › " 12 < "$EMOJIS")"
    [ -n "$sel" ] || { cancel; return $BACK; }
    char="${sel%% *}"
    printf '%s' "$char" | wl-copy
    notify "Emoji copied" "$char"
}

menu_calc() {
    command -v qalc >/dev/null || { notify "Calculator" "qalculate is not installed"; return 1; }
    while :; do
        expr="$(ask "= ")"
        [ -n "$expr" ] || { cancel; return $BACK; }
        res="$(qalc -t "$expr" 2>&1)"
        sel="$(printf '%s\nNew calculation\n' "$res" | pick "$expr = " 3)"
        case "$sel" in
            "") cancel; return $BACK ;;
            "New calculation") continue ;;
            *) printf '%s' "$res" | wl-copy; return 0 ;;
        esac
    done
}

# Volumes amovibles: choisir pour monter (udisksctl, sans root) ou démonter
menu_usb() {
    list="$(lsblk -rpno NAME,TYPE,HOTPLUG | awk '$2=="part" && $3==1 {print $1}' | while read -r dev; do
        printf '%s  %s  %s%s\n' "$dev" "$(lsblk -dno LABEL "$dev")" "$(lsblk -dno SIZE "$dev")" \
            "$(lsblk -dno MOUNTPOINT "$dev" | sed 's/^./  (monté: &)/')"
    done)"
    [ -n "$list" ] || { notify-send -u low "USB" "Aucun volume amovible"; return 0; }
    sel="$(printf '%s\n' "$list" | pick "USB drives › " 6)"
    [ -n "$sel" ] || { cancel; return $BACK; }
    dev="${sel%% *}"
    if [ -n "$(lsblk -dno MOUNTPOINT "$dev")" ]; then
        out="$(udisksctl unmount -b "$dev" 2>&1)" && notify-send -u low "USB" "Démonté: $dev" || notify-send -u normal "USB" "$out"
    else
        out="$(udisksctl mount -b "$dev" 2>&1)" && notify-send -u low "USB" "$out" || notify-send -u normal "USB" "$out"
    fi
    return 0
}

menu_system() {
    arg="$1"
    while :; do
        act="${arg:-$(printf 'Lock\nSleep\nUSB drives\nLog out\nReboot\nPower off\n' | pick "System › " 6)}"
        [ -n "$act" ] || { cancel; return $BACK; }
        case "$act" in
            Lock) exec "$HOME/.local/bin/lock" ;;
            "USB drives") menu_usb; rc=$?; [ "$rc" = "$BACK" ] || return $rc ;;
            Sleep) sudo -n zzz; return 0 ;;
            "Log out") confirm "Log out" && exec niri msg action quit --skip-confirmation ;;
            Reboot) confirm "Reboot" && { sudo -n reboot; return 0; } ;;
            "Power off") confirm "Power off" && { sudo -n poweroff; return 0; } ;;
        esac
        [ -n "$arg" ] && return $BACK
    done
}

menu_audio() {
    arg="$1"
    while :; do
        act="${arg:-$(printf 'Volume +\nVolume -\nMute / unmute\nMic mute / unmute\nChoose output\n' | pick "Audio › " 5)}"
        [ -n "$act" ] || { cancel; return $BACK; }
        case "$act" in
            "Volume +") wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+; return 0 ;;
            "Volume -") wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-; return 0 ;;
            "Mute / unmute") wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle; return 0 ;;
            "Mic mute / unmute") wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle; return 0 ;;
            "Choose output")
                sinks="$(wpctl status | awk '/Sinks:/{f=1;next} /Sources:|Filters:|Streams:/{f=0} f' \
                    | sed -E -n 's/^[^0-9]*([0-9]+)\. (.*)$/\1 \2/p')"
                sel="$(printf '%s\n' "$sinks" | pick "Audio output › " 8)"
                if [ -n "$sel" ]; then wpctl set-default "${sel%% *}"; return 0; fi
                cancel
                ;;
        esac
        [ -n "$arg" ] && return $BACK
    done
}

menu_network() {
    arg="$1"
    while :; do
        act="${arg:-$(printf 'Wi-Fi (impala)\nVPN (Proton)\nIP addresses\nTest connection\nPacket loss\nSpeed test\n' | pick "Network › " 6)}"
        [ -n "$act" ] || { cancel; return $BACK; }
        case "$act" in
            "IP addresses")
                sel="$(ip -br addr | grep -v '^lo' | pick "Addresses › " 8)"
                if [ -n "$sel" ]; then printf '%s' "$sel" | awk '{print $3}' | wl-copy; return 0; fi
                cancel
                ;;
            "Wi-Fi (impala)") exec "$HOME/.local/bin/bar-tui" impala ;;
            "VPN (Proton)") exec "$HOME/.local/bin/bar-tui" vpn ;;
            "Packet loss")
                notify "Network" "Ping running (10 packets)..."
                notify "Network" "$(ping -c10 -i0.3 -W2 1.1.1.1 2>&1 | tail -2 | tr '\n' ' ')"
                return 0
                ;;
            "Speed test")
                notify "Network" "Speed test (25 MB, Cloudflare)..."
                bps="$(curl -fsS -m 60 -o /dev/null -w '%{speed_download}' 'https://speed.cloudflare.com/__down?bytes=25000000' 2>/dev/null)" \
                    && notify "Network" "Download: $(awk -v b="$bps" 'BEGIN{printf "%.0f Mbit/s", b*8/1e6}')" \
                    || notify -u critical "Network" "Speed test failed"
                return 0
                ;;
            "Test connection") "$HOME/.local/bin/captive-portal"; return 0 ;;
        esac
        [ -n "$arg" ] && return $BACK
    done
}

menu_style() {
    arg="$1"
    while :; do
        act="${arg:-$(printf 'Wallpaper\nReload Waybar\nReload mako\n' | pick "Style › " 3)}"
        [ -n "$act" ] || { cancel; return $BACK; }
        case "$act" in
            "Wallpaper")
                sel="$(wallpaper_entries | pick "Wallpaper › " 10)"
                if [ -n "$sel" ]; then
                    setsid "$HOME/.local/bin/wallpaper" "$WALLPAPERS/$sel" >/dev/null 2>&1 &
                    return 0
                fi
                cancel
                ;;
            "Reload Waybar") pkill -USR2 waybar; return 0 ;;
            "Reload mako") makoctl reload; return 0 ;;
        esac
        [ -n "$arg" ] && return $BACK
    done
}

menu_capture() {
    arg="$1"
    act="${arg:-$(printf 'Region\nScreen\nWindow\nColor (picker)\nScreen recording\n' | pick "Capture › " 5)}"
    [ -n "$act" ] || { cancel; return $BACK; }
    # Le voile ne se ferme seul que 1,2 s après fuzzel: niri figerait l'écran flouté pour la capture
    kill "$BACKDROP" 2>/dev/null
    sleep 0.4 # laisse fuzzel et le voile disparaître avant de capturer
    case "$act" in
        Region) niri msg action screenshot ;;
        Screen) niri msg action screenshot-screen ;;
        Window) niri msg action screenshot-window ;;
        "Color (picker)")
            c="$(niri msg pick-color 2>/dev/null | grep -io '#[0-9a-f]\{6\}' | head -n1)"
            [ -n "$c" ] && { printf '%s' "$c" | wl-copy; notify "Color copied" "$c"; } ;;
        "Screen recording") exec "$HOME/.local/bin/bar-toggle" rec ;;
    esac
}

menu_windows() {
    # Liste des fenêtres ouvertes (niri), sélection = focus
    sel="$(niri msg -j windows | python3 -I -c '
import json,sys
for w in json.load(sys.stdin):
    print("%d\t%s  ·  %s" % (w["id"], w.get("app_id") or "?", w.get("title") or ""))
' | cut -f2- | pick "Window › " 10)"
    [ -n "$sel" ] || { cancel; return $BACK; }
    id="$(niri msg -j windows | python3 -I -c '
import json,sys
t=sys.argv[1]
for w in json.load(sys.stdin):
    if "%s  ·  %s" % (w.get("app_id") or "?", w.get("title") or "") == t:
        print(w["id"]); break
' "$sel")"
    [ -n "$id" ] && niri msg action focus-window --id "$id"
}

menu_files() {
    # Recherche de fichiers (fd) dans ~, ouverture avec l'application par défaut
    q="$(ask "File › ")"
    [ -n "$q" ] || { cancel; return $BACK; }
    sel="$(fd --type f --hidden --exclude .git --exclude node_modules --exclude .cache "$q" "$HOME" 2>/dev/null | head -200 | sed "s|^$HOME/|~/|" | pick "Files › " 12)"
    [ -n "$sel" ] || { cancel; return $BACK; }
    setsid xdg-open "$HOME/${sel#\~/}" >/dev/null 2>&1 &
}

menu_web() {
    # Préfixes: g (Google), ddg, yt, w (Wikipédia fr), gh (GitHub), ou toute URL
    q="$(ask "Web (g/ddg/yt/w/gh …) › ")"
    [ -n "$q" ] || { cancel; return $BACK; }
    enc() { printf '%s' "$1" | python3 -I -c 'import sys,urllib.parse;print(urllib.parse.quote_plus(sys.stdin.read()))'; }
    case "$q" in
        g\ *) url="https://www.google.com/search?q=$(enc "${q#g }")" ;;
        ddg\ *) url="https://duckduckgo.com/?q=$(enc "${q#ddg }")" ;;
        yt\ *) url="https://www.youtube.com/results?search_query=$(enc "${q#yt }")" ;;
        w\ *) url="https://en.wikipedia.org/w/index.php?search=$(enc "${q#w }")" ;;
        gh\ *) url="https://github.com/search?q=$(enc "${q#gh }")" ;;
        http://*|https://*) url="$q" ;;
        *.*) url="https://$q" ;;
        *) url="https://duckduckgo.com/?q=$(enc "$q")" ;;
    esac
    setsid xdg-open "$url" >/dev/null 2>&1 &
}

menu_keys() {
    # Raccourcis niri extraits de la config, recherche floue; Entrée copie la touche
    cfg="${XDG_CONFIG_HOME:-$HOME/.config}/niri/config.kdl"
    sel="$(awk '
        /^binds[[:space:]]*\{/ {b=1; next}
        b && /^\}/ {b=0}
        b && /^[[:space:]]*[A-Za-z0-9_+]+[[:space:]]/ && !/^[[:space:]]*\/\// {
            key=$1; t=""
            if (match($0, /hotkey-overlay-title="[^"]*"/)) t=substr($0, RSTART+22, RLENGTH-23)
            else {
                a=$0; sub(/^[^{]*\{[[:space:]]*/, "", a); sub(/[[:space:];]*\}.*$/, "", a)
                gsub(/"/, "", a); sub(/^spawn-sh /, "", a); sub(/^spawn /, "", a); gsub(/-/, " ", a)
                t=a
            }
            printf "%s  —  %s\n", key, t
        }' "$cfg" | pick "Shortcuts › " 14 70)"
    [ -n "$sel" ] || { cancel; return $BACK; }
    printf '%s' "${sel%% *}" | wl-copy
}

menu_toggles() {
    arg="$1"
    while :; do
        act="${arg:-$(printf 'Auto lock\nAirplane mode\nPresentation mode\nNight light\nDo not disturb\nMute 1 hour\nNotification history\nNext wallpaper\n' | pick "Toggles › " 8)}"
        [ -n "$act" ] || { cancel; return $BACK; }
        case "$act" in
            "Auto lock") "$HOME/.local/bin/bar-toggle" idle; return 0 ;;
            "Airplane mode") "$HOME/.local/bin/bar-toggle" air; return 0 ;;
            "Presentation mode") "$HOME/.local/bin/bar-toggle" present; return 0 ;;
            "Night light") "$HOME/.local/bin/bar-toggle" night; return 0 ;;
            "Do not disturb") makoctl mode -t do-not-disturb; pkill -RTMIN+9 waybar; return 0 ;;
            "Mute 1 hour")
                makoctl mode -a do-not-disturb; pkill -RTMIN+9 waybar
                setsid -f sh -c 'sleep 3600; makoctl mode -r do-not-disturb; pkill -RTMIN+9 waybar' >/dev/null 2>&1
                notify "Notifications" "Coupées pendant 1 h"
                return 0 ;;
            "Notification history")
                hist="$(makoctl history -j)"
                fmt='def line: "\(.app_name) · \(.summary)\(if .body then " — " + (.body | gsub("\\s+"; " ") | .[0:120]) else "" end)";'
                sel="$(printf '%s' "$hist" | jq -j "$fmt"'.[] | line, "\u0000icon\u001f", ((.app_icon // (.app_name | ascii_downcase | gsub(" "; "-"))) | sub("^file://"; "") | gsub("%20"; " ")), "\n"' | NOSORT=1 pick "History › " 10 100)"
                if [ -n "$sel" ]; then
                    printf '%s' "$hist" | jq -r --arg l "$sel" "$fmt"'first(.[] | select(line == $l)) | .summary + (if .body then "\n" + .body else "" end)' | wl-copy
                    return 0
                fi
                cancel
                ;;
            "Next wallpaper")
                cur="$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper" 2>/dev/null)"
                next="$(ls "$WALLPAPERS" | awk -v c="$(basename "$cur")" 'NR==1{f=$0} hit{print; done=1; exit} $0==c{hit=1} END{if(!done)print f}')"
                setsid "$HOME/.local/bin/wallpaper" "$WALLPAPERS/$next" >/dev/null 2>&1 &
                return 0 ;;
        esac
        [ -n "$arg" ] && return $BACK
    done
}

menu_packages() {
    arg="$1"
    while :; do
        act="${arg:-$(printf 'Search and install\nUninstall an app\nRemove\nUpdate system\nClean cache\n' | pick "Packages › " 4)}"
        [ -n "$act" ] || { cancel; return $BACK; }
        case "$act" in
            "Search and install")
                q="$(ask "Package › ")"
                if [ -z "$q" ]; then cancel
                else
                    sel="$(xbps-query -Rs "$q" | head -60 | sed -E 's/^\[.\] //' | pick "Results › " 15)"
                    if [ -z "$sel" ]; then cancel
                    else
                        pkg="$(printf '%s' "$sel" | awk '{print $1}' | sed -E 's/-[^-]+$//')"
                        term "echo 'Resource budget: check size and dependencies before installing.'; xbps-query -R -p pkgver,installed_size $pkg; echo; sudo xbps-install -S $pkg"
                    fi
                fi
                ;;
            "Uninstall an app")
                # Applis visibles (natives et web): Nom<TAB>fichier .desktop
                apps="$(for f in /usr/share/applications/*.desktop "$HOME"/.local/share/applications/*.desktop; do
                    [ -f "$f" ] || continue
                    awk -v f="$f" -F= '/^\[/ && NR>1 {exit} $1=="Name" && n=="" {n=$2} $1=="NoDisplay" && $2=="true" {h=1} $1=="Type" {t=$2} END {if (n!="" && !h && t=="Application") print n "\t" f}' "$f"
                done | sort -f)"
                sel="$(printf '%s\n' "$apps" | cut -f1 | pick "Uninstall › " 15)"
                if [ -z "$sel" ]; then cancel
                else
                    file="$(printf '%s\n' "$apps" | awk -F'\t' -v n="$sel" '$1==n {print $2; exit}')"
                    confirm "Uninstall $sel" && term "app-uninstall '$file'"
                fi
                ;;
            Remove)
                sel="$(xbps-query -m | sed -E 's/-[^-]+$//' | pick "Remove › " 15)"
                if [ -z "$sel" ]; then cancel
                elif confirm "Remove $sel"; then term "sudo xbps-remove -R $sel"
                fi
                ;;
            "Update system") term "sudo xbps-install -Su" ;;
            "Clean cache") term "sudo xbps-remove -yO; df -h /" ;;
        esac
        [ -n "$arg" ] && return $BACK
    done
}

# ---------------------------------------------------------------- liste unique

# Actions directes, libellé "Catégorie: Action" (la catégorie sert aussi à la recherche)
actions_list() {
    cat <<EOF
$I_LOCK System: Lock
$I_SLEEP System: Sleep
$I_LOGOUT System: Log out
$I_REBOOT System: Reboot
$I_SYS System: Power off
$I_AUDIO Audio: Volume +
$I_VOLDN Audio: Volume -
$I_MUTE Audio: Mute / unmute
$I_MIC Audio: Mic mute / unmute
$I_PHONES Audio: Choose output
$I_GLOBE Network: IP addresses
$I_NET Network: Test connection
$I_IMAGE Style: Wallpaper
$I_RELOAD Style: Reload Waybar
$I_RELOAD Style: Reload mako
$I_CAM Capture: Region
$I_CAM Capture: Screen
$I_CAM Capture: Window
$I_WIN Windows: Go to a window
$I_SEARCH Files: Find a file
$I_GLOBE Web: Search or open a URL
$I_CODE Shortcuts: Shortcuts help
$I_LOCK Toggles: Auto lock
$I_NET Toggles: Airplane mode
$I_CHART Toggles: Presentation mode
$I_SLEEP Toggles: Night light
$I_MUTE Toggles: Do not disturb
$I_MUTE Toggles: Mute 1 hour
$I_MUTE Toggles: Notification history
$I_IMAGE Toggles: Next wallpaper
$I_CAM Capture: Color (picker)
$I_SEARCH Packages: Search and install
$I_TRASH Packages: Uninstall an app
$I_TRASH Packages: Remove
$I_DOWN Packages: Update system
$I_BROOM Packages: Clean cache
EOF
}

# Catégories: affichées en premier. Sans saisie, la liste est limitée à leur nombre de lignes
# (on ne voit qu'elles); dès qu'on tape, la recherche floue porte sur TOUTE la liste.
categories_list() {
    cat <<EOF
$I_APPS Applications ›
$I_CLIP Clipboard ›
$I_EMOJI Emoji ›
$I_CALC Calculator ›
$I_WIN Windows ›
$I_SEARCH Files ›
$I_GLOBE Web ›
$I_CODE Shortcuts ›
$I_LOCK Toggles ›
$I_SYS System ›
$I_AUDIO Audio ›
$I_NET Network ›
$I_STYLE Style ›
$I_PKG Packages ›
$I_CUSTOM Custom entries ›
EOF
}

# ---------------------------------------------------------------- raccourcis affichés à côté des noms

# Table "touche<TAB>action" extraite des binds de niri (guillemets et spawn retirés)
bind_table() {
    awk '
        /^binds[[:space:]]*\{/ {b=1; next}
        b && /^\}/ {b=0}
        b && /^[[:space:]]*[A-Za-z0-9_+]+[[:space:]]/ && !/^[[:space:]]*\/\// {
            a=$0; sub(/^[^{]*\{[[:space:]]*/, "", a); sub(/[[:space:];]*\}.*$/, "", a)
            gsub(/"/, "", a); sub(/^spawn-sh /, "", a); sub(/^spawn /, "", a)
            printf "%s\t%s\n", $1, a
        }' "${XDG_CONFIG_HOME:-$HOME/.config}/niri/config.kdl" > "$BINDS" 2>/dev/null
}

# hint TEXTE : première touche dont l'action est TEXTE (ou contient TEXTE si préfixé par ~)
hint() {
    awk -F'\t' -v n="$1" '
        BEGIN { sub_ = (substr(n,1,1) == "~"); if (sub_) n = substr(n,2) }
        (sub_ ? index($2, n) : $2 == n) { print $1; exit }' "$BINDS"
}
# Noms de touches lisibles (rangée de chiffres bépo, touches multimédia)
pretty_key() {
    printf '%s' "$1" | sed -E 's/\+quotedbl$/+1/; s/\+guillemotleft$/+2/; s/\+guillemotright$/+3/; s/\+parenleft$/+4/; s/\+parenright$/+5/; s/\+at$/+6/; s/\+plus$/+7/; s/\+minus$/+8/; s/\+slash$/+9/; s/\+Comma$/+,/; s/\+Period$/+./; s/^XF86AudioRaiseVolume$/Vol +/; s/^XF86AudioLowerVolume$/Vol -/; s/^XF86AudioMute$/Mute/; s/^XF86AudioMicMute$/Mic mute/'
}
fmt_hint() { h="$(hint "$1")"; [ -n "$h" ] && printf '  ‹%s›' "$(pretty_key "$h")"; return 0; }

# Action de niri ou commande correspondant à un libellé du menu
action_needle() { # résultat dans $NEEDLE (vide si aucune touche)
    NEEDLE=""
    case "$1" in
        "Applications ›") NEEDLE="~fuzzel" ;;
        "Windows ›"|"Windows: "*) NEEDLE="~menu windows" ;;
        "Shortcuts ›"|"Shortcuts: "*) NEEDLE="~menu keys" ;;
        "System: Lock") NEEDLE="~swaylock" ;;
        "System: Log out") NEEDLE="quit" ;;
        "Audio: Volume +") NEEDLE="~0.1+" ;;
        "Audio: Volume -") NEEDLE="~0.1-" ;;
        "Audio: Mute / unmute") NEEDLE="~SINK@ toggle" ;;
        "Audio: Mic mute / unmute") NEEDLE="~SOURCE@ toggle" ;;
        "Toggles: Do not disturb") NEEDLE="~do-not-disturb" ;;
        "Capture: Region") NEEDLE="screenshot" ;;
        "Capture: Screen") NEEDLE="screenshot-screen" ;;
        "Capture: Window") NEEDLE="screenshot-window" ;;
    esac
}

# Mise en page du menu principal (police à chasse fixe): glyphe + 2 espaces, touche alignée à droite.
# Largeur en caractères = largeur fuzzel (36) moins les marges.
MENU_FONT="DejaVu Sans Mono:size=12,Symbols Nerd Font Mono:size=12"
MENU_COLS=33
align_hints() {
    awk -v w="$MENU_COLS" '{
        key = ""; line = $0
        if (match(line, /  ‹[^‹›]*›$/)) { key = substr(line, RSTART + 3, RLENGTH - 4); line = substr(line, 1, RSTART - 1) }
        sub(/ /, "  ", line)
        if (key != "") { pad = w - length(line) - length(key) - 2; if (pad < 2) pad = 2; line = sprintf("%s%*s‹%s›", line, pad, "", key) }
        print line
    }'
}

# Entrée "LIGNE<TAB>AIGUILLE" -> "LIGNE  ‹touche›" (un seul awk pour tout le menu; table dans $BINDS).
# AIGUILLE: action exacte, ou sous-chaîne si préfixée par ~ (cf. hint/pretty_key ci-dessus).
add_hints() {
    awk -F'\t' -v binds="$BINDS" '
        function pretty(k) {
            sub(/\+quotedbl$/, "+1", k); sub(/\+guillemotleft$/, "+2", k); sub(/\+guillemotright$/, "+3", k)
            sub(/\+parenleft$/, "+4", k); sub(/\+parenright$/, "+5", k); sub(/\+at$/, "+6", k)
            sub(/\+plus$/, "+7", k); sub(/\+minus$/, "+8", k); sub(/\+slash$/, "+9", k)
            sub(/\+Comma$/, "+,", k); sub(/\+Period$/, "+.", k)
            if (k == "XF86AudioRaiseVolume") return "Vol +"
            if (k == "XF86AudioLowerVolume") return "Vol -"
            if (k == "XF86AudioMute") return "Mute"
            if (k == "XF86AudioMicMute") return "Mic mute"
            return k
        }
        BEGIN { while ((getline l < binds) > 0) { split(l, f, "\t"); n++; key[n] = f[1]; act[n] = f[2] } }
        {
            line = $1; nd = $2; h = ""
            if (nd != "") {
                sub_ = (substr(nd, 1, 1) == "~"); if (sub_) nd = substr(nd, 2)
                for (i = 1; i <= n; i++) if (sub_ ? index(act[i], nd) : act[i] == nd) { h = key[i]; break }
            }
            if (h != "") line = line "  ‹" pretty(h) "›"
            print line
        }'
}

# Ajoute "  ‹touche›" aux lignes "GLYPHE Libellé" quand une touche existe
with_hints() {
    while IFS= read -r line; do
        action_needle "${line#* }"
        printf '%s\t%s\n' "$line" "$NEEDLE"
    done | add_hints
}

# "Nom<TAB>commande" -> "GLYPHE Nom<TAB>commande", glyphe choisi selon le nom ou la commande
glyph_apps() {
    awk -F'\t' -v globe="$I_GLOBE" -v term="$I_TERM" -v code="$I_CODE" -v chart="$I_CHART" -v cols="$I_COLS" -v win="$I_WIN" '{
        t = tolower($1 " " $2)
        if (t ~ /chrom|firefox|browser|navigat|brave|epiphany/) g = globe
        else if (t ~ /alacritty|terminal|kitty|foot|konsole/) g = term
        else if (t ~ /nvim|vim|emacs|code|editor|éditeur/) g = code
        else if (t ~ /htop|btop|monitor|moniteur|top /) g = chart
        else if (t ~ /zellij|tmux/) g = cols
        else g = win
        print g " " $1 "\t" $2
    }'
}

menu_main() {
    bind_table
    cats="$(categories_list | with_hints)"
    nb="$(printf '%s\n' "$cats" | wc -l | tr -d ' ')"
    customs="$(custom_labels | while IFS= read -r l; do printf '%s %s\n' "$I_CUSTOM" "$l"; done)"
    apps="$(list_apps | ranked_apps | cut -f1,2 | glyph_apps | add_hints)"
    items="$( { printf '%s\n' "$cats"; [ -n "$customs" ] && printf '%s\n' "$customs"; [ -n "$apps" ] && printf '%s\n' "$apps"; actions_list | with_hints; } )"

    while :; do # Échap dans une section revient ici; Échap ici quitte
        sel="$(printf '%s\n' "$items" | align_hints | NOSORT=1 pick "› " "$nb" "" "$MENU_FONT")"
        [ -n "$sel" ] || exit 0
        sel="${sel#* }" # retire le glyphe et le 1er espace
        sel="${sel# }"  # ... et le 2e
        sel="$(printf '%s' "$sel" | sed 's/ *‹[^‹›]*›$//')" # retire la touche affichée

        rc=0
        case "$sel" in
            "Applications ›") menu_apps; rc=$? ;;
            "Clipboard ›") menu_clip; rc=$? ;;
            "Emoji ›") menu_emoji; rc=$? ;;
            "Calculator ›") menu_calc; rc=$? ;;
            "Windows ›") menu_windows; rc=$? ;;
            "Files ›") menu_files; rc=$? ;;
            "Web ›") menu_web; rc=$? ;;
            "Shortcuts ›") menu_keys; rc=$? ;;
            "Toggles ›") menu_toggles; rc=$? ;;
            "System ›") menu_system; rc=$? ;;
            "Audio ›") menu_audio; rc=$? ;;
            "Network ›") menu_network; rc=$? ;;
            "Style ›") menu_style; rc=$? ;;
            "Packages ›") menu_packages; rc=$? ;;
            "Custom entries ›") menu_custom; rc=$? ;;
            *)
                custom_run "$sel" # exec/exit si trouvé
                run_app "$sel"
                case "$sel" in
                    "Windows: "*) menu_windows; rc=$? ;;
                    "Files: "*) menu_files; rc=$? ;;
                    "Web: "*) menu_web; rc=$? ;;
                    "Shortcuts: "*) menu_keys; rc=$? ;;
                    "Toggles: "*) menu_toggles "${sel#Toggles: }"; rc=$? ;;
                    "System: "*) menu_system "${sel#System: }"; rc=$? ;;
                    "Audio: "*) menu_audio "${sel#Audio: }"; rc=$? ;;
                    "Network: "*) menu_network "${sel#Network: }"; rc=$? ;;
                    "Style: "*) menu_style "${sel#Style: }"; rc=$? ;;
                    "Packages: "*) menu_packages "${sel#Packages: }"; rc=$? ;;
                    "Capture: "*) menu_capture "${sel#Capture: }"; rc=$? ;;
                esac
                ;;
        esac
        [ "$rc" -eq "$BACK" ] || exit "$rc"
    done
}

case "${1:-}" in
    apps) menu_apps ;;
    clip) menu_clip ;;
    emoji) menu_emoji ;;
    calc) menu_calc ;;
    windows) menu_windows ;;
    files) menu_files ;;
    web) menu_web ;;
    keys) menu_keys ;;
    toggles) menu_toggles ;;
    history) menu_toggles "Notification history" ;;
    system) menu_system ;;
    audio) menu_audio ;;
    network) menu_network ;;
    style) menu_style ;;
    packages) menu_packages ;;
    capture) menu_capture ;;
    custom) menu_custom ;;
    "") menu_main ;;
    *) echo "Usage: menu [apps|clip|emoji|calc|windows|files|web|keys|toggles|history|system|audio|network|style|packages|capture|custom]" >&2; exit 1 ;;
esac
rc=$?
[ "$rc" -eq "$BACK" ] && exit 0 # section lancée directement et annulée: sortie propre
exit "$rc"
