#!/bin/sh
# Indicateurs Waybar (JSON): mic | dnd | night | rec | idle | remote | air | vpn | batwatch. Rafraîchis par signal (clic, ou bar-stats watch quand l'état change) ou par intervalle.
# CPU, mémoire et température: bar-stats (apps/bar-stats, Rust, résident).
case "$1" in
    mic)
        v="$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null)" || { printf '{"text":""}\n'; exit 0; }
        case "$v" in
            *MUTED*) printf '{"text":"\\uf131","class":"muted","tooltip":"Micro coupé"}\n' ;;
            *) printf '{"text":"\\uf130","tooltip":"Micro actif: %s"}\n' "$(echo "$v" | awk '{printf "%d%%", $2*100}')" ;;
        esac ;;
    dnd)
        if makoctl mode 2>/dev/null | grep -q do-not-disturb; then
            printf '{"text":"\\uf1f6","class":"active","tooltip":"Ne pas déranger (clic: historique, clic droit: réactiver)"}\n'
        else
            printf '{"text":"\\uf0f3","class":"idle","tooltip":"Notifications actives (clic: historique, clic droit: les couper)"}\n'
        fi ;;
    night)
        # Active seulement si l'écran est réellement réchauffé (forcé, ou auto en soirée); auto en journée = au repos.
        if pgrep -x wlsunset >/dev/null; then
            # Dernière température appliquée, d'après la sortie de wlsunset (bar-toggle night)
            if pgrep -f 'wlsunset .* -T 4501$' >/dev/null; then k=4500
            else k=$(awk '/^setting temperature to/ { k = $4 } END { print k }' "${XDG_RUNTIME_DIR:-/tmp}/wlsunset.log" 2>/dev/null); fi
            if [ "${k:-6500}" -lt 6400 ]; then
                printf '{"text":"\\uf186","class":"active","tooltip":"Veilleuse %s K (clic: couper)"}\n' "$k"
            else
                printf '{"text":"\\uf186","class":"idle","tooltip":"Veilleuse automatique, allumée au coucher du soleil (clic: couper)"}\n'
            fi
        else
            printf '{"text":"\\uf186","class":"idle","tooltip":"Veilleuse coupée (clic: forcer 4500 K)"}\n'
        fi ;;
    rec)
        if pgrep -x wf-recorder >/dev/null; then
            printf '{"text":"\\uf111","class":"active","tooltip":"Enregistrement en cours (clic: arrêter)"}\n'
        else
            printf '{"text":""}\n'
        fi ;;
    idle)
        # Caféine (comme "Stay Awake" d'Omarchy): tasse jaune = écran jamais verrouillé ni éteint
        if pgrep -x swayidle >/dev/null; then
            printf '{"text":"\\uf0f4","class":"idle","tooltip":"Verrouillage auto actif (clic: garder éveillé)"}\n'
        else
            printf '{"text":"\\uf0f4","class":"active","tooltip":"Gardé éveillé: pas de verrouillage auto (clic: réactiver)"}\n'
        fi ;;
    remote)
        # Session SSH entrante (comme RemoteSession d'Omarchy); rien sinon
        n="$(ss -Htn state established '( sport = :22 )' 2>/dev/null | wc -l)"
        if [ "$n" -gt 0 ]; then
            printf '{"text":"\\uf233","class":"active","tooltip":"%s session(s) SSH entrante(s)"}\n' "$n"
        else
            printf '{"text":""}\n'
        fi ;;
    air)
        if rfkill list 2>/dev/null | grep -q 'Soft blocked: yes'; then
            printf '{"text":"\\uf072","class":"active","tooltip":"Mode avion (clic: désactiver)"}\n'
        else
            printf '{"text":""}\n'
        fi ;;
    vpn)
        i="$(ip -o link show up 2>/dev/null | awk -F': ' '$2 ~ /^(tun|tap|wg|tailscale|proton|nordlynx)/ {print $2; exit}')"
        if [ -n "$i" ]; then
            printf '{"text":"\\uf023 VPN","class":"active","tooltip":"VPN actif: %s"}\n' "$i"
        else
            printf '{"text":""}\n'
        fi ;;
    batwatch)
        # Lancé par bar-stats watch (sous 10 % sur batterie, puis au retour du chargeur), sortie ignorée.
        # Alerte batterie faible (<=10 %) puis arrêt propre (<=1 %) après 1 min sauf si le chargeur est branché,
        # une seule fois par décharge; aucun affichage. Pas de veille: en S3 la batterie finit de se vider (coupure brutale).
        printf '{"text":""}\n'
        b=/sys/class/power_supply/BAT0; [ -r "$b/capacity" ] || exit 0
        f="${XDG_RUNTIME_DIR:-/tmp}/battery-notified"
        if [ "$(cat "$b/status")" = "Discharging" ] && [ "$(cat "$b/capacity")" -le 10 ]; then
            [ -e "$f" ] || { notify-send -u critical "Batterie faible" "$(cat "$b/capacity")%: brancher le chargeur"; : > "$f"; }
            if [ "$(cat "$b/capacity")" -le 1 ] && [ ! -e "$f.off" ]; then
                : > "$f.off"
                notify-send -u critical -t 60000 "Batterie critique: extinction dans 1 min" "Brancher le chargeur pour l'annuler"
                setsid -f sh -c '
                    sleep 60
                    if [ "$(cat '"$b"'/status)" = "Discharging" ]; then sync; sudo -n poweroff
                    else rm -f '"$f.off"'; notify-send "Extinction annulée" "Chargeur branché"; fi' >/dev/null 2>&1
            fi
        else
            rm -f "$f" "$f.off"
        fi ;;
esac
