#!/bin/sh
# VPN Proton via WireGuard (wg-quick), sans daemon: le tunnel vit dans le noyau.
# Configs: /etc/wireguard/NOM.conf (600, root), à télécharger sur account.proton.me (VPN > WireGuard), jamais dans le dépôt.
# NOM: 15 caractères max, commencer par "proton" pour que l'indicateur de la barre le reconnaisse (ex. proton-fr).
#   vpn            bascule: coupe le VPN actif, sinon connecte (demande lequel s'il y en a plusieurs)
#   vpn up [NOM] | vpn down | vpn status
DIR=/etc/wireguard
active() { ip -o link show type wireguard up 2>/dev/null | awk -F': ' '{print $2}'; }
confs() { sudo ls "$DIR" 2>/dev/null | sed -n 's/\.conf$//p'; }   # dossier en 700 root

up() {
    name="$1"
    if [ -z "$name" ]; then
        list="$(confs)"
        [ -n "$list" ] || { echo "Aucune config dans $DIR (voir l'en-tête de ce script)" >&2; return 1; }
        if [ "$(echo "$list" | wc -l)" -eq 1 ]; then
            name="$list"
        else
            echo "$list" | nl -w2 -s') '
            printf 'Numéro: '; read -r n
            name="$(echo "$list" | sed -n "${n}p")"
            [ -n "$name" ] || { echo "Choix invalide" >&2; return 1; }
        fi
    fi
    sudo wg-quick up "$name"
}

down() {
    for i in $(active); do sudo wg-quick down "$i"; done
}

case "${1:-toggle}" in
    up) up "$2" ;;
    down) down ;;
    status) a="$(active)"; if [ -n "$a" ]; then echo "VPN actif: $a"; ip -br addr show "$a"; else echo "VPN coupé"; fi ;;
    toggle) if [ -n "$(active)" ]; then down; else up; fi; sleep 2 ;;
    *) echo "usage: vpn [up [NOM]|down|status]" >&2; exit 1 ;;
esac
