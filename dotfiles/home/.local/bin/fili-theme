#!/bin/sh
# Mode sombre (défaut) ou clair de Filigrane, et couleur d'accentuation.
# Usage: fili-theme [get|dark|light|toggle|apply] | accent [default|voile|ardoise|sauge|sable|cendre|brume]
# Choisi dans le fili-panel écrans (APPARENCE). État: $XDG_STATE_HOME/filigrane/theme (absent = sombre) et .../accent
# (absent = défaut: brume en sombre, noir en clair), relus en direct par la fili-shell et fili-file (FiliTheme.qml). "apply" (bootstrap.sh) réapplique l'état enregistré. Appliqué à:
#   portail xdg (gsettings color-scheme): Chromium, GTK4/libadwaita (~/.config/gtk-4.0/gtk.css suit la préférence)
#   GTK3: thème Adwaita ou Adwaita-dark, icônes Filigrane-Icons, couleurs Filigrane (~/.config/gtk-3.0/theme.css, généré)
#   foot: fenêtres ouvertes par signal (SIGUSR1 sombre, SIGUSR2 clair), suivantes par ~/.config/foot/theme.ini (généré)
#   niri: anneau de focus, bordures, ombre, vue d'ensemble (~/.config/niri/theme.kdl, généré, relu par niri)
#   fond d'écran Filigrane clair ou sombre (wallpaper), sauf image choisie par l'utilisateur
set -u
dir="${XDG_STATE_HOME:-$HOME/.local/state}/filigrane"
cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
cur=$(cat "$dir/theme" 2>/dev/null)
[ "$cur" = light ] || cur=dark
# Accent: nom -> teinte sombre, teinte claire (mêmes valeurs que FiliTheme.qml, accentTones)
accents="default voile ardoise sauge sable cendre brume"
tones() {
    case "$1" in
        ardoise) echo "#7f9ab6 #4f6884" ;;
        sauge) echo "#a3bfa8 #4a7354" ;;
        sable) echo "#d2bf92 #80662b" ;;
        cendre) echo "#c98f93 #9a4f55" ;;
        brume) echo "#dbe7f4 #4f5e70" ;;
        voile) echo "#9dbbd6 #3f5a78" ;;
        *) echo "#dbe7f4 #1c222b" ;;
    esac
}
acc=$(cat "$dir/accent" 2>/dev/null)
case " $accents " in *" $acc "*) ;; *) acc=default ;; esac
changed=mode
case "${1:-get}" in
    get) echo "$cur"; exit 0 ;;
    accent)
        [ -n "${2:-}" ] || { echo "$acc"; exit 0; }
        case " $accents " in *" $2 "*) ;; *) echo "accent inconnu: $2 ($accents)" >&2; exit 2 ;; esac
        acc=$2 mode=$cur changed=accent ;;
    toggle) [ "$cur" = light ] && mode=dark || mode=light ;;
    dark | light) mode=$1 ;;
    apply) mode=$cur ;;
    *) echo "usage: fili-theme [get|dark|light|toggle|apply|accent [nom]]" >&2; exit 2 ;;
esac

mkdir -p "$dir" "$cfg/gtk-3.0" "$cfg/foot" "$cfg/niri"
# Écrit sur place (pas de renommage): la fili-shell suit le fichier par inotify
printf '%s\n' "$mode" > "$dir/theme"
printf '%s\n' "$acc" > "$dir/accent"
set -- $(tones "$acc") "$@"
[ "$mode" = light ] && tone=$2 || tone=$1
shift 2

if [ "$mode" = light ]; then
    scheme=prefer-light gtk=Adwaita icons=Filigrane-Icons sig=USR2
else
    scheme=prefer-dark gtk=Adwaita-dark icons=Filigrane-Icons sig=USR1
fi
gen="// Généré par fili-theme ($mode), ne pas modifier ici"

printf '/* %s */\n@import url("filigrane-%s.css");\n' "${gen#// }" "$mode" > "$cfg/gtk-3.0/theme.css"
printf '# %s\n[main]\ninitial-color-theme=%s\n' "${gen#// }" "$mode" > "$cfg/foot/theme.ini"
if [ "$mode" = light ]; then
    cat > "$cfg/niri/theme.kdl" <<EOF
$gen
// Mode clair (brand.md): anneau et bordure à la couleur d'accent, liserés et vue d'ensemble papier
layout {
    focus-ring {
        active-color "${tone}99"
        inactive-color "#cdc8bd55"
    }
    border {
        active-color "$tone"
        inactive-color "#cdc8bd"
        urgent-color "#9a4f55"
    }
    shadow {
        color "#1c222b33"
    }
}
overview {
    backdrop-color "#dfdbd2"
}
EOF
else
    cat > "$cfg/niri/theme.kdl" <<EOF
$gen
// Mode sombre: couleurs de config.kdl, sauf l'accent
layout {
    focus-ring {
        active-color "${tone}99"
    }
    border {
        active-color "$tone"
    }
}
EOF
fi

# Sans session D-Bus (installation), seuls les fichiers sont écrits
gsettings set org.gnome.desktop.interface color-scheme "$scheme" 2>/dev/null
gsettings set org.gnome.desktop.interface gtk-theme "$gtk" 2>/dev/null
gsettings set org.gnome.desktop.interface icon-theme "$icons" 2>/dev/null

# Fenêtres ouvertes et fond d'écran: seulement à un changement de mode ("apply" ne bascule rien de visible)
[ -n "${WAYLAND_DISPLAY:-}" ] && [ "$changed" = mode ] && [ "${1:-}" != apply ] || exit 0
pkill -"$sig" -x foot 2>/dev/null
pkill -"$sig" -x footclient 2>/dev/null
# Fond d'écran: seulement le fond Filigrane (une image choisie reste)
wp=$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper" 2>/dev/null)
case "$wp" in
    "" | */wallpapers/filigrane.png | */wallpapers/filigrane-clair.png)
        setsid -f "$HOME/.local/bin/wallpaper" >/dev/null 2>&1 ;;
esac
exit 0
