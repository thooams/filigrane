#!/bin/sh
# Arrête les processus laissés par une session niri précédente (déconnexion, plantage): sans systemd, ce que niri lance
# au démarrage (pipewire, wireplumber, wa-daemon, goimapnotify...) est rattaché à runit et survit, chaque connexion en
# ajoutait un jeu. Un processus est orphelin si le niri de son NIRI_SOCKET (niri.wayland-1.<pid>.sock) n'existe plus.
# Ceux sans NIRI_SOCKET (SSH, TTY) ne sont pas touchés. Lancé par ~/.zprofile à la sortie de niri, pas à l'ouverture de la
# session suivante: un ancien pipewire qui s'arrête efface au passage la socket (même chemin) du nouveau. `-n`: liste sans arrêter.
# Un seul gawk lit tous les environ (BEGINFILE saute ceux des autres utilisateurs et des processus déjà finis).
pids="$(gawk 'BEGIN { RS = "\0" } BEGINFILE { if (ERRNO != "") nextfile }
    /^NIRI_SOCKET=/ {
        n = $0; sub(/\.sock$/, "", n); sub(/.*\./, "", n)
        if (!(n in alive)) { c = ""; f = "/proc/" n "/comm"; RS = "\n"; getline c < f; close(f); RS = "\0"; alive[n] = (c == "niri") }
        if (!alive[n]) { p = FILENAME; sub(/^\/proc\//, "", p); sub(/\/environ$/, "", p); print p }
        nextfile
    }' /proc/[0-9]*/environ 2>/dev/null)"
[ -n "$pids" ] || exit 0
if [ "$1" = -n ]; then
    for p in $pids; do printf '%s %s\n' "$p" "$(tr '\0' ' ' <"/proc/$p/cmdline" 2>/dev/null | cut -c1-80)"; done
else
    kill $pids 2>/dev/null
    # Attendre leur fin (5 s au plus), pour que la session suivante démarre sur une place nette (rclone démonté...)
    alive() { for p in $pids; do [ -d "/proc/$p" ] && return 0; done; return 1; }
    i=0; while [ "$i" -lt 50 ] && alive; do sleep 0.1; i=$((i + 1)); done
fi
exit 0
