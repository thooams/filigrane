#!/bin/bash
# Mini-cron utilisateur (lancé par niri): exécute des tâches périodiques, sans daemon cron.
# Chaque tâche a un fichier-témoin dans ~/.local/state/watch/; elle est rejouée quand il est plus vieux que son intervalle
# (donc rattrapage après un reboot). Échec (réseau...) = témoin intact, nouvel essai au prochain tour.
STATE="$HOME/.local/state/watch"
mkdir -p "$STATE"
exec 9>"$STATE/lock"
flock -n 9 || exit 0

# Tâches: une par ligne "nom:intervalle en minutes:script:argument" dans ~/.config/cron-watch/jobs.d/*
# (un fichier par couche: 00-core pour la distribution, puis matériel et personnel). Relu à chaque tour.
JOBS_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/cron-watch/jobs.d"

while :; do
    mapfile -t JOBS < <(cat "$JOBS_DIR"/* 2>/dev/null | sed -e 's/#.*//' -e '/^[[:space:]]*$/d')
    for job in "${JOBS[@]}"; do
        IFS=: read -r name every script arg <<<"$job"
        stamp="$STATE/$name.stamp"
        if [ ! -e "$stamp" ] || [ -n "$(find "$stamp" -mmin "+$every")" ]; then
            # ~/.local/bin d'abord (dotfiles, outils compilés), puis le PATH (paquet fili-apps dans /usr/bin)
            PATH="$HOME/.local/bin:$PATH" "$script" $arg && touch "$stamp"
        fi
    done
    sleep 1800
done
