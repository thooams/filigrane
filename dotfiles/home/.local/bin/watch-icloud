#!/bin/bash
# Rappel avant l'expiration de la session Apple d'iCloud Drive (30 jours, renouvellement interactif: code 2FA).
# Lancé par cron-watch (1 fois par jour): à partir du 25e jour, notification avec un bouton qui ouvre icloud-reconnect.
STATE="$HOME/.local/state/icloud"
LIFE=30 WARN=25

rclone listremotes 2>/dev/null | grep -qx icloud: || exit 0
[ -e "$STATE/auth.stamp" ] || { mkdir -p "$STATE"; touch "$STATE/auth.stamp"; }
age=$(( ($(date +%s) - $(stat -c %Y "$STATE/auth.stamp")) / 86400 ))
[ "$age" -lt "$WARN" ] && exit 0

left=$(( LIFE - age ))
if [ "$left" -gt 0 ]; then msg="La session expire dans $left j (code 2FA requis)"; else msg="La session a expiré: ~/iCloud ne répond plus"; fi
# notify-send -A attend le clic: en arrière-plan pour ne pas bloquer cron-watch
(
    [ "$(notify-send -u critical -a icloud -A reconnect=Reconnecter "Reconnexion iCloud" "$msg")" = reconnect ] &&
        "$HOME/.local/bin/bar-tui" icloud-reconnect
) >/dev/null 2>&1 &
disown
exit 0
