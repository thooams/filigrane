#!/bin/sh
# Tiroir de la barre à gauche de l'horloge (sauvegarde, mail, WhatsApp, agenda au repos, tray système): `bar-tray toggle`
# l'ouvre ou le replie. État: présence de $XDG_RUNTIME_DIR/bar-tray-open, lue par la barre (BarState.qml), sans daemon.
f="${XDG_RUNTIME_DIR:-/tmp}/bar-tray-open"
case "$1" in
    toggle) if [ -e "$f" ]; then rm -f "$f"; else : >"$f"; fi ;;
    *) echo "usage: bar-tray toggle" >&2; exit 2 ;;
esac
