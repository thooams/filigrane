#!/bin/sh
# Capot (appelé par niri, switch-events). Usage: lid close|open
# Fermé sans écran externe: verrou et écran éteint, veille seulement si le capot est encore
# fermé après LID_DELAY secondes. Rouvert avant: réveil immédiat (le Mac T2 ne sort pas de
# veille à l'ouverture du capot, seul le bouton power le réveille).
# Avec un écran externe: rien (kanshi gère l'écran interne).
LID_DELAY=${LID_DELAY:-300}
pidf="${XDG_RUNTIME_DIR:-/tmp}/lid-timer.pid"

stop_timer() {
    [ -f "$pidf" ] && kill "$(cat "$pidf")" 2>/dev/null
    rm -f "$pidf"
}

case "$1" in
    close)
        niri msg --json outputs | grep -q '"name":"\(DP\|HDMI\)' && exit 0
        stop_timer
        "$HOME/.local/bin/lock" auto &
        niri msg action power-off-monitors
        (
            sleep "$LID_DELAY"
            rm -f "$pidf"
            grep -q closed /proc/acpi/button/lid/*/state && sudo -n zzz
        ) &
        echo $! > "$pidf"
        ;;
    open)
        stop_timer
        niri msg action power-on-monitors
        ;;
    *) echo "Usage: lid close|open" >&2; exit 1 ;;
esac
