#!/bin/sh
# Fiche « À propos » (fili-about, FiliAbout.qml): Filigrane, système et machine, en JSON
# {"host": "...", "sections": [{"name": "System", "rows": [["Kernel", "6.18.59_1"], ...]}]}, textes traduits.
# Lancé seulement à l'ouverture de la fenêtre; une ligne absente (outil ou fichier manquant) est omise.
# Messages en anglais, traduits par lib/i18n/<langue>.sh (voir lib/i18n.sh)
FILI_LIB="$(dirname "$(readlink -f "$0")")/../../../../lib"
# shellcheck source=/dev/null disable=SC2059
if [ -r "$FILI_LIB/i18n.sh" ]; then . "$FILI_LIB/i18n.sh"; else t() { _t=$1; shift; printf -- "$_t" "$@"; }; fi
repo="$(cd "$(dirname "$(readlink -f "$0")")/../../../.." 2>/dev/null && pwd)"

# Taille lisible en Go (1 décimale sous 10 Go), séparateur décimal de la langue
dec="$(t '.')"
gb() { awk -v b="$1" -v u="$(t 'GB')" 'BEGIN { g = b / 1073741824; printf (g < 10 ? "%.1f %s" : "%.0f %s"), g, u }' | tr . "$dec"; }

version="$(git -C "$repo" describe --tags --always --dirty 2>/dev/null)"
[ -n "$version" ] && version="$version ($(git -C "$repo" branch --show-current 2>/dev/null), $(git -C "$repo" log -1 --format=%cs 2>/dev/null))"
ai="$(sed -n 's/^FILI_AI=//p' "${XDG_CONFIG_HOME:-$HOME/.config}/filigrane/ai.env" 2>/dev/null)"
layer="$(cat "$repo/.user-layer" 2>/dev/null)"
[ "$layer" = none ] && layer=""

os="$(. /etc/os-release 2>/dev/null; printf '%s' "${PRETTY_NAME:-Linux}")"
libc="glibc"; ldd --version 2>&1 | grep -qi musl && libc="musl"
pkgs="$(xbps-query -l 2>/dev/null | wc -l)"
[ "$pkgs" -gt 0 ] 2>/dev/null && pkgs="$pkgs (xbps)" || pkgs=""
niri="$(niri --version 2>/dev/null | awk '{print $2}')"
qs="$(qs --version 2>/dev/null | awk 'NR==1 {print $2}')"
s="$(cut -d. -f1 /proc/uptime)"
d=$((s / 86400)) h=$((s % 86400 / 3600)) m=$((s % 3600 / 60))
if [ "$d" -gt 0 ]; then up="$(t '%s d %s h' "$d" "$h")"; elif [ "$h" -gt 0 ]; then up="$(t '%s h %s min' "$h" "$m")"; else up="$(t '%s min' "$m")"; fi

dmi=/sys/class/dmi/id
model="$(cat $dmi/sys_vendor $dmi/product_name 2>/dev/null | tr '\n' ' ' | sed 's/ *$//')"
cpu="$(sed -n 's/^model name[[:space:]]*: //p' /proc/cpuinfo | head -1 | sed 's/(R)//g; s/(TM)//g; s/ CPU//; s/  */ /g')"
[ -n "$cpu" ] && cpu="$(t '%s, %s threads' "$cpu" "$(nproc)")"
gpu="$(lspci 2>/dev/null | sed -n 's/^[^ ]* \(VGA compatible controller\|3D controller\|Display controller\): //p' |
    sed 's/ (rev [0-9a-f]*)//; s/ Corporation//' | paste -sd '/' | sed 's|/| · |g')"
mem="$(awk '/^MemTotal:/ {t = $2} /^MemAvailable:/ {a = $2} END {print t * 1024, (t - a) * 1024}' /proc/meminfo)"
mem="$(t '%s, %s used' "$(gb "${mem% *}")" "$(gb "${mem#* }")")"
disk="$(df -B1 --output=size,avail / 2>/dev/null | awk 'NR==2 {print $1, $2}')"
[ -n "$disk" ] && disk="$(t '%s, %s free' "$(gb "${disk% *}")" "$(gb "${disk#* }")")"
screens="$(niri msg -j outputs 2>/dev/null | jq -r '[.[] | (.modes[.current_mode // 0] // {}) as $m
    | "\(.name) \($m.width)×\($m.height)"] | join(" · ")' 2>/dev/null)"
bat="$(for b in /sys/class/power_supply/BAT*; do
    [ -r "$b/capacity" ] || continue
    case "$(cat "$b/status")" in
        Charging) st="$(t 'charging')" ;; Discharging) st="$(t 'on battery')" ;; Full) st="$(t 'full')" ;; *) st="$(t 'plugged in')" ;;
    esac
    printf '%s %%, %s' "$(cat "$b/capacity")" "$st"
    for k in energy charge; do
        [ -r "$b/${k}_full" ] && [ -r "$b/${k}_full_design" ] || continue
        health="$(awk -v f="$(cat "$b/${k}_full")" -v d="$(cat "$b/${k}_full_design")" 'BEGIN { if (d > 0) printf "%d", f * 100 / d }')"
        [ -n "$health" ] && t ', health %s %%' "$health"
        break
    done
    break
done)"

# Sections: "# Nom" puis une ligne "libellé<TAB>valeur" par ligne de la fiche
{
    printf '# %s\n' "Filigrane"
    printf '%s\t%s\n' "$(t 'Version')" "$version" "$(t 'Personal layer')" "$layer" "$(t 'AI agent')" "$ai"
    printf '# %s\n' "$(t 'System')"
    printf '%s\t%s\n' "OS" "$os" "$(t 'Kernel')" "$(uname -r) ($(uname -m), $libc)" "Init" "runit" "$(t 'Packages')" "$pkgs" \
        "$(t 'Compositor')" "${niri:+niri $niri}" "Shell" "${qs:+Quickshell $qs}" "$(t 'Uptime')" "$up"
    printf '# %s\n' "$(t 'Machine')"
    printf '%s\t%s\n' "$(t 'Model')" "$model" "$(t 'Processor')" "$cpu" "$(t 'Graphics')" "$gpu" "$(t 'Memory')" "$mem" \
        "$(t 'Disk /')" "$disk" "$(t 'Displays')" "$screens" "$(t 'Battery')" "$bat"
} | jq -Rn --arg host "$(cat /etc/hostname 2>/dev/null || uname -n)" '
    reduce (inputs | select(length > 0)) as $l ([];
        if ($l | startswith("# ")) then . + [{name: $l[2:], rows: []}]
        else ($l | split("\t")) as $r | if ($r[1] // "") == "" then . else .[-1].rows += [[$r[0], $r[1]]] end end)
    | {host: $host, sections: map(select(.rows != []))}'
