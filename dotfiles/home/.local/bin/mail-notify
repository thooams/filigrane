#!/bin/sh
# Appelé par goimapnotify à l'arrivée d'un mail: notification mako avec expéditeur et sujet du dernier mail.
# goimapnotify déclenche aussi un faux événement à son démarrage: ignoré s'il a moins de 10 s.
# Lecture via le pont Proton local (identifiants du trousseau, voir goimapnotify.yaml); repli générique si elle échoue.
age="$(ps -o etimes= -C goimapnotify | sort -n | head -1 | tr -d ' ')"
[ "${age:-99}" -lt 10 ] && exit 0

PB_USER="$(secret-tool lookup service proton-bridge-user)" PB_PASS="$(secret-tool lookup service proton-bridge-pass)" \
python3 - <<'PY' | {
import imaplib, os, html
from email import message_from_bytes
from email.header import decode_header, make_header
from email.utils import parseaddr

def dec(v):
    return str(make_header(decode_header(v))) if v else ""

try:
    c = imaplib.IMAP4("127.0.0.1", 1143, timeout=10)
    c.starttls(__import__("ssl")._create_unverified_context())
    c.login(os.environ["PB_USER"], os.environ["PB_PASS"])
    c.select("INBOX", readonly=True)
    _, d = c.fetch("*", "(BODY.PEEK[HEADER.FIELDS (FROM SUBJECT)])")
    m = message_from_bytes(d[0][1])
    name, addr = parseaddr(dec(m["From"]))
    print(html.escape(name or addr or "Expéditeur inconnu"))
    print(html.escape(dec(m["Subject"]) or "(sans objet)"))
    c.logout()
except Exception:
    pass
PY
    IFS= read -r from
    IFS= read -r subject
    if [ -n "$subject" ]; then
        notify-send -a "Proton Mail" -i mail-unread "Mail · $from" "$subject"
    else
        notify-send -a "Proton Mail" -i mail-unread "Nouveau mail" "Boîte de réception Proton"
    fi
}
