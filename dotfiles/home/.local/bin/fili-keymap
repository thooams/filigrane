#!/usr/bin/python3 -I
# fili-keymap [N]: touches de la disposition N (groupe xkb, 0 par défaut) en JSON pour le fili-panel clavier.
# Lit layout/variant/options de ~/.config/niri/keyboard.kdl (écrit par bootstrap.sh), compile le keymap avec xkbcli
# et sort { "rows": [[ { "k": "AD01", "l": [[keysym, caractère] x 4 niveaux] } ]] }: rangées de la ligne des chiffres
# à la ligne du bas. keysym sert à `wtype -k`, caractère à l'affichage (vide pour les touches mortes).
import ctypes, ctypes.util, json, os, re, subprocess, sys

group = int(sys.argv[1]) if len(sys.argv) > 1 else 0
try:
    kdl = open(os.path.expanduser("~/.config/niri/keyboard.kdl")).read()
except OSError:
    kdl = ""
def opt(name):
    m = re.search(r'^\s*' + name + r'\s+"([^"]*)"', kdl, re.M)
    return m.group(1) if m else ""
cmd = ["xkbcli", "compile-keymap", "--layout", opt("layout") or "us"]
if opt("variant"):
    cmd += ["--variant", opt("variant")]
if opt("options"):
    cmd += ["--options", opt("options")]
keymap = subprocess.run(cmd, capture_output=True, text=True, check=True).stdout

lib = ctypes.CDLL(ctypes.util.find_library("xkbcommon") or "libxkbcommon.so.0")
lib.xkb_keysym_from_name.argtypes = [ctypes.c_char_p, ctypes.c_int]
lib.xkb_keysym_from_name.restype = ctypes.c_uint32
lib.xkb_keysym_to_utf8.argtypes = [ctypes.c_uint32, ctypes.c_char_p, ctypes.c_size_t]
def char(name):
    if name == "NoSymbol":
        return ""
    buf = ctypes.create_string_buffer(8)
    n = lib.xkb_keysym_to_utf8(lib.xkb_keysym_from_name(name.encode(), 0), buf, 8)
    s = buf.value.decode() if n > 0 else ""
    return s if s.isprintable() else ""

keys = {}
for m in re.finditer(r'key <(\w+)>\s*\{(.*?)\};', keymap, re.S):
    s = re.search(r'symbols\[%d\]\s*=\s*\[([^\]]*)\]' % (group + 1), m.group(2))
    if s:
        syms = [x.strip() for x in s.group(1).split(",")]
        keys[m.group(1)] = (syms + ["NoSymbol"] * 4)[:4]

layout = [
    ["TLDE"] + ["AE%02d" % i for i in range(1, 13)],
    ["AD%02d" % i for i in range(1, 13)] + ["BKSL"],
    ["AC%02d" % i for i in range(1, 12)],
    ["LSGT"] + ["AB%02d" % i for i in range(1, 11)],
]
rows = [[{"k": k, "l": [[x, char(x)] for x in keys[k]]} for k in row if k in keys] for row in layout]
print(json.dumps({"rows": rows}, ensure_ascii=False))
