#!/bin/sh
# Application web dans sa propre fenêtre (Chrome ou Chromium --app: sans barre d'onglets ni d'adresse).
# Navigateur: $WEBAPP_BROWSER, sinon Google Chrome s'il est installé, sinon Chromium (paquet de la distribution).
# Même profil que le navigateur: pas de second navigateur résident, session conservée.
# Si une fenêtre de cette appli existe déjà (app-id "chrome-<hôte>__-<profil>"), elle prend le focus au lieu d'être rouverte.
#   webapp https://web.whatsapp.com
[ -n "$1" ] || { echo "usage: webapp URL" >&2; exit 1; }
host="${1#*://}"; host="${host%%/*}"
win="$(niri msg -j windows 2>/dev/null | jq -r --arg p "chrome-$host" '
    map(select((.app_id // "") | startswith($p + "_"))) | first | .id // empty')"
if [ -n "$win" ]; then
    exec niri msg action focus-window --id "$win"
fi
# Détaché: sinon Chrome reste fils du lanceur (clic dans la barre) et bloque le rafraîchissement du module
browser="${WEBAPP_BROWSER:-$(command -v google-chrome-stable || echo chromium)}"
setsid -f "$browser" --app="$1" >/dev/null 2>&1
