#!/bin/sh
# Application web dans sa propre fenêtre (Chromium --app: sans barre d'onglets ni d'adresse).
# Même profil que le navigateur: pas de second Chromium résident, session conservée.
# Si une fenêtre de cette appli existe déjà (app-id "chrome-<hôte>__-Profile_1"), elle prend le focus au lieu d'être rouverte.
#   webapp https://web.whatsapp.com
[ -n "$1" ] || { echo "usage: webapp URL" >&2; exit 1; }
host="${1#*://}"; host="${host%%/*}"
win="$(niri msg -j windows 2>/dev/null | jq -r --arg p "chrome-$host" '
    map(select((.app_id // "") | startswith($p + "_"))) | first | .id // empty')"
if [ -n "$win" ]; then
    exec niri msg action focus-window --id "$win"
fi
exec chromium --app="$1"
