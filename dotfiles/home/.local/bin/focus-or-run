#!/bin/sh
# Donne le focus à la fenêtre d'app-id APPID si elle existe, sinon lance la commande. Usage: focus-or-run APPID CMD [ARGS...]
app="$1"; shift
win="$(niri msg -j windows 2>/dev/null | jq -r --arg a "$app" 'map(select(.app_id == $a)) | first | .id // empty')"
[ -n "$win" ] && exec niri msg action focus-window --id "$win"
setsid -f "$@"
