#!/usr/bin/env python3
# Réglage en direct du DSP haut-parleurs (hardware/mac-t2/audio/speakers-j293.json).
#   sound-tune           panneau TUI (↑↓ choisir, ←→ régler, s sauver, o origine Asahi, r recharger, q quitter)
#   sound-tune --apply   réapplique ~/.config/t2-audio/tune.conf (ouverture de session niri)
#   sound-tune --get     réglages enregistrés et bornes, en JSON (égaliseur du fili-panel son)
#   sound-tune --set clé=valeur... [--save]   applique en direct (et enregistre); --reset: valeurs par défaut, enregistrées
import curses, json, os, subprocess, sys, time

# Messages en anglais, traduits par lib/i18n/<langue>.sh (voir lib/i18n.sh), via le shell; une fois par texte
FILI_LIB = os.path.join(os.path.dirname(os.path.realpath(__file__)), "../../../../lib")
_tr = {}


def t(fmt, *args):
    if fmt not in _tr:
        if os.path.exists(f"{FILI_LIB}/i18n.sh"):
            cmd = 'FILI_LIB="$1"; . "$FILI_LIB/i18n.sh"; _t_fmt=$2; _t_lookup "$2"; printf %s "$_t_fmt"'
            _tr[fmt] = subprocess.run(["sh", "-c", cmd, "sh", FILI_LIB, fmt], capture_output=True, text=True).stdout or fmt
        else:
            _tr[fmt] = fmt
    return _tr[fmt].replace("%s", "{}").format(*args) if args else _tr[fmt]


NODE = "audio_effect.t2-speakers"
CONF = os.path.expanduser("~/.config/t2-audio/tune.conf")

# clé, libellé, min, max, pas, unité, contrôles du graphe
PARAMS = [
    ("bass",      t('Bass (bankstown)'), 0.0,   4.0,    0.1,  "",    ["bassex:amt"]),
    ("mid_gain",  t('Mids'), -6.0,   8.0,    0.5,  "dB",  ["midl:Gain", "midr:Gain"]),
    ("mid_freq",  t('Mids: centre'), 400.0, 3000.0, 100.0,  "Hz",  ["midl:Freq", "midr:Freq"]),
    ("treb_gain", t('Treble'), -6.0,  10.0,    0.5,  "dB",  ["trebl:Gain", "trebr:Gain"]),
    ("treb_freq", t('Treble: from'), 2000.0, 10000.0, 250.0, "Hz", ["trebl:Freq", "trebr:Freq"]),
    ("loudness",  t('Loudness'), 0.0,   1.0,    1.0,  "",    ["ell:enabled", "elr:enabled"]),
]
# Valeurs Asahi d'origine (sans correction d'aigus ni de médiums)
ORIGIN = {"bass": 1.4, "mid_gain": 0.0, "mid_freq": 1200.0, "treb_gain": 0.0, "treb_freq": 4500.0, "loudness": 1.0}
# Valeurs par défaut du graphe installé
DEFAULT = {**ORIGIN, "mid_gain": 3.0, "treb_gain": 5.0}


def load():
    vals = dict(DEFAULT)
    try:
        with open(CONF) as f:
            for line in f:
                line = line.split("#")[0].strip()
                if "=" in line:
                    k, v = (x.strip() for x in line.split("=", 1))
                    if k in vals:
                        vals[k] = float(v)
    except (OSError, ValueError):
        pass
    return vals


def save(vals):
    # écriture en place: le fichier est un lien vers le dépôt (hardware/mac-t2/dotfiles/config/t2-audio)
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    with open(CONF, "w") as f:
        f.write("# Speaker DSP settings, written by sound-tune\n")
        for k, *_ in PARAMS:
            f.write(f"{k} = {vals[k]:g}\n")


def node_id():
    out = subprocess.run(["pw-dump"], capture_output=True, text=True).stdout
    for o in json.loads(out or "[]"):
        if o.get("info", {}).get("props", {}).get("node.name") == NODE:
            return o["id"]
    return None


def apply(nid, vals):
    pod = []
    for k, _, _, _, _, _, ctrls in PARAMS:
        pod += [f'"{c}" {vals[k]:.3f}' for c in ctrls]
    subprocess.run(["pw-cli", "set-param", str(nid), "Props", "{ params = [ " + " ".join(pod) + " ] }"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def fmt(p, v):
    key, _, _, _, _, unit, _ = p
    if key == "loudness":
        return t('on') if v else t('off')
    if unit == "dB":
        return f"{v:+.1f} dB"
    return f"{v:g} {unit}".strip()


def tui(scr, nid):
    curses.curs_set(0)
    curses.use_default_colors()
    vals, saved, sel, msg = load(), load(), 0, ""
    while True:
        scr.erase()
        scr.addstr(0, 2, t('Speaker sound (macOS-style DSP)'), curses.A_BOLD)
        for i, p in enumerate(PARAMS):
            key, label, lo, hi = p[:4]
            width = 20
            fill = int(round((vals[key] - lo) / (hi - lo) * width))
            bar = "█" * fill + "·" * (width - fill)
            attr = curses.A_REVERSE if i == sel else 0
            scr.addstr(2 + i, 2, f"{label:<20}", attr)
            scr.addstr(2 + i, 23, f" {bar}  {fmt(p, vals[key])}")
        state = "" if vals == saved else "  " + t('(not saved)')
        scr.addstr(3 + len(PARAMS), 2, t('↑↓ choose  ←→ adjust  s save  o Asahi origin  r reload  q quit'))
        scr.addstr(4 + len(PARAMS), 2, (msg or "") + state, curses.A_DIM)
        msg = ""
        c = scr.getch()
        key, _, lo, hi, step = PARAMS[sel][:5]
        if c in (ord("q"), 27):
            return
        elif c in (curses.KEY_UP, ord("k")):
            sel = (sel - 1) % len(PARAMS)
        elif c in (curses.KEY_DOWN, ord("j")):
            sel = (sel + 1) % len(PARAMS)
        elif c in (curses.KEY_LEFT, curses.KEY_RIGHT, ord("h"), ord("l")):
            d = step if c in (curses.KEY_RIGHT, ord("l")) else -step
            vals[key] = round(min(hi, max(lo, vals[key] + d)), 3)
            apply(nid, vals)
        elif c == ord("s"):
            save(vals)
            saved = dict(vals)
            msg = t('Saved to %s', CONF)
        elif c == ord("o"):
            vals = dict(ORIGIN)
            apply(nid, vals)
            msg = t('Original Asahi values (s to keep)')
        elif c == ord("r"):
            vals = load()
            apply(nid, vals)
            msg = t('Saved settings reloaded')


def cli(args):
    if "--get" in args:
        print(json.dumps({"vals": load(), "default": DEFAULT,
                          "params": {p[0]: {"min": p[2], "max": p[3], "step": p[4]} for p in PARAMS}}))
        return
    vals = dict(DEFAULT) if "--reset" in args else load()
    for a in args:
        k, _, v = a.partition("=")
        if k in vals and v:
            lo, hi = next((p[2], p[3]) for p in PARAMS if p[0] == k)
            vals[k] = round(min(hi, max(lo, float(v))), 3)
    nid = node_id()
    if not nid:
        sys.exit(t('Filter %s not found (speaker DSP not loaded?)', NODE))
    apply(nid, vals)
    if "--save" in args or "--reset" in args:
        save(vals)


def main():
    if any(a in sys.argv for a in ("--get", "--set", "--reset")):
        cli(sys.argv[1:])
        return
    if "--apply" in sys.argv:
        # à l'ouverture de session, le filtre apparaît quelques secondes après pipewire
        for _ in range(60):
            nid = node_id()
            if nid:
                apply(nid, load())
                return
            time.sleep(1)
        return
    nid = node_id()
    if not nid:
        sys.exit(t('Filter %s not found (speaker DSP not loaded?)', NODE))
    curses.wrapper(tui, nid)


main()
