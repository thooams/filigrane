#!/bin/bash
# Indicateur de la barre: rapports de veille non lus (Omarchy, T2) écrits par watch-claude (vide si aucun, donc module masqué).
# `bar-news open` les affiche dans un terminal flottant puis les archive.
# Messages en anglais, traduits par lib/i18n/<langue>.sh (voir lib/i18n.sh)
FILI_LIB="$(dirname "$(readlink -f "$0")")/../../../../lib"
# shellcheck source=/dev/null disable=SC2059
if [ -r "$FILI_LIB/i18n.sh" ]; then . "$FILI_LIB/i18n.sh"; else t() { _t=$1; shift; printf -- "$_t" "$@"; }; fi
R="$HOME/.local/state/watch/reports"
shopt -s nullglob
files=("$R"/*.md)

if [ "$1" = open ]; then
    [ ${#files[@]} -gt 0 ] || exit 0
    tmp="$(mktemp --suffix=.md)"
    for f in "${files[@]}"; do
        printf '# %s\n\n' "$(basename "$f" .md)"; cat "$f"; printf '\n\n'
    done >"$tmp"
    exec "$HOME/.local/bin/bar-tui" bash -c '
        tmp=$1; shift
        bat --paging=always -l md --style=plain "$tmp" 2>/dev/null || less "$tmp"
        mkdir -p "$(dirname "$1")/archive" && mv "$@" "$(dirname "$1")/archive/"
        rm -f "$tmp"; "$HOME/.local/bin/fili-shell" bar refresh 15' _ "$tmp" "${files[@]}"
fi

if [ ${#files[@]} -eq 0 ]; then
    printf '{"text":""}\n'
    exit 0
fi
tip=""
for f in "${files[@]}"; do tip+="$(basename "$f" .md): $(head -1 "$f" | cut -c1-120)"$'\n'; done
jq -nc --arg t "${#files[@]}" --arg tip "${tip%$'\n'}
$(t '(click: read)')" '{text: (" " + $t), tooltip: $tip}'
