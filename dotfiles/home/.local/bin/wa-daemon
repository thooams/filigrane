#!/bin/sh
# WhatsApp sans navigateur: whatsapp-unreadd (démon Go, ~23 Mo) relancé s'il tombe, plus wa-count qui reporte le compteur
# de non-lus dans la barre. Attend l'appairage (wa-pair, une fois). Ses notifications passent par webapp-notify.
# Lancé par niri au démarrage.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/wa-daemon.lock"
flock -n 9 || exit 0
until [ -e "$HOME/.config/whatsapp-unread/paired" ]; do sleep 30; done
"$HOME/.local/bin/wa-count" &
trap 'kill $! 2>/dev/null; exit' TERM INT
while :; do
    "$HOME/.local/bin/whatsapp-unreadd" >/dev/null 2>&1
    sleep 10
done
