#!/bin/sh
# Lance une TUI dans un foot flottant (règle niri sur l'app-id bar-tui). Usage: bar-tui CMD [ARGS...]
# Si la même commande tourne déjà dans une fenêtre bar-tui, elle prend le focus au lieu d'être relancée
# (comparaison de la ligne de commande de foot, le titre peut être changé par la TUI).
want="$(printf '%s\0' foot --app-id bar-tui -T "$1" -e "$@" | tr '\0' ' ')"
niri msg -j windows 2>/dev/null | jq -r '.[] | select(.app_id == "bar-tui") | "\(.id) \(.pid)"' |
while read -r id pid; do
    [ "$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null)" = "$want" ] && { niri msg action focus-window --id "$id"; exit 7; }
done
[ $? -eq 7 ] && exit 0
# Détaché (setsid -f): sinon le terminal reste fils de la barre (clic) et bloque le rafraîchissement de ses modules
setsid -f foot --app-id bar-tui -T "$1" -e "$@"
