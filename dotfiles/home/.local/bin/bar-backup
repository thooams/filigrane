#!/bin/sh
# Sauvegarde restic immédiate depuis la barre (`bar-backup run`, watch-backup now). L'état affiché (idle, active, failed)
# est écrit par bar-stats (apps/bar-stats, stat backup).
[ "$1" = run ] || { echo "usage: bar-backup run" >&2; exit 2; }
pgrep -f '^restic backup' >/dev/null && { notify-send -u low -a backup "Sauvegarde" "Déjà en cours"; exit 0; }
setsid "$HOME/.local/bin/watch-backup" now >/dev/null 2>&1 &
