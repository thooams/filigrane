#!/bin/bash
# Minuteur / chronomètre de la barre, sans daemon: l'état est un petit fichier dans $XDG_RUNTIME_DIR/bar-timer
# ("T <fin>" minuteur, "S <début>" chronomètre, "done" minuteur terminé), lu et décompté par la barre (BarState.qml).
# Usage: bar-timer click (choisir / arrêter / acquitter) | add (+5 min au minuteur) | expire (minuteur écoulé, appelé par la barre)
# Durées du minuteur: 5 (minutes), 90s, 10m, 1h.
f="${XDG_RUNTIME_DIR:-/tmp}/bar-timer"
kind=''; val=''
[ -r "$f" ] && read -r kind val <"$f"

fmt() { # secondes -> [H:]MM:SS
    if [ "$1" -ge 3600 ]; then printf '%d:%02d:%02d' $(($1 / 3600)) $(($1 % 3600 / 60)) $(($1 % 60))
    else printf '%02d:%02d' $(($1 / 60)) $(($1 % 60)); fi
}

case "$1" in
    click)
        case "$kind" in
            S) notify-send "Chronomètre" "$(fmt $((EPOCHSECONDS - val)))"; rm -f "$f"; exit 0 ;;
            T|done) rm -f "$f"; exit 0 ;;
        esac
        out="$(printf '%s\n' Chronomètre 1m 5m 10m 15m 25m 45m 1h | "$HOME/.local/bin/fili-shell" launcher --prompt 'Minuteur: ' --lines 8)" || exit 0
        if [ "$out" = Chronomètre ]; then
            echo "S $EPOCHSECONDS" >"$f"
        else
            n="${out//[!0-9]/}"; [ -n "$n" ] || exit 0
            case "$out" in *h*) s=$((n * 3600)) ;; *s*) s=$n ;; *) s=$((n * 60)) ;; esac
            echo "T $((EPOCHSECONDS + s))" >"$f"
        fi ;;
    add)
        [ "$kind" = T ] || exit 0
        echo "T $((val + 300))" >"$f" ;;
    expire)
        [ "$kind" = T ] && [ "$val" -le "$EPOCHSECONDS" ] || exit 0
        echo done >"$f"
        notify-send -u critical "Minuteur" "Terminé" ;;
esac
