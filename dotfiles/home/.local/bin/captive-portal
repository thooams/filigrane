#!/bin/sh
# Test de connectivité (comme Omarchy): 204 = OK; redirection = portail captif (ouvre la page de connexion);
# IPv4 muet mais IPv6 ok = bail DHCP périmé (Wi-Fi: reconnexion iwd; filaire: `dhcpcd -n`).
URL=http://connectivitycheck.gstatic.com/generate_204
notify() { notify-send -a connectivity "$@"; }

out="$(curl -4 -s -m 5 -o /dev/null -w '%{http_code} %{redirect_url}' "$URL")"
code="${out%% *}"
loc="${out#* }"

case "$code" in
    204) notify "Connexion OK"; exit 0 ;;
    000)
        if ping -6 -c1 -W2 2606:4700:4700::1111 >/dev/null 2>&1; then
            iface="$(ip route show default | awk '{print $5; exit}')"
            notify -u critical "IPv4 mort, IPv6 ok" "Bail DHCP périmé: renouvellement de $iface"
            # Wi-Fi: iwd configure l'IP, une reconnexion refait le DHCP
            ssid="$(iwctl station "$iface" show 2>/dev/null | sed -n 's/^ *Connected network *//p' | sed 's/ *$//')"
            if [ -n "$ssid" ]; then
                iwctl station "$iface" disconnect && exec iwctl station "$iface" connect "$ssid"
            fi
            exec "$HOME/.local/bin/bar-tui" sh -c 'sudo dhcpcd -n "$1"; sleep 2' _ "$iface"
        fi
        notify -u critical "Pas de connexion" "Ni IPv4 ni IPv6" ;;
    *)
        notify "Portail captif" "Ouverture de la page de connexion"
        setsid -f xdg-open "${loc:-$URL}" >/dev/null 2>&1 ;;
esac
