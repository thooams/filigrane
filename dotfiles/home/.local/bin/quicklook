#!/bin/sh
# Aperçu rapide façon QuickLook (Thunar: Espace). Fenêtre flottante app-id "quicklook" (règle niri).
# Image -> imv, vidéo/audio -> mpv, PDF -> 10 premières pages en image, CSV/TSV -> pspg,
# texte -> bat, dossier -> eza.
# Espace, Échap ou q referme. Relancer sur le même fichier referme l'aperçu ouvert.
# Messages en anglais, traduits par lib/i18n/<langue>.sh (voir lib/i18n.sh)
FILI_LIB="$(dirname "$(readlink -f "$0")")/../../../../lib"
# shellcheck source=/dev/null disable=SC2059
if [ -r "$FILI_LIB/i18n.sh" ]; then . "$FILI_LIB/i18n.sh"; else t() { _t=$1; shift; printf -- "$_t" "$@"; }; fi

[ $# -gt 0 ] || exit 0
last="${XDG_RUNTIME_DIR:-/tmp}/quicklook-last"

# Bascule: un aperçu déjà ouvert est fermé; si c'était le même fichier, on s'arrête là
open=$(niri msg --json windows | jq -r '.[] | select(.app_id == "quicklook") | .id')
if [ -n "$open" ]; then
    for id in $open; do niri msg action close-window --id "$id"; done
    [ "$(cat "$last" 2>/dev/null)" = "$1" ] && { rm -f "$last"; exit 0; }
fi
printf '%s' "$1" > "$last"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
f="$1"
title="$(t 'Preview: %s' "$(basename "$f")")"

page() { # page COMMANDE... : sortie dans less (Espace ou q referme)
    "$@" > "$tmp/out" 2>&1
    foot --app-id=quicklook --title="$title" less -R --lesskey-content='\40 quit' "$tmp/out"
}
images() { imv -i quicklook -w "$title" -c 'bind <space> quit' -c 'bind <Escape> quit' "$@"; }

if [ -d "$f" ]; then
    if command -v eza >/dev/null; then page eza -la --group-directories-first --color=always "$f"
    else page ls -la --group-directories-first --color=always "$f"; fi
    exit 0
fi

# Tableaux: pspg (séparateur détecté, q ou Échap referme); file les voit souvent en text/plain
case "$f" in
    *.[cC][sS][vV]|*.[tT][sS][vV])
        fmt=--csv; case "$f" in *.[tT][sS][vV]) fmt=--tsv ;; esac
        foot --app-id=quicklook --title="$title" pspg "$fmt" --on-sigint-exit "$f"
        exit 0 ;;
esac

case "$(file -b --mime-type "$f")" in
    image/*)
        # Plusieurs images sélectionnées: toutes dans imv (flèches pour naviguer)
        images "$@" ;;
    video/*|audio/*)
        mpv --wayland-app-id=quicklook --force-window=yes --keep-open=yes \
            --input-conf="$HOME/.config/mpv/quicklook-input.conf" "$f" ;;
    application/pdf)
        pdftoppm -l 10 -r 100 -png "$f" "$tmp/page" && images "$tmp"/page-*.png ;;
    *)
        if [ "$(file -b --mime-encoding "$f")" != binary ]; then
            if command -v bat >/dev/null; then page bat --color=always --style=numbers,header --paging=never "$f"
            else page cat "$f"; fi
        else
            page sh -c 'file -b "$1"; echo; ls -lh "$1"' sh "$f"
        fi ;;
esac
