#!/bin/sh
# Contenu des fiches fili-tooltip de la fili-bar (survol de réseau, alimentation, écran), inspiré des panneaux
# d'Omarchy. Lancé seulement au survol: rien n'est sondé en continu.
# Usage: fili-info network|power|display|monitor  ->  JSON {title, rows: [[libellé, valeur]...], hint}
# Lignes vides ignorées par fili-tooltip.

human() { # octets -> unités lisibles
    awk -v b="$1" 'BEGIN { split("o Kio Mio Gio Tio", u); i = 1; while (b >= 1024 && i < 5) { b /= 1024; i++ }
        printf (i == 1 ? "%d %s" : "%.1f %s"), b, u[i] }'
}
card() { # card TITRE INDICE [libellé valeur]...
    t="$1"; h="$2"; shift 2
    jq -nc --arg t "$t" --arg h "$h" '{title: $t, hint: $h, rows: [$ARGS.positional as $a | range(0; $a | length; 2) | [$a[.], $a[. + 1]] | select(.[1] != "" and .[1] != null)]}' --args "$@"
}

case "$1" in
network)
    iface="$(awk 'NR > 1 && $2 == "00000000" { print $1; exit }' /proc/net/route)"
    if [ -z "$iface" ]; then
        card "Hors ligne" "clic: panneau réseau · clic droit: menu réseau" "Interfaces" "$(ls /sys/class/net | grep -v '^lo$' | tr '\n' ' ')"
        exit 0
    fi
    gw="$(ip -4 route show default dev "$iface" 2>/dev/null | awk '$2 == "via" { print $3; exit }')"
    ip4="$(ip -o -4 addr show dev "$iface" 2>/dev/null | awk '{ print $4; exit }')"
    ip6="$(ip -o -6 addr show dev "$iface" scope global 2>/dev/null | awk '{ sub(/\/.*/, "", $4); print $4; exit }')"
    dns="$(awk '$1 == "nameserver" { printf "%s%s", sep, $2; sep = ", " }' /etc/resolv.conf 2>/dev/null)"
    rx="$(human "$(cat "/sys/class/net/$iface/statistics/rx_bytes")")"
    tx="$(human "$(cat "/sys/class/net/$iface/statistics/tx_bytes")")"
    ping="${gw:+$(ping -n -c 1 -W 1 "$gw" 2>/dev/null | awk -F'time=' '/time=/ { split($2, a, " "); printf "%.1f ms", a[1] }')}"
    if [ -d "/sys/class/net/$iface/wireless" ]; then
        link="$(iw dev "$iface" link 2>/dev/null)"
        val() { printf '%s\n' "$link" | awk -v k="$1" '{ sub(/^[ \t]+/, "") } index($0, k) == 1 { print substr($0, length(k) + 2); exit }'; }
        ssid="$(val SSID:)"; dbm="$(val signal: | awk '{ print $1 }')"; freq="$(val freq: | awk '{ printf "%d", $1 }')"
        q="$(awk -v d="$dbm" 'BEGIN { if (d == "") exit; q = 2 * (d + 100); if (q > 100) q = 100; if (q < 0) q = 0; printf "%d %% (%s dBm)", q, d }')"
        band="$(awk -v f="$freq" 'BEGIN { if (f == "") exit; b = f >= 5925 ? "6 GHz" : f >= 4900 ? "5 GHz" : "2,4 GHz";
            c = f >= 5925 ? (f - 5950) / 5 : f >= 4900 ? (f - 5000) / 5 : (f == 2484 ? 14 : (f - 2407) / 5); printf "%s, canal %d", b, c }')"
        rate="$(val 'rx bitrate:' | awk '{ print $1 " " $2 }') ↓  $(val 'tx bitrate:' | awk '{ print $1 " " $2 }') ↑"
        card "$ssid" "clic: panneau réseau · clic droit: menu réseau" \
            "Signal" "$q" "Bande" "$band" "Débit du lien" "$rate" "Interface" "$iface" \
            "Adresse IP" "$ip4" "IPv6" "$ip6" "Passerelle" "$gw" "Ping passerelle" "$ping" "DNS" "$dns" \
            "Reçu" "$rx" "Envoyé" "$tx"
    else
        speed="$(cat "/sys/class/net/$iface/speed" 2>/dev/null)"
        card "Ethernet $iface" "clic: panneau réseau · clic droit: menu réseau" \
            "Vitesse" "${speed:+$speed Mbit/s}" "Adresse IP" "$ip4" "IPv6" "$ip6" "Passerelle" "$gw" \
            "Ping passerelle" "$ping" "DNS" "$dns" "Reçu" "$rx" "Envoyé" "$tx"
    fi ;;
power)
    b=/sys/class/power_supply/BAT0
    [ -r "$b/capacity" ] || { card "Secteur" "clic: menu système"; exit 0; }
    r() { cat "$b/$1" 2>/dev/null; }
    st="$(r status)"
    ac="$(cat /sys/class/power_supply/A*/online 2>/dev/null | head -1)"
    # charge_* (µAh) et current_now (µA), ou energy_* (µWh) et power_now (µW) selon le matériel
    now="$(r charge_now)"; full="$(r charge_full)"; design="$(r charge_full_design)"; cur="$(r current_now)"; volt="$(r voltage_now)"
    [ -n "$now" ] || { now="$(r energy_now)"; full="$(r energy_full)"; design="$(r energy_full_design)"; cur="$(r power_now)"; volt=''; }
    eval "$(awk -v n="$now" -v f="$full" -v d="$design" -v c="$cur" -v v="$volt" -v s="$st" 'BEGIN {
        c = c < 0 ? -c : c
        w = v != "" ? c * v / 1e12 : c / 1e6
        if (c > 0 && s == "Discharging") t = n / c; else if (c > 0 && s == "Charging") t = (f - n) / c; else t = -1
        printf "watts=\"%s\" hours=\"%s\" health=\"%s\"\n", (w > 0.05 ? sprintf("%.1f W", w) : ""),
            (t > 0 ? sprintf("%d h %02d", int(t), int((t - int(t)) * 60)) : ""), (d > 0 ? sprintf("%d %%", f * 100 / d) : "") }')"
    case "$st" in
        Discharging) state="Sur batterie"; tl="Temps restant" ;;
        Charging) state="En charge"; tl="Pleine dans" ;;
        # "Full" sous 99 %: seuil de charge atteint (batterie préservée), comme "Holding" dans Omarchy
        Full) if [ "$(r capacity)" -lt 99 ]; then state="Branchée, charge limitée"; else state="Pleine"; fi ;;
        *) state="${ac:+Branchée, charge en pause}" ;;
    esac
    [ "$ac" = 1 ] && src="Secteur" || src="Batterie"
    card "Batterie $(r capacity) %" "clic: panneau alimentation · clic droit: menu système" \
        "État" "${state:-$st}" "${tl:-Temps}" "$hours" "Consommation" "$watts" "Alimentation" "$src" \
        "Santé" "$health" "Cycles" "$(r cycle_count)" "Modèle" "$(r manufacturer) $(r model_name)"
    ;;
display)
    rows="$(niri msg -j outputs 2>/dev/null | jq -r '.[] | (.modes[.current_mode // 0] // {}) as $m
        | .name, "\(.make // "") \(.model // "")  ·  \($m.width)×\($m.height) à \(($m.refresh_rate // 0) / 1000 | round) Hz, échelle \(.logical.scale // 1)"')"
    bl=''
    for d in /sys/class/backlight/*; do
        case "$d" in *appletb*) continue ;; esac
        [ -r "$d/brightness" ] && bl="$(awk -v c="$(cat "$d/brightness")" -v m="$(cat "$d/max_brightness")" 'BEGIN { printf "%d %%", c * 100 / m }')" && break
    done
    set --
    while IFS= read -r name && IFS= read -r desc; do set -- "$@" "$name" "$desc"; done <<EOF
$rows
EOF
    card "Écrans" "clic: wdisplays · molette: luminosité" "$@" "Luminosité" "$bl"
    ;;
monitor)
    read -r l1 l5 l15 _ < /proc/loadavg
    mem="$(awk '/^MemTotal/ { t = $2 } /^MemAvailable/ { a = $2 } /^SwapTotal/ { st = $2 } /^SwapFree/ { sf = $2 }
        END { printf "%.1f / %.1f Gio", (t - a) / 1048576, t / 1048576; if (st > 0) printf "|%.1f / %.1f Gio", (st - sf) / 1048576, st / 1048576 }' /proc/meminfo)"
    disk="$(df -h --output=used,size,pcent / | awk 'NR == 2 { printf "%s / %s (%s)", $1, $2, $3 }')"
    temp="$(for z in /sys/class/thermal/thermal_zone*/temp; do cat "$z"; done 2>/dev/null | sort -n | tail -1 | awk '{ if ($1 > 0) printf "%d °C", $1 / 1000 }')"
    up="$(awk '{ d = int($1 / 86400); h = int($1 % 86400 / 3600); m = int($1 % 3600 / 60); printf "%s%d h %02d", (d ? d " j " : ""), h, m }' /proc/uptime)"
    top="$(ps -eo comm=,pcpu= --sort=-pcpu 2>/dev/null | head -5 | awk '{ printf "%s%s %s %%", sep, $1, $2; sep = ", " }')"
    card "Système" "" "Charge" "$l1  $l5  $l15" "Mémoire" "${mem%%|*}" "Swap" "$(case "$mem" in *'|'*) echo "${mem#*|}" ;; esac)" \
        "Disque /" "$disk" "Température" "$temp" "Allumé depuis" "$up" "Processus" "$top"
    ;;
*) echo "usage: fili-info network|power|display|monitor" >&2; exit 2 ;;
esac
