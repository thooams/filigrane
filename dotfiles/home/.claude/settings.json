{
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "permissions": {
    "allow": [
      "Bash(xbps-query *)",
      "Bash(sv status *)",
      "Bash(sudo sv status *)",
      "Bash(sudo xbps-install *)",
      "Bash(sudo -n -l)",
      "Bash(lsblk *)",
      "Bash(df *)",
      "Bash(free *)",
      "Bash(ps *)",
      "Bash(ss *)",
      "Bash(ip *)",
      "Bash(uname *)",
      "Bash(dmesg *)",
      "Bash(wpctl status *)",
      "Bash(niri validate *)",
      "Bash(niri msg *)",
      "Bash(git -C ~/void-setup status *)",
      "Bash(git -C ~/void-setup diff *)",
      "Bash(git -C ~/void-setup log *)",
      "Read(~/Projects/void-setup/**)",
      "Edit(~/Projects/void-setup/**)",
      "Read(~/work/**)",
      "Edit(~/work/**)",
      "Bash(sudo xbps-remove *)",
      "Bash(rm /tmp/claude-1000/*)",
      "Bash(rm -f /tmp/claude-1000/*)",
      "Bash(rm -rf /tmp/claude-1000/*)",
      "Bash(rm /home/thomas/Projects/void-setup/*)",
      "Bash(rm -f /home/thomas/Projects/void-setup/*)",
      "Bash(rm -rf /home/thomas/Projects/void-setup/*)",
      "Bash(git push origin develop)",
      "Bash(git push origin develop *)",
      "Bash(git -C /home/thomas/Projects/void-setup push origin develop)"
    ],
    "deny": [
      "Bash(*install-void.sh*)",
      "Bash(*mkfs*)",
      "Bash(*wipefs*)",
      "Bash(*dd if=*)",
      "Bash(parted *)",
      "Bash(sudo parted *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf ~ *)",
      "Bash(*chmod -R 777 /*)",
      "Bash(sudo visudo*)",
      "Bash(sudo passwd*)",
      "Bash(passwd*)",
      "Edit(/etc/sudoers*)",
      "Edit(~/.ssh/**)",
      "Edit(~/.claude/.credentials.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.ssh/id_*)",
      "Bash(sudo xbps-remove *-R*)",
      "Bash(sudo xbps-remove *-f*)",
      "Bash(sudo xbps-remove *base-system*)"
    ],
    "ask": [
      "Bash(sudo xbps-install -u*)",
      "Bash(sudo xbps-install -*u*)",
      "Bash(sudo xbps-reconfigure *)",
      "Bash(sudo sv restart *)",
      "Bash(sudo sv start *)",
      "Bash(sudo sv stop *)",
      "Bash(sudo sv down *)",
      "Bash(sudo sv up *)",
      "Bash(sudo sv once *)",
      "Bash(sudo ln *)",
      "Bash(sudo rm *)",
      "Bash(sudo reboot*)",
      "Bash(sudo poweroff*)",
      "Bash(sudo grub-*)",
      "Edit(/etc/**)",
      "Bash(git push*main*)",
      "Bash(git push*--force*)",
      "Bash(git push* -f*)"
    ]
  },
  "model": "opus",
  "skillOverrides": {
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:docs": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/thomas/.claude/hooks/guard-destructive.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/bin/bash /home/thomas/.claude/statusline-command.sh"
  },
  "extraKnownMarketplaces": {
    "logo-design-skill": {
      "source": {
        "source": "github",
        "repo": "kaankiziltug/logo-design-skill"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "enabledPlugins": {
    "logo-design@logo-design-skill": true
  }
}
