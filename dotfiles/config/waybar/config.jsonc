// Waybar léger, interactions inspirées de la barre Omarchy Quattro (cf. skill void-linux, budget ressources)
// Clic: action principale; clic droit/milieu/molette: voir chaque module. Les TUI s'ouvrent via bar-tui.
{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 0,

    "modules-left": ["custom/menu", "niri/workspaces", "niri/window"],
    "modules-center": ["group/ind", "clock"],
    "modules-right": ["mpris", "group/res", "group/tray", "group/audio", "custom/display", "bluetooth", "network", "battery", "custom/batwatch"],

    // Modules regroupés dans une seule pastille chacun (gain de place, voir style.css)
    // Indicateurs et bascules: enregistrement, minuteur, caféine, SSH, avion, VPN, veilleuse, notifications, veille, MAJ
    "group/ind": {
        "orientation": "inherit",
        "modules": ["custom/mail", "custom/cal", "custom/rec", "custom/timer", "custom/idle", "custom/remote", "custom/air", "custom/vpn", "custom/night", "custom/dnd", "custom/news", "custom/update"]
    },
    // Ressources: CPU, température, mémoire, disque
    "group/res": {
        "orientation": "inherit",
        "modules": ["cpu", "custom/temp", "memory", "disk"]
    },
    // Audio: micro et sortie
    "group/audio": {
        "orientation": "inherit",
        "modules": ["custom/mic", "wireplumber"]
    },

    // Bouton menu: clic = menu, clic droit = terminal
    "custom/menu": {
        "format": "\uf0c9",
        "tooltip": false,
        "on-click": "$HOME/.local/bin/menu",
        "on-click-right": "foot"
    },
    // Clic = aller au workspace, molette = précédent/suivant (sans boucler)
    "niri/workspaces": {
        "format": "{index}",
        "disable-scroll-wraparound": true
    },
    // Clic milieu ou droit = fermer la fenêtre
    "niri/window": {
        "format": "{title}",
        "max-length": 60,
        "on-click-middle": "niri msg action close-window",
        "on-click-right": "niri msg action close-window"
    },
    // Clic = date complète avec semaine ISO, clic droit = calendrier mois/année, clic milieu = mois courant
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "format-alt": "{:%A %d %B %Y  ·  S%V  %H:%M:%S}",
        "interval": 1,
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": { "mode": "month", "weeks-pos": "left", "on-scroll": 1 },
        "on-click": "$HOME/.local/bin/webapp https://calendar.proton.me",
        "actions": {
            "on-click-right": "mode",
            "on-click-middle": "shift_reset",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    // Clic = lecture/pause, clic milieu = suivant, molette haut/bas = précédent/suivant
    "mpris": {
        "format": "{status_icon} {title}  ·  {artist}",
        "format-paused": "{status_icon} {title}",
        "status-icons": { "playing": "\uf04b", "paused": "\uf04c" },
        "max-length": 40,
        "on-click": "playerctl play-pause",
        "on-click-middle": "playerctl next",
        "on-scroll-up": "playerctl previous",
        "on-scroll-down": "playerctl next",
        "tooltip-format": "{player}: {title}\n{artist} · {album}"
    },
    // Nouveaux mails Proton / événement Proton Calendar imminent (masqués sinon, voir bar-alert), clic = ouvrir et effacer
    "custom/mail": {
        "exec": "$HOME/.local/bin/bar-alert mail",
        "return-type": "json",
        "interval": "once",
        "signal": 16,
        "hide-empty-text": true,
        "on-click": "$HOME/.local/bin/bar-alert open mail"
    },
    "custom/cal": {
        "exec": "$HOME/.local/bin/bar-alert cal",
        "return-type": "json",
        "interval": 60,
        "signal": 17,
        "hide-empty-text": true,
        "on-click": "$HOME/.local/bin/bar-alert open cal"
    },
    // Rapports de veille non lus (Omarchy/T2, via watch-claude; masqué s'il n'y en a pas), clic = les lire
    "custom/news": {
        "exec": "$HOME/.local/bin/bar-news",
        "return-type": "json",
        "interval": 3600,
        "signal": 15,
        "hide-empty-text": true,
        "on-click": "$HOME/.local/bin/bar-news open"
    },
    // Mises à jour xbps (masqué s'il n'y en a pas), clic = mettre à jour dans un terminal flottant
    "custom/update": {
        "exec": "$HOME/.local/bin/bar-update",
        "return-type": "json",
        "interval": 3600,
        "signal": 16,
        "hide-empty-text": true,
        "on-click": "$HOME/.local/bin/bar-update run"
    },
    // Ne pas déranger (mako), clic = bascule
    "custom/dnd": {
        "exec": "$HOME/.local/bin/bar-status dnd",
        "return-type": "json",
        "interval": "once",
        "signal": 9,
        "on-click": "makoctl mode -t do-not-disturb; pkill -RTMIN+9 waybar"
    },
    // Clic = htop
    "cpu": {
        "interval": 10,
        "format": "\uf2db {usage}%",
        "on-click": "$HOME/.local/bin/bar-tui htop"
    },
    "memory": {
        "interval": 15,
        "format": "\uf538 {used:0.1f}G",
        "on-click": "$HOME/.local/bin/bar-tui htop"
    },
    // Micro: clic = couper/activer, molette = volume, clic milieu = mixeur
    "custom/mic": {
        "exec": "$HOME/.local/bin/bar-status mic",
        "return-type": "json",
        "interval": 60,
        "signal": 8,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle; pkill -RTMIN+8 waybar",
        "on-click-middle": "$HOME/.local/bin/bar-tui wiremix",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-"
    },
    // Sortie audio: clic = muet, molette = volume, clic droit ou milieu = mixeur (wiremix)
    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "\uf6a9 muet",
        "format-icons": ["\uf026", "\uf027", "\uf028"],
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "$HOME/.local/bin/bar-tui wiremix",
        "on-click-middle": "$HOME/.local/bin/bar-tui wiremix"
    },
    // Wi-Fi: clic = impala (liste des SSID, connexion, mot de passe), clic droit = menu réseau (IP, ping, débit)
    "network": {
        "interval": 30,
        "format-ethernet": "\uf796 {ifname}",
        "format-wifi": "\uf1eb {essid}",
        "format-disconnected": "\uf071 hors ligne",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)  {frequency} GHz\n{ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
        "tooltip-format-disconnected": "Aucune connexion (clic: Wi-Fi)",
        "on-click": "$HOME/.local/bin/bar-tui impala",
        "on-click-right": "$HOME/.local/bin/menu network"
    },
    // Bluetooth (masqué sans adaptateur): clic = bluetui (appairage, connexion, oubli)
    "bluetooth": {
        "format": "\uf293 {status}",
        "format-connected": "\uf293 {device_alias}",
        "format-connected-battery": "\uf293 {device_alias} {device_battery_percentage}%",
        "format-off": "\uf293 off",
        "format-disabled": "",
        "format-no-controller": "",
        "tooltip-format": "{controller_alias}\t{controller_address}\n{num_connections} connecté(s)",
        "tooltip-format-connected": "{controller_alias}\n{num_connections} connecté(s)\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "$HOME/.local/bin/bar-tui bluetui"
    },
    // Veilleuse (wlsunset, 3500 K), clic = bascule
    "custom/night": {
        "exec": "$HOME/.local/bin/bar-status night",
        "return-type": "json",
        "interval": "once",
        "signal": 10,
        "on-click": "$HOME/.local/bin/bar-toggle night"
    },
    // Enregistrement d'écran: visible seulement en cours, clic = arrêter (démarrage: menu › Capture)
    "custom/rec": {
        "exec": "$HOME/.local/bin/bar-status rec",
        "return-type": "json",
        "interval": "once",
        "signal": 11,
        "hide-empty-text": true,
        "on-click": "$HOME/.local/bin/bar-toggle rec"
    },
    // Minuteur / chronomètre: clic = choisir (ou arrêter), clic droit = +5 min au minuteur; notification à la fin
    "custom/timer": {
        "exec": "$HOME/.local/bin/bar-timer",
        "return-type": "json",
        "interval": "once",
        "signal": 12,
        "on-click": "$HOME/.local/bin/bar-timer click",
        "on-click-right": "$HOME/.local/bin/bar-timer add"
    },
    // Caféine: tasse jaune = verrouillage auto coupé (écran toujours allumé), grise = actif; clic = bascule
    "custom/idle": {
        "exec": "$HOME/.local/bin/bar-status idle",
        "return-type": "json",
        "interval": "once",
        "signal": 13,
        "on-click": "$HOME/.local/bin/bar-toggle idle"
    },
    // Session SSH entrante (visible seulement alors)
    "custom/remote": {
        "exec": "$HOME/.local/bin/bar-status remote",
        "return-type": "json",
        "interval": 30,
        "hide-empty-text": true
    },
    // Mode avion (visible seulement actif), clic = désactiver
    "custom/air": {
        "exec": "$HOME/.local/bin/bar-status air",
        "return-type": "json",
        "interval": 60,
        "signal": 14,
        "hide-empty-text": true,
        "on-click": "$HOME/.local/bin/bar-toggle air"
    },
    // VPN actif (tun/wg/tailscale; masqué sinon)
    "custom/vpn": {
        "exec": "$HOME/.local/bin/bar-status vpn",
        "return-type": "json",
        "interval": 60,
        "hide-empty-text": true
    },
    // Température CPU (masquée sans sonde), clic = htop
    "custom/temp": {
        "exec": "$HOME/.local/bin/bar-status temp",
        "return-type": "json",
        "interval": 15,
        "hide-empty-text": true,
        "on-click": "$HOME/.local/bin/bar-tui htop"
    },
    // Espace libre sur /, clic = du interactif
    "disk": {
        "interval": 300,
        "path": "/",
        "format": "\uf0a0 {percentage_used}%",
        "tooltip-format": "{used} / {total} ({free} libres)",
        "on-click": "$HOME/.local/bin/bar-tui sh -c 'df -h; echo; du -xh --max-depth=1 ~ 2>/dev/null | sort -h | tail -15; read _'"
    },
    // Alerte batterie faible (<= 10 %), invisible
    "custom/batwatch": {
        "exec": "$HOME/.local/bin/bar-status batwatch",
        "return-type": "json",
        "interval": 60,
        "hide-empty-text": true
    },
    // Écrans: clic = wdisplays
    "custom/display": {
        "format": "\uf108",
        "tooltip-format": "Écrans (clic: wdisplays)",
        "on-click": "wdisplays"
    },
    // Clic = menu système (verrouiller, veille, quitter...)
    "battery": {
        "interval": 60,
        "states": { "warning": 25, "critical": 10 },
        "format": "{icon} {capacity}%",
        "format-charging": "\uf0e7 {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "on-click": "$HOME/.local/bin/menu system"
    },
    // Tray repliable: s'ouvre au survol
    "group/tray": {
        "orientation": "inherit",
        "drawer": { "transition-duration": 300, "transition-left-to-right": false },
        "modules": ["custom/tray-handle", "tray"]
    },
    "custom/tray-handle": { "format": "\uf053", "tooltip": false },
    "tray": { "icon-size": 16, "spacing": 8 }
}
