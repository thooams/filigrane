# kanshi: profils d'écrans (le premier profil qui correspond aux écrans branchés gagne).
# Les profils enregistrés par `display-save` vivent dans ~/.config/kanshi/profiles.d/
# (hors dépôt: ils contiennent les numéros de série des écrans).
include ~/.config/kanshi/profiles.d/*.conf

# Repli: n'importe quel écran inconnu est activé à sa résolution préférée,
# niri le place à droite des autres. Réglage visuel: Mod+P (wdisplays), puis Mod+Ctrl+P (display-save).
profile fallback {
    output * enable
}
