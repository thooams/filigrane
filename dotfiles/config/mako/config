# Catppuccin Mocha
font=DejaVu Sans 11
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#b4befe
progress-color=over #45475a

width=360
height=140
margin=12
padding=14
border-size=2
border-radius=12
default-timeout=5000
max-visible=4
ignore-timeout=1
layer=overlay
anchor=top-right
# Clic gauche: action par défaut puis focus sur la fenêtre de l'appli (notif-focus)
on-button-left=exec /home/thomas/.local/bin/notif-focus "$id"
on-button-right=dismiss

[urgency=low]
border-color=#6c7086
default-timeout=3000

[urgency=critical]
border-color=#fab387
text-color=#fab387
default-timeout=10000

[mode=do-not-disturb]
invisible=1
