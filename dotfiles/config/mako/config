# Catppuccin Mocha
font=DejaVu Sans 11
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#b4befe
progress-color=over #45475a

width=360
height=140
margin=12
padding=14
border-size=2
border-radius=12
default-timeout=6000
max-visible=4
layer=overlay
anchor=top-right

[urgency=low]
border-color=#6c7086
default-timeout=3000

[urgency=high]
border-color=#fab387
text-color=#fab387
default-timeout=0

[mode=do-not-disturb]
invisible=1
