# Filigrane (brand.md): nuit, brume, liseré discret
font=Jost 11
background-color=#1c222b
text-color=#dbe7f4
border-color=#3c4858
progress-color=over #2d3744

width=360
height=140
margin=12
padding=14
border-size=1
# Pas de gras (brand.md): titre en Jost 500
format=<span weight="500">%s</span>\n%b
border-radius=12
default-timeout=5000
max-history=30
max-visible=4
ignore-timeout=1
layer=overlay
anchor=top-right
# Clic gauche: action par défaut puis focus sur la fenêtre de l'appli (notif-focus)
on-button-left=exec /home/thomas/.local/bin/notif-focus "$id"
on-button-right=dismiss

# Captures niri: l'icône est l'image plein écran (~16 Mo décodée), gardée tant que la notification est dans l'historique.
# Hors historique, elle est libérée à la fermeture (5 s).
[app-name=niri]
history=0

[urgency=low]
border-color=#2d3744
text-color=#a9b8c8
default-timeout=3000

[urgency=critical]
border-color=#c98f93
text-color=#dbe7f4
default-timeout=10000

[mode=do-not-disturb]
invisible=1
