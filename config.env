# Réglages système rejoués par bootstrap.sh (surchargeables par variables d'environnement)
KEYMAP="${KEYMAP:-fr-bepo}"
TIMEZONE="${TIMEZONE:-Europe/Paris}"
LOCALE="${LOCALE:-C.UTF-8}"
# Groupes ajoutés à l'utilisateur cible (ceux qui n'existent pas sont ignorés)
USER_GROUPS="${USER_GROUPS:-wheel audio video input bluetooth socklog}"
# Connexion automatique sur tty1 (puis niri via ~/.zprofile): 1 = oui, 0 = non, auto = oui en VM, non sur machine physique
# Ici activée aussi en physique: le disque est chiffré (LUKS), la phrase de passe est demandée au démarrage
AUTOLOGIN="${AUTOLOGIN:-1}"
