# Réglages système génériques rejoués par bootstrap.sh. Priorité: variables d'environnement, puis
# users/<utilisateur>/config.env (couche personnelle), puis ce fichier.
KEYMAP="${KEYMAP:-us}"
TIMEZONE="${TIMEZONE:-UTC}"
LOCALE="${LOCALE:-C.UTF-8}"
# Disposition clavier de la session niri (xkb), écrite dans ~/.config/niri/keyboard.kdl
XKB_LAYOUT="${XKB_LAYOUT:-us}"
XKB_VARIANT="${XKB_VARIANT:-}"
XKB_OPTIONS="${XKB_OPTIONS:-compose:caps}"
# Groupes ajoutés à l'utilisateur cible (ceux qui n'existent pas sont ignorés)
USER_GROUPS="${USER_GROUPS:-wheel audio video input bluetooth socklog lpadmin}"
# Connexion automatique sur tty1 (puis niri via ~/.zprofile): 1 = oui, 0 = non, auto = oui en VM, non sur machine physique
AUTOLOGIN="${AUTOLOGIN:-auto}"
# Agent IA qui aide à utiliser, régler et mettre à jour la machine (fili-ai, Mod+Y, skill filigrane):
# claude (Anthropic), codex (OpenAI), ollama (modèles locaux, lourd), opencode (Mistral, Gemini, OpenRouter...),
# none. Changer ensuite: fili-ai use <agent>, choix gardé dans ~/.config/filigrane/ai.env (l'environnement et la
# couche personnelle passent avant). Ancien réglage CLAUDE_CODE=0 = none.
[ "${CLAUDE_CODE:-1}" = 0 ] && FILI_AI="${FILI_AI:-none}"
FILI_AI="${FILI_AI:-claude}"
# Modèle (vide = celui de l'agent; ollama: gpt-oss:20b, ~16 Go de RAM)
FILI_AI_MODEL="${FILI_AI_MODEL:-}"
# Dossier de travail de l'agent, relatif au dossier personnel
FILI_AI_WORKDIR="${FILI_AI_WORKDIR:-work}"
# Options de l'agent à la place de celles par défaut (permissions, bac à sable), ex. "--permission-mode auto"
FILI_AI_ARGS="${FILI_AI_ARGS:-}"
