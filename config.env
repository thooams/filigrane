# Réglages système génériques rejoués par bootstrap.sh. Priorité: variables d'environnement, puis
# users/<utilisateur>/config.env (couche personnelle), puis ce fichier.
KEYMAP="${KEYMAP:-us}"
TIMEZONE="${TIMEZONE:-UTC}"
LOCALE="${LOCALE:-C.UTF-8}"
# Disposition clavier de la session niri (xkb), écrite dans ~/.config/niri/keyboard.kdl
XKB_LAYOUT="${XKB_LAYOUT:-us}"
XKB_VARIANT="${XKB_VARIANT:-}"
XKB_OPTIONS="${XKB_OPTIONS:-compose:caps}"
# Groupes ajoutés à l'utilisateur cible (ceux qui n'existent pas sont ignorés)
USER_GROUPS="${USER_GROUPS:-wheel audio video input bluetooth socklog lpadmin}"
# Connexion automatique sur tty1 (puis niri via ~/.zprofile): 1 = oui, 0 = non, auto = oui en VM, non sur machine physique
AUTOLOGIN="${AUTOLOGIN:-auto}"
# Claude Code (agent qui administre la machine, Mod+Y): 1 = installé, 0 = non
CLAUDE_CODE="${CLAUDE_CODE:-1}"
