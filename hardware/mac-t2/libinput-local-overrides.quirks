# Trackpad interne T2 (MacBookPro16,2, 05ac:027e): paume prise pour un doigt avec le tap activé.
# Mesuré avec `libinput record`: doigt touch major 240-340, paume posée 770-6400,
# effleurement de paume 50-170 (au défaut 150:130 il devient un tap).
# Contact compté au-delà de 190 (fin sous 150), paume au-delà de 700.
[MacBook Pro T2 Touchpad, paume]
MatchUdevType=touchpad
MatchBus=usb
MatchVendor=0x05AC
MatchProduct=0x027E
AttrTouchSizeRange=190:150
AttrPalmSizeThreshold=700
