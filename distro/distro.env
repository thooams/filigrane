# Identité de la distribution: Filigrane, l'OS en filigrane qui laisse la place aux applications.
# DISTRO est le nom court (commandes, paquets fili-*, ISO, installateur fili-install, nom de machine par défaut).
DISTRO="${DISTRO:-fili}"
DISTRO_TITLE="${DISTRO_TITLE:-Filigrane (Void Linux + niri)}"
DISTRO_HOMEPAGE="${DISTRO_HOMEPAGE:-https://github.com/thooams/void-setup}"
# Dépôt git cloné par l'installateur (mises à jour: git pull puis ./bootstrap.sh)
DISTRO_GIT="${DISTRO_GIT:-https://github.com/thooams/void-setup}"
# Dépôts Void en amont (le dépôt de la distribution ne contient que ses propres paquets)
VOID_REPO="${VOID_REPO:-https://repo-default.voidlinux.org/current}"
# void-mklive épinglé (outil officiel de construction des ISO Void)
MKLIVE_GIT="${MKLIVE_GIT:-https://github.com/void-linux/void-mklive}"
MKLIVE_REF="${MKLIVE_REF:-master}"
